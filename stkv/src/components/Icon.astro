---
/** Inline stroke icon. Decorative by default; pass `label` for meaning. */
import { icons, type IconName } from './icons';
interface Props { name: IconName; size?: number; class?: string; label?: string; stroke?: number }
const { name, size = 24, class: cls, label, stroke = 1.6 } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : 'true'} aria-label={label} role={label ? 'img' : undefined} set:html={icons[name]} />
