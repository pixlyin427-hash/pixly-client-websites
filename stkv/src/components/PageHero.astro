---
import Art from './Art.astro';
import Kadamba from './Kadamba.astro';
import type { ArtName } from '../data/campus';
interface Props { kicker: string; title: string; lead: string; art: ArtName; tone?: 'navy' | 'marigold' | 'ivory' | 'sky' | 'clay'; crumb: string; dark?: boolean }
const { kicker, title, lead, art, tone = 'marigold', crumb, dark = false } = Astro.props;
---
<section class:list={['ph', { 'on-dark': dark }]} data-tilt-scope>
  <div class="container ph__grid">
    <div class="ph__copy">
      <nav aria-label="Breadcrumb" class="ph__crumb small" data-reveal="fade"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">{crumb}</span></nav>
      <p class="label ph__kicker" data-reveal="fade" style="--delay:100ms">{kicker}</p>
      <h1 class="h1 ph__title" data-reveal="words" style="--delay:160ms" set:html={title} />
      <p class="lead ph__lead" data-reveal="up" style="--delay:600ms">{lead}</p>
      <slot />
    </div>
    <div class="ph__visual" aria-hidden="true">
      <div class="ph__motif" data-depth="-8"><Kadamba size={460} delay={500} /></div>
      <div class="ph__arch" data-depth="10"><div data-parallax="0.06"><div class="arch" data-reveal="mask" style="--delay:250ms"><Art name={art} tone={tone} /></div></div></div>
    </div>
  </div>
</section>
<style>
  .ph { position: relative; overflow: clip; padding: calc(var(--header-h) + 38px + clamp(32px, 6vw, 96px)) 0 clamp(48px, 6vw, 96px); }
  .ph.on-dark { background: var(--navy-900); }
  .ph__grid { display: grid; gap: 40px; align-items: end; }
  @media (min-width: 960px) { .ph__grid { grid-template-columns: 1.4fr 0.6fr; gap: 64px; } }
  .ph__crumb { display: flex; gap: 10px; color: var(--text-muted); margin-bottom: 36px; }
  .ph__crumb a { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-strong); }
  .ph__crumb a:hover { color: var(--text); }
  .ph__kicker { color: var(--marigold-600); }
  .on-dark .ph__kicker { color: var(--marigold-300); }
  .ph__title { margin-top: 18px; max-width: 14ch; }
  .ph__title :global(em) { color: var(--navy-700); }
  .on-dark .ph__title :global(em) { color: var(--marigold-300); }
  .ph__lead { margin-top: 24px; max-width: 52ch; }
  .ph__visual { position: relative; display: none; }
  @media (min-width: 960px) { .ph__visual { display: block; } }
  .ph__arch { position: relative; width: 78%; margin-left: auto; }
  .ph__arch .arch { box-shadow: var(--shadow-3); }
  .ph__motif { position: absolute; left: -30%; top: -20%; width: 120%; color: var(--marigold-600); opacity: 0.45; }
  .ph__motif :global(svg) { width: 100%; height: auto; }
</style>
