---
/** Minimal shell for homepage design concepts (review only). */
interface Props { title: string; theme: string }
const { title, theme } = Astro.props;
const concepts = [
  { href: '/concepts/pulse/', label: 'A · Pulse' },
  { href: '/concepts/heritage/', label: 'B · Heritage Editorial' },
  { href: '/concepts/daylight/', label: 'C · A Day at STKV' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en" class={theme}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{title} · STKV homepage concept</title>
  <link rel="icon" href="/favicon.svg" />
  <slot name="head" />
</head>
<body>
  <slot />
  <nav class="cswitch" aria-label="Design concepts">
    <span>Concept</span>
    {concepts.map((c) => <a href={c.href} aria-current={path.startsWith(c.href) ? 'page' : undefined}>{c.label}</a>)}
  </nav>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    * { margin: 0; }
    html { -webkit-text-size-adjust: 100%; }
    body { overflow-x: clip; -webkit-font-smoothing: antialiased; }
    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
    ul[role='list'], ol[role='list'] { list-style: none; padding: 0; }
    :focus-visible { outline: 3px solid #ffc23c; outline-offset: 3px; }
    .ph { position: relative; overflow: hidden; }
    .ph__img { width: 100%; height: 100%; object-fit: cover; }
    .ph__tag { position: absolute; right: 10px; bottom: 10px; z-index: 2; padding: 4px 9px; border-radius: 99px; font: 700 10px/1.2 system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; color: #fff; background: rgb(10 15 44 / .55); backdrop-filter: blur(6px); pointer-events: none; }
    .ph__tag--real { background: rgb(163 25 31 / .8); }
    .cswitch { position: fixed; left: 50%; bottom: 14px; translate: -50% 0; z-index: 999; display: flex; gap: 4px; align-items: center; padding: 6px; border-radius: 99px; background: rgb(10 12 30 / .88); backdrop-filter: blur(10px); font: 600 12px/1 system-ui, sans-serif; color: #fff; box-shadow: 0 10px 30px rgb(0 0 0 / .3); }
    .cswitch span { padding: 0 8px 0 10px; opacity: .6; text-transform: uppercase; letter-spacing: .1em; font-size: 10px; }
    .cswitch a { padding: 8px 12px; border-radius: 99px; white-space: nowrap; }
    .cswitch a[aria-current='page'] { background: #fff; color: #0a0c1e; }
    @media (max-width: 640px) { .cswitch span { display: none; } .cswitch a { padding: 8px 9px; font-size: 11px; } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
  </style>
</body>
</html>
