---
/**
 * Website brand lock-up.
 * IMPORTANT: the arch badge is a TEMPORARY website mark — it is not, and must not be presented as,
 * the official STKV crest. Set `CREST_SRC` to the official crest file (e.g. '/brand/stkv-crest.svg')
 * once the school supplies it, and the badge is replaced automatically.
 */
const CREST_SRC: string | null = null;
interface Props { inverse?: boolean; compact?: boolean }
const { inverse = false, compact = false } = Astro.props;
---
<span class:list={['logo', { 'logo--inverse': inverse, 'logo--compact': compact }]}>
  {CREST_SRC ? (
    <img class="logo__crest" src={CREST_SRC} alt="" width="44" height="52" />
  ) : (
    <svg class="logo__badge" viewBox="0 0 44 52" aria-hidden="true">
      <path d="M0 52V22C0 9.85 9.85 0 22 0s22 9.85 22 22v30H0Z" fill="currentColor" />
      <g stroke="#e2a32b" stroke-width="1.3" stroke-linecap="round">
        {Array.from({ length: 16 }, (_, i) => {
          const a = (i / 16) * Math.PI * 2; const r1 = 5.5, r2 = i % 2 ? 9.5 : 12;
          return <line x1={22 + Math.cos(a) * r1} y1={24 + Math.sin(a) * r1} x2={22 + Math.cos(a) * r2} y2={24 + Math.sin(a) * r2} />;
        })}
      </g>
      <circle cx="22" cy="24" r="3" fill="#e2a32b" />
      <path d="M8 44h28" stroke="#e2a32b" stroke-width="1.3" />
    </svg>
  )}
  <span class="logo__text">
    <span class="logo__name">Shri S. T. Kadam <span class="logo__v">Vidyalaya</span></span>
    {!compact && <span class="logo__meta">CBSE · Palghar</span>}
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; color: var(--navy-900); }
  .logo--inverse { color: var(--paper); }
  .logo--inverse .logo__badge { color: var(--navy-800); }
  .logo__badge, .logo__crest { width: 36px; height: auto; flex: none; transition: transform var(--d-panel) var(--ease-out); }
  :global(a:hover) > .logo .logo__badge { transform: translateY(-2px); }
  .logo__text { display: grid; line-height: 1.05; }
  .logo__name { font-family: var(--font-display); font-size: 1.12rem; font-weight: 480; letter-spacing: -0.015em; white-space: nowrap; }
  .logo__v { font-style: italic; font-weight: 360; }
  .logo__meta { margin-top: 5px; font-size: 0.625rem; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.62; }
  @media (max-width: 480px) { .logo { gap: 10px; } .logo__name { font-size: 0.98rem; } .logo__badge { width: 30px; } .logo__meta { font-size: 0.5625rem; } }
  @media (max-width: 360px) { .logo__name { font-size: 0.9rem; } }
</style>
