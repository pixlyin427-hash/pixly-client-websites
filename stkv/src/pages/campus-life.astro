---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SubNav from '../components/SubNav.astro';
import SectionHead from '../components/SectionHead.astro';
import Art from '../components/Art.astro';
import Icon from '../components/Icon.astro';
import Pending from '../components/Pending.astro';
import Button from '../components/Button.astro';
import { activities, facilities, gallery, achievementCategories } from '../data/campus';
import { calendarEvents } from '../data/calendar';

const tags = ['All', 'Sports', 'Culture', 'Academics', 'Celebrations'];
const todayIso = new Date().toISOString().slice(0, 10);
const events = calendarEvents.filter((e) => e.kind === 'Event' && e.date >= todayIso).sort((a, b) => a.date.localeCompare(b.date)).slice(0, 5);
const dt = (iso: string) => { const [y, m, d] = iso.split('-').map(Number); return new Date(y, m - 1, d); };
const mosaicTone = ['marigold', 'navy', 'clay', 'sky', 'ivory', 'navy'] as const;
---
<Base title="Campus Life" darkHero description="Sports, activities, culture, achievements, events, gallery and facilities at Shri S. T. Kadam Vidyalaya.">
  <PageHero crumb="Campus Life" kicker="Campus Life" title="Every day, <em>a little more alive.</em>" lead="Sport, the arts, celebrations and the everyday moments that make school a community." art="celebration" tone="marigold" dark />
  <SubNav items={[{ id: 'sports', label: 'Sports & Activities' }, { id: 'achievements', label: 'Achievements' }, { id: 'events', label: 'Events' }, { id: 'gallery', label: 'Photo Gallery' }, { id: 'videos', label: 'Videos' }, { id: 'facilities', label: 'Facilities' }]} />

  <section class="section" id="sports" aria-labelledby="sp-t">
    <div class="container">
      <SectionHead kicker="Sports & Activities" title="Learning that happens <em>everywhere</em>" lead="Activity areas are shown for the design. The school will confirm its programmes, clubs and sports, and supply photographs." split id="sp-t" />
      <span id="activities" class="anchor"></span>
      <ul class="mosaic" role="list">
        {activities.map((a, i) => (
          <li class={`mo mo--${i}`} data-reveal="mask" style={`--delay:${(i % 3) * 120}ms`}>
            <Art name={a.art} tone={mosaicTone[i]} />
            <div class="mo__cap">
              <h3 class="h3">{a.name}</h3>
              <p>{a.line}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="small muted" style="margin-top:20px"><Pending label="Programme details awaiting confirmation" /></p>
    </div>
  </section>

  <section class="section bg-paper2" id="achievements" aria-labelledby="ach-t" data-achievements>
    <div class="container">
      <SectionHead kicker="Student Achievements" title="Achievement <em>showcase</em>" lead="A ready-made showcase for verified achievements. Entries below show the format only — no achievements have been published yet." split id="ach-t" />
      <div class="chips" role="group" aria-label="Filter achievements" data-reveal="fade">
        {['All', ...achievementCategories].map((c, i) => <button class="chip" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-a-filter={c}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>{c}</button>)}
      </div>
      <div class="showcase" data-a-out aria-live="polite">
        {[0, 1, 2].map((i) => (
          <article class="trophy" style={`--i:${i}`}>
            <span class="trophy__medal" aria-hidden="true"><Icon name="sparkle" size={22} /></span>
            <p class="label trophy__cat" data-a-cat>Any category</p>
            <p class="trophy__ph trophy__ph--l">[Student name, Class]</p>
            <p class="trophy__ph">[Achievement or position]</p>
            <p class="trophy__ph trophy__ph--s">[Event · Level · Year]</p>
            <span class="sample-tag">Format only</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="events" aria-labelledby="ev-t">
    <div class="container ev">
      <div>
        <SectionHead kicker="Events" title="What’s <em>coming up</em>" id="ev-t" />
        <a class="link link--under" href="/resources/#calendar" data-reveal="up">Full academic calendar <Icon name="arrow" /></a>
      </div>
      <ol class="ev__list" role="list" data-reveal="stagger">
        {events.map((e) => (
          <li class="ev__row">
            <time datetime={e.date}><b>{dt(e.date).getDate()}</b>{dt(e.date).toLocaleDateString('en-IN', { month: 'short', weekday: 'short' })}</time>
            <span class="ev__t">{e.title.replace('Sample: ', '')}</span>
            {e.sample ? <span class="sample-tag">Sample</span> : <span class="ev__obs">Observance</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section bg-navy on-dark" id="gallery" aria-labelledby="g-t" data-gallery>
    <div class="container">
      <SectionHead kicker="Photo Gallery" title="Moments from <em>school life</em>" lead="Illustrations hold each place until the school supplies photographs. Open any frame to view it larger." split id="g-t" />
      <div class="chips gal__chips" role="group" aria-label="Filter gallery">
        {tags.map((t, i) => <button class="chip" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-g-filter={t}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>{t}</button>)}
      </div>
      <ul class="gal" role="list">
        {gallery.map((g, i) => (
          <li class={`gal__item ${i % 5 === 0 ? 'gal__item--tall' : ''}`} data-g-item data-tag={g.tag} data-title={g.title}>
            <button type="button" class="gal__btn" aria-label={`Open “${g.title}” (${g.tag}) in viewer`}>
              <div class="frame gal__frame"><Art name={g.art} tone={g.tone} /></div>
              <span class="gal__cap"><span>{g.title}</span><span class="gal__tag">{g.tag}</span></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="modal lightbox" id="lightbox" aria-label="Gallery viewer">
    <div class="modal__head"><span class="small" data-lb-count>1 / 10</span><button class="icon-btn" type="button" data-close-modal aria-label="Close viewer"><Icon name="close" /></button></div>
    <div class="modal__body"><div class="lb-stage" data-lb-stage></div></div>
    <div class="lb-foot"><p data-lb-cap></p><div class="lb-ctrl"><button class="icon-btn" type="button" data-lb-prev aria-label="Previous"><Icon name="chevron-left" /></button><button class="icon-btn" type="button" data-lb-next aria-label="Next"><Icon name="chevron-right" /></button></div></div>
  </dialog>

  <section class="section" id="videos" aria-labelledby="v-t">
    <div class="container">
      <SectionHead kicker="Videos" title="School life <em>on film</em>" lead="Video links (for example the school’s YouTube channel) will be embedded here. Videos load only when played, to keep the site fast." split id="v-t" />
      <ul class="vids" role="list">
        {[{ t: 'Campus tour', a: 'campus', tone: 'navy' }, { t: 'Annual day highlights', a: 'music', tone: 'clay' }, { t: 'Sports meet', a: 'sports', tone: 'marigold' }].map((v, i) => (
          <li data-reveal="up" style={`--delay:${i * 120}ms`}>
            <button class="vid" type="button" data-open-modal="video-modal">
              <div class="frame vid__frame"><Art name={v.a as any} tone={v.tone as any} /><span class="vid__play" aria-hidden="true"><Icon name="play" size={26} /></span></div>
              <span class="vid__t">{v.t}</span><span class="small muted">Video to be added</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog class="modal" id="video-modal" aria-labelledby="vm-t">
    <div class="modal__head"><p class="h4" id="vm-t">Video not yet available</p><button class="icon-btn" type="button" data-close-modal aria-label="Close"><Icon name="close" /></button></div>
    <div class="modal__body stack"><p>This space is ready for the school’s videos. Once links are provided, the video will play here using a privacy-friendly, load-on-click embed.</p><p class="small muted">Demonstration only — no video is loaded.</p></div>
  </dialog>

  <section class="section bg-paper2" id="facilities" aria-labelledby="f-t">
    <div class="container">
      <SectionHead kicker="Facilities" title="Spaces that <em>support learning</em>" id="f-t" />
      <ul class="fgrid" role="list" data-reveal="stagger">
        {facilities.map((f) => (
          <li class="fcard"><div class="arch fcard__art"><Art name={f.art} tone="ivory" /></div><div><h3 class="h4">{f.name}</h3><p class="small muted">{f.line}</p></div></li>
        ))}
      </ul>
      <div style="margin-top:40px; display:flex; gap:24px; flex-wrap:wrap; align-items:center" data-reveal="up"><Button href="/admissions/#visit">Request a campus visit</Button><Pending label="Facilities awaiting confirmation" /></div>
    </div>
  </section>
</Base>

<style>
  .anchor { display: block; position: relative; top: -120px; }
  .mosaic { display: grid; gap: 12px; grid-template-columns: 1fr; }
  @media (min-width: 700px) { .mosaic { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .mosaic { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 260px; grid-auto-flow: dense; } .mo--0 { grid-column: span 2; grid-row: span 2; } .mo--3, .mo--5 { grid-row: span 2; } .mo--4 { grid-column: span 2; } }
  .mo { position: relative; overflow: hidden; border-radius: var(--r-2); min-height: 300px; isolation: isolate; }
  .mo :global(.art) { position: absolute; inset: 0; transition: transform 1200ms var(--ease-out), filter 600ms; }
  .mo__cap { position: absolute; inset: auto 0 0; padding: 24px; color: var(--paper); background: linear-gradient(to top, rgb(8 19 48 / 0.92), rgb(8 19 48 / 0.6) 60%, transparent); display: grid; gap: 6px; }
  .mo__cap p { font-size: 0.9375rem; color: rgb(246 241 231 / 0.85); max-width: 40ch; clip-path: inset(0 0 100% 0); opacity: 0; transform: translateY(8px); transition: clip-path 600ms var(--ease-out), opacity 400ms, transform 600ms var(--ease-out); }
  .mo:hover :global(.art) { transform: scale(1.06); }
  .mo:hover .mo__cap p, .mo:focus-within .mo__cap p { clip-path: inset(0 0 0 0); opacity: 1; transform: none; }
  @media (hover: none) { .mo__cap p { clip-path: none; opacity: 1; transform: none; } }

  .showcase { margin-top: 32px; display: grid; gap: 16px; }
  @media (min-width: 800px) { .showcase { grid-template-columns: repeat(3, 1fr); } }
  .showcase:global(.is-entering) .trophy { animation: row-in 520ms var(--ease-out) both; animation-delay: calc(var(--i) * 80ms); }
  .trophy { position: relative; display: grid; gap: 12px; justify-items: start; padding: 32px 28px; border-radius: var(--r-2); background: var(--white); border: 1px dashed var(--line-strong); transition: transform var(--d-ui) var(--ease-out), box-shadow var(--d-ui); }
  .trophy:hover { transform: translateY(-4px) rotate(-0.4deg); box-shadow: var(--shadow-2); }
  .trophy__medal { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; background: var(--marigold-100); color: var(--marigold-600); transition: transform 600ms var(--ease-back); }
  .trophy:hover .trophy__medal { transform: rotate(72deg) scale(1.08); }
  .trophy__cat { color: var(--marigold-600); }
  .trophy__ph { color: var(--ink-3); font-weight: 600; }
  .trophy__ph--l { font-family: var(--font-display); font-size: 1.5rem; color: var(--ink-2); font-weight: 400; }

  .ev { display: grid; gap: 40px; }
  @media (min-width: 1000px) { .ev { grid-template-columns: 0.8fr 1.2fr; gap: 80px; } }
  .ev__list { border-top: 1px solid var(--line); }
  .ev__row { display: grid; grid-template-columns: 80px 1fr auto; gap: 20px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); transition: padding var(--d-ui) var(--ease-out); }
  .ev__row:hover { padding-left: 10px; }
  .ev__row time { display: grid; font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-3); }
  .ev__row time b { font-family: var(--font-display); font-size: 2.4rem; line-height: 1; color: var(--ink); font-weight: 320; letter-spacing: -0.03em; }
  .ev__t { font-family: var(--font-display); font-size: 1.35rem; letter-spacing: -0.01em; }
  .ev__obs { font-size: 0.625rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sage-600); }

  .gal__chips { margin-bottom: 32px; }
  .gal__chips .chip { color: var(--paper); box-shadow: inset 0 0 0 1px var(--line-inverse); }
  .gal__chips .chip[aria-pressed='true'] { background: var(--marigold-500); color: var(--navy-950); }
  .gal { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); grid-auto-flow: dense; }
  @media (min-width: 900px) { .gal { grid-template-columns: repeat(4, 1fr); } }
  .gal__item--tall { grid-row: span 2; }
  .gal__btn { position: relative; display: block; width: 100%; height: 100%; text-align: left; border-radius: var(--r-2); overflow: hidden; }
  .gal__frame { aspect-ratio: 1; height: 100%; }
  .gal__item--tall .gal__frame { aspect-ratio: auto; min-height: 100%; }
  .gal__frame :global(.art) { transition: transform 900ms var(--ease-out); }
  .gal__btn:hover .gal__frame :global(.art) { transform: scale(1.08); }
  .gal__cap { position: absolute; inset: auto 0 0; display: flex; justify-content: space-between; gap: 8px; padding: 14px 16px; font-weight: 700; font-size: 0.875rem; color: var(--paper); background: linear-gradient(to top, rgb(8 19 48 / 0.85), transparent); transform: translateY(100%); transition: transform 500ms var(--ease-out); }
  .gal__btn:hover .gal__cap, .gal__btn:focus-visible .gal__cap { transform: none; }
  @media (hover: none) { .gal__cap { transform: none; } }
  .gal__tag { font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--marigold-300); }

  .vids { display: grid; gap: 24px; }
  @media (min-width: 800px) { .vids { grid-template-columns: repeat(3, 1fr); } }
  .vid { display: grid; gap: 8px; text-align: left; width: 100%; }
  .vid__frame { aspect-ratio: 16 / 10; }
  .vid__play { position: absolute; left: 50%; top: 50%; width: 72px; height: 72px; margin: -36px; border-radius: 50%; display: grid; place-items: center; background: var(--white); color: var(--navy-900); box-shadow: var(--shadow-3); transition: transform 500ms var(--ease-back); }
  .vid__play::before { content: ''; position: absolute; inset: -8px; border-radius: 50%; border: 1.5px solid rgb(255 255 255 / 0.7); transform: scale(0.85); opacity: 0; transition: transform 600ms var(--ease-out), opacity 400ms; }
  .vid:hover .vid__play { transform: scale(1.1); }
  .vid:hover .vid__play::before { transform: scale(1); opacity: 1; }
  .vid__t { font-weight: 750; font-size: 1.0625rem; margin-top: 8px; }

  .fgrid { display: grid; gap: 16px; }
  @media (min-width: 700px) { .fgrid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .fgrid { grid-template-columns: repeat(3, 1fr); } }
  .fcard { display: grid; grid-template-columns: 88px 1fr; gap: 20px; align-items: center; padding: 18px; border-radius: var(--r-2); background: var(--white); box-shadow: var(--shadow-1); transition: transform var(--d-ui) var(--ease-out), box-shadow var(--d-ui); }
  .fcard:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); }
  .fcard__art :global(.art) { transition: transform 700ms var(--ease-out); }
  .fcard:hover .fcard__art :global(.art) { transform: translateY(-6px) scale(1.04); }
</style>
