</style>

<script>
  // Spotlight that follows the pointer on quick-access tiles (cheap: CSS variables only)
  document.querySelectorAll<HTMLElement>('.qa__tile').forEach((t) => t.addEventListener('pointermove', (e) => {
    const r = t.getBoundingClientRect(); t.style.setProperty('--mx', `${e.clientX - r.left}px`); t.style.setProperty('--my', `${e.clientY - r.top}px`);
  }));
</script>
