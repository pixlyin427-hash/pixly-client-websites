  /* Each icon has its own micro-animation */
  .qa__ico :global(svg) { transition: transform 500ms var(--ease-out); }
  :is(.qa__tile, .qa__feature):hover [data-anim='calendar'] :global(svg) { animation: ic-flip 700ms var(--ease-out); }
