  .qa__tile { position: relative; display: grid; align-content: start; gap: 6px; padding: 22px 20px 52px; min-height: 176px; border-radius: var(--r-2); box-shadow: inset 0 0 0 1px var(--line); overflow: hidden; transition: box-shadow var(--d-ui), background-color var(--d-ui); }
