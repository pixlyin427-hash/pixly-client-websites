---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import Icon from '../components/Icon.astro';
import Button from '../components/Button.astro';
import Kadamba from '../components/Kadamba.astro';
import SectionHead from '../components/SectionHead.astro';
import Pending from '../components/Pending.astro';
import { school } from '../data/site';
import { stages } from '../data/academics';
import { activities, facilities } from '../data/campus';
import { notices } from '../data/notices';
import { calendarEvents } from '../data/calendar';
import { steps } from '../data/admissions';

const latest = [...notices].filter((n) => !n.archived).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
const todayIso = new Date().toISOString().slice(0, 10);
const nextEvents = [...calendarEvents].filter((e) => e.date >= todayIso).sort((a, b) => a.date.localeCompare(b.date)).slice(0, 2);
const d = (iso: string) => { const [y, m, dd] = iso.split('-').map(Number); return new Date(y, m - 1, dd); };
const dm = (iso: string) => d(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });

const quick = [
  { key: 'calendar', title: 'Academic Calendar', text: 'Term dates, tests and holidays.', href: '/resources/#calendar', icon: 'calendar' },
  { key: 'notices', title: 'Notices', text: 'Latest circulars from school.', href: '/resources/#notices', icon: 'bell' },
  { key: 'fees', title: 'Fee Information', text: 'Published under CBSE disclosure.', href: '/disclosure/#academics', icon: 'rupee' },
  { key: 'transport', title: 'Transport', text: 'Routes & transport enquiry.', href: '/contact/#transport', icon: 'bus' },
  { key: 'books', title: 'Book Lists', text: 'Class-wise, Classes 1–10.', href: '/academics/#centre', icon: 'book' },
  { key: 'downloads', title: 'Downloads', text: 'Forms and documents.', href: '/resources/#downloads', icon: 'download' },
  { key: 'app', title: 'Parent / Student App', text: 'Official app on Google Play.', href: school.app.url, icon: 'phone', external: true },
  { key: 'contact', title: 'Contact the Office', text: 'Address, map and enquiries.', href: '/contact/', icon: 'call' },
] as const;

const highlights = [
  { n: '01', title: 'CBSE affiliated', text: `Affiliation No. ${school.affiliationNo.value}, valid ${school.affiliationPeriod.value}, at the Secondary level.`, art: 'book', tone: 'navy', src: 'CBSE SARAS' },
  { n: '02', title: 'Class 1 to Class 10', text: 'One school through the foundational, preparatory, middle and secondary stages.', art: 'classroom', tone: 'marigold', src: 'Client brief' },
  { n: '03', title: 'Palghar–Boisar Road', text: 'Located in Taluka Palghar, District Palghar, Maharashtra 401404.', art: 'campus', tone: 'sky', src: 'CBSE SARAS' },
  { n: '04', title: 'Connected with parents', text: 'An official Parent / Student app for school communication.', art: 'computer', tone: 'clay', src: 'Client brief' },
  { n: '05', title: 'Transparent by design', text: 'CBSE Mandatory Public Disclosure, organised and easy to find.', art: 'notice', tone: 'ivory', src: 'CBSE requirement' },
] as const;
const stageTone = ['ivory', 'marigold', 'navy', 'sky'] as const;
const actTone = ['marigold', 'clay', 'sky', 'navy', 'ivory', 'navy'] as const;
---
<Base>
  <!-- ======================= HERO ======================= -->
  <section class="hero" data-tilt-scope aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="label hero__kicker" data-reveal="fade"><span class="hero__kicker-line" aria-hidden="true"></span>CBSE · Affiliation No. {school.affiliationNo.value} · Palghar</p>
        <h1 class="display hero__title" id="hero-title" data-reveal="words" style="--delay:120ms">Where curious minds <em>take root.</em></h1>
        <p class="lead hero__lead" data-reveal="up" style="--delay:760ms">{school.name} is a CBSE school on Palghar–Boisar Road, guiding learners from Class 1 to Class 10.</p>
        <div class="hero__ctas" data-reveal="up" style="--delay:920ms">
          <Button href="/admissions/#enquiry">Begin an enquiry</Button>
          <a class="link link--under" href="/our-school/">Discover STKV <Icon name="arrow" /></a>
        </div>
      </div>

      <div class="hero__stage" aria-hidden="true">
        <div class="hero__motif" data-depth="-10"><div data-parallax="-0.06"><Kadamba size={560} delay={700} /></div></div>
        <div class="hero__arch hero__arch--a" data-depth="8"><div data-parallax="0.05"><div class="arch" data-reveal="mask" style="--delay:300ms"><Art name="classroom" tone="navy" /></div></div></div>
        <div class="hero__arch hero__arch--b" data-depth="-6"><div data-parallax="-0.08"><div class="arch" data-reveal="mask" style="--delay:460ms"><Art name="science" tone="marigold" /></div></div></div>
        <div class="hero__arch hero__arch--c" data-depth="14"><div data-parallax="0.12"><div class="arch" data-reveal="mask" style="--delay:620ms"><Art name="sports" tone="sky" /></div></div></div>
        <div class="hero__seal" data-reveal="scale" style="--delay:1100ms" data-depth="20">
          <span class="label">Est.</span><span class="hero__seal-n">2018</span><span class="hero__seal-s">CBSE SARAS</span>
        </div>
      </div>
    </div>

    <div class="container hero__rail" data-reveal="stagger" style="--delay:1150ms">
      <div><span class="label muted">Board</span><strong>CBSE · Secondary</strong></div>
      <div><span class="label muted">Affiliation valid</span><strong>{school.affiliationPeriod.value}</strong></div>
      <div><span class="label muted">Classes</span><strong>1 to 10</strong></div>
      <a class="hero__scroll" href="#intro"><span class="hero__scroll-track"><span class="hero__scroll-dot"></span></span><span class="label">Scroll</span></a>
    </div>
  </section>

  <!-- ======================= INTRO (scroll-lit statement) ======================= -->
  <section class="section intro" id="intro" aria-labelledby="intro-title">
    <div class="container">
      <p class="label sec-head__kicker" data-reveal="fade" id="intro-title">Our school</p>
      <p class="intro__statement" data-scrub-words>Learning at STKV grows from strong foundations — the CBSE curriculum, steady guidance from the first class to the tenth, and a school community that families in Palghar can be part of.</p>
      <div class="intro__facts">
        <div class="intro__fact" data-reveal="up">
          <span class="intro__num tnum" data-count="2018" data-from="1990">2018</span>
          <p>Year of foundation</p><span class="src">CBSE SARAS</span>
        </div>
        <div class="intro__fact" data-reveal="up" style="--delay:120ms">
          <span class="intro__num tnum"><span data-count="10">10</span></span>
          <p>Classes, from Class 1 to Class 10</p><span class="src">Client brief</span>
        </div>
        <div class="intro__fact" data-reveal="up" style="--delay:240ms">
          <span class="intro__num tnum" data-count="2028" data-from="2000">2028</span>
          <p>CBSE affiliation valid until</p><span class="src">CBSE SARAS</span>
        </div>
        <div class="intro__fact intro__fact--cta" data-reveal="up" style="--delay:360ms">
          <p class="h3">Get to know the school, its values and the people who lead it.</p>
          <a class="link link--under" href="/our-school/">About STKV <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= PARENT QUICK ACCESS (background shifts to navy) ======================= -->
  <section class="section qa" data-bg-shift aria-labelledby="qa-title">
    <div class="container">
      <SectionHead kicker="For parents" title="Everything you need, <em>one tap away.</em>" lead="The information families look for most — calendars, notices, fees, transport and the parent app — gathered in one place." split id="qa-title" />
      <div class="qa__grid" data-reveal="stagger">
        <a class="qa__feature" href="/resources/#calendar">
          <div class="qa__feature-head"><span class="qa__ico" data-anim="calendar"><Icon name="calendar" size={26} /></span><span class="label">Coming up</span></div>
          <ul role="list" class="qa__events">
            {nextEvents.map((e) => (
              <li><time datetime={e.date}><b>{d(e.date).getDate()}</b>{d(e.date).toLocaleDateString('en-IN', { month: 'short' })}</time><span>{e.title.replace('Sample: ', '')}{e.sample && <span class="sample-tag">Sample</span>}</span></li>
            ))}
          </ul>
          <span class="qa__more">Open the academic calendar <Icon name="arrow" size={18} /></span>
        </a>
        {quick.map((q) => (
          <a class="qa__tile" href={q.href} data-key={q.key} {...(('external' in q && q.external) ? { target: '_blank', rel: 'noopener' } : {})}>
            <span class="qa__ico" data-anim={q.key}><Icon name={q.icon} size={26} /></span>
            <span class="qa__t">{q.title}{'external' in q && q.external && <span class="sr-only"> (opens Google Play)</span>}</span>
            <span class="qa__d">{q.text}</span>
            <Icon name={'external' in q && q.external ? 'external' : 'arrow'} size={18} class="qa__arrow" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= HIGHLIGHTS (horizontal rail) ======================= -->
  <section class="section hl" aria-labelledby="hl-title" data-rail>
    <div class="container">
      <div class="hl__head">
        <SectionHead kicker="At a glance" title="Five things to know <em>about STKV</em>" id="hl-title" />
        <div class="hl__ctrl">
          <button class="icon-btn" type="button" data-rail-prev aria-label="Previous"><Icon name="chevron-left" /></button>
          <button class="icon-btn" type="button" data-rail-next aria-label="Next"><Icon name="chevron-right" /></button>
        </div>
      </div>
    </div>
    <ol class="hl__track" role="list" data-rail-track tabindex="0" aria-label="Highlights">
      {highlights.map((h, i) => (
        <li class="hl__card" data-reveal="up" style={`--delay:${i * 90}ms`}>
          <div class="arch hl__art"><Art name={h.art} tone={h.tone} /></div>
          <span class="hl__n">{h.n}</span>
          <h3 class="h3">{h.title}</h3>
          <p class="muted">{h.text}</p>
          <span class="src">Source: {h.src}</span>
        </li>
      ))}
    </ol>
    <div class="container"><div class="hl__progress" data-rail-progress><span></span></div></div>
  </section>

  <!-- ======================= ACADEMICS (stage tabs) ======================= -->
  <section class="section acad bg-paper2" aria-labelledby="acad-title">
    <div class="container">
      <SectionHead kicker="Academics" title="A clear path from <em>Class 1 to Class 10</em>" lead="STKV follows the CBSE curriculum, organised in the stages set out by the National Education Policy." split id="acad-title" />
      <div class="tabs" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="Learning stages" data-reveal="fade">
          {stages.map((s, i) => <button class="tabs__tab" role="tab" id={`st-${s.id}`} aria-controls={`sp-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.name}</button>)}
          <span class="tabs__ink" aria-hidden="true"></span>
        </div>
        {stages.map((s, i) => (
          <div class="tab-panel acad__panel" role="tabpanel" id={`sp-${s.id}`} aria-labelledby={`st-${s.id}`} hidden={i !== 0} tabindex="0">
            <div class="acad__copy">
              <p class="acad__range">{s.range[0]}<span>–</span>{s.range[1]}</p>
              <p class="label muted">{s.classes} · {s.name} stage</p>
              <p class="h3 acad__lead">{s.lead}</p>
              <ol class="acad__focus" role="list">{s.focus.map((f, j) => <li><span>0{j + 1}</span>{f}</li>)}</ol>
              <a class="link link--under" href={`/academics/?class=${s.range[0]}#centre`}>Subjects & book lists for {s.classes} <Icon name="arrow" /></a>
            </div>
            <div class="arch acad__art"><Art name={s.art} tone={stageTone[i]} /></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================= ACTIVITIES (sticky swap) ======================= -->
  <section class="section act" aria-labelledby="act-title" data-sticky-swap>
    <div class="container act__grid">
      <div class="act__list">
        <SectionHead kicker="Activities" title="Life beyond <em>the textbook</em>" id="act-title" />
        <p class="muted act__note"><Pending label="Programme details awaiting confirmation" source="Activity areas shown for the design. The school will confirm its programmes and provide photographs." /></p>
        <ol role="list">
          {activities.map((a, i) => (
            <li class="act__row" data-ss-row>
              <span class="act__i">0{i + 1}</span>
              <div><h3 class="act__name">{a.name}</h3><p class="act__line">{a.line}</p></div>
              <div class="arch act__thumb" aria-hidden="true"><Art name={a.art} tone={actTone[i]} /></div>
            </li>
          ))}
        </ol>
        <a class="link link--under" href="/campus-life/">Explore campus life <Icon name="arrow" /></a>
      </div>
      <div class="act__stage" aria-hidden="true">
        <div class="act__sticky">
          <div class="arch act__frames">
            {activities.map((a, i) => <div class="act__frame" data-ss-frame><Art name={a.art} tone={actTone[i]} /></div>)}
          </div>
          <p class="act__count"><span data-ss-count>01</span> / 0{activities.length}<span class="act__cap">Illustration</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= FACILITIES (hover reveal index) ======================= -->
  <section class="section fac on-dark bg-navy" aria-labelledby="fac-title">
    <div class="container">
      <SectionHead kicker="Facilities" title="Spaces for <em>learning</em>" lead="An index of the learning spaces families can explore on a campus visit. Descriptions and photographs will be added by the school." split id="fac-title" />
      <div class="fac__list" data-hover-reveal>
        <ul role="list">
          {facilities.map((f, i) => (
            <li class="fac__row" data-hr-row data-reveal="up" style={`--delay:${i * 60}ms`}>
              <span class="fac__i">0{i + 1}</span>
              <span class="fac__name">{f.name}</span>
              <span class="fac__line">{f.line}</span>
              <span class="fac__status" data-tip-end data-tip="Awaiting confirmation from the school" tabindex="0"><span class="sr-only">Awaiting confirmation</span></span>
              <div class="arch fac__thumb" aria-hidden="true"><Art name={f.art} tone="marigold" /></div>
            </li>
          ))}
        </ul>
        <div class="fac__float arch" data-hr-float aria-hidden="true">
          {facilities.map((f) => <div class="fac__slide" data-hr-slide><Art name={f.art} tone="marigold" /></div>)}
        </div>
      </div>
      <div class="fac__cta" data-reveal="up"><Button href="/admissions/#visit" variant="light">Request a campus visit</Button><a class="link link--under" href="/campus-life/#facilities">All facilities <Icon name="arrow" /></a></div>
    </div>
  </section>

  <!-- ======================= ACHIEVEMENTS (honour board) ======================= -->
  <section class="section ach" aria-labelledby="ach-title">
    <div class="container ach__grid">
      <div>
        <SectionHead kicker="Achievements" title="An honour board, <em>ready for our students</em>" id="ach-title" />
        <p class="prose" data-reveal="up">Student achievements in academics, sport, the arts and Olympiads will be celebrated here. We will only publish achievements that the school has verified.</p>
        <div style="margin-top:28px" data-reveal="up"><a class="link link--under" href="/campus-life/#achievements">See the achievement showcase <Icon name="arrow" /></a></div>
      </div>
      <div class="board" data-reveal="scale">
        <div class="board__head"><span class="label">Honour Board</span><span class="label">Shri S. T. Kadam Vidyalaya</span></div>
        <Kadamba class="board__motif" size={220} />
        <ol class="board__rows" role="list">
          {['Academics', 'Sport', 'Arts'].map((c, i) => (
            <li style={`--i:${i}`}><span class="board__cat">{c}</span><span class="board__ph">Student name</span><span class="board__ph board__ph--w">Achievement</span><span class="board__ph board__ph--s">Year</span></li>
          ))}
        </ol>
        <p class="board__foot"><Pending label="Awaiting verified achievements from the school" /></p>
      </div>
    </div>
  </section>

  <!-- ======================= NEWS ======================= -->
  <section class="section news bg-paper2" aria-labelledby="news-title">
    <div class="container">
      <SectionHead kicker="Latest from school" title="Notices & <em>news</em>" lead="Demonstration notices show how updates will appear. Real notices will be published by the school office." split id="news-title" />
      <div class="news__grid">
        <a class="news__feature" href={`/resources/?q=${encodeURIComponent(latest[0].title.replace(/^Sample (notice|circular) — /, ''))}#notices`} data-reveal="up">
          <div class="frame news__art" data-reveal="mask"><Art name="notice" tone="navy" /></div>
          <p class="nrow__meta"><span class="nrow__cat" data-cat={latest[0].category}>{latest[0].category}</span><span>{dm(latest[0].date)}</span><span class="sample-tag">Sample</span></p>
          <h3 class="h3">{latest[0].title}</h3>
          <span class="link">Read notice <Icon name="arrow" /></span>
        </a>
        <ul class="news__list" role="list" data-reveal="stagger">
          {latest.slice(1).map((n) => (
            <li><a href={`/resources/?q=${encodeURIComponent(n.title.replace(/^Sample (notice|circular) — /, ''))}#notices`} class="news__item">
              <time datetime={n.date}><b>{d(n.date).getDate()}</b>{d(n.date).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })}</time>
              <span><span class="nrow__cat" data-cat={n.category}>{n.category}</span><span class="news__t">{n.title}</span></span>
              <Icon name="arrow" size={20} class="news__arrow" />
            </a></li>
          ))}
        </ul>
      </div>
      <div class="news__cta" data-reveal="up"><Button href="/resources/#notices" variant="ghost">Open the Notice Centre</Button></div>
    </div>
  </section>

  <!-- ======================= ADMISSIONS CTA ======================= -->
  <section class="section adm bg-marigold" aria-labelledby="adm-title">
    <div class="container">
      <div class="adm__top">
        <p class="label sec-head__kicker" data-reveal="fade">Admissions</p>
        <h2 class="display adm__title" id="adm-title" data-reveal="words">Thinking of joining <em>STKV?</em></h2>
      </div>
      <ol class="adm__steps" role="list">
        <li class="adm__line" aria-hidden="true" data-reveal="line" style="--delay:300ms"></li>
        {steps.map((s, i) => (
          <li class="adm__step" data-reveal="up" style={`--delay:${300 + i * 140}ms`}><span class="adm__n">{s.n}</span><h3 class="h4">{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
      <div class="adm__ctas" data-reveal="up">
        <Button href="/admissions/#enquiry">Start an enquiry</Button>
        <Button href="/admissions/#visit" variant="ghost">Book a campus visit</Button>
        <a class="link link--under" href="/admissions/#documents">Document checklist <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ======================= IMPORTANT LINKS ======================= -->
  <section class="section-tight links" aria-labelledby="links-title">
    <div class="container">
      <h2 class="label sec-head__kicker" id="links-title">Important links</h2>
      <ul class="links__list" role="list" data-reveal="stagger">
        <li><a href="/disclosure/"><span>CBSE Mandatory Public Disclosure</span><Icon name="arrow" size={22} /></a></li>
        <li><a href="/academics/#centre"><span>Class-wise book lists</span><Icon name="arrow" size={22} /></a></li>
        <li><a href={school.app.url} target="_blank" rel="noopener"><span>Parent / Student App</span><Icon name="external" size={22} /></a></li>
        <li><a href={school.sarasUrl} target="_blank" rel="noopener"><span>CBSE SARAS affiliation record</span><Icon name="external" size={22} /></a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; min-height: 100svh; padding-top: calc(var(--header-h) + 38px + clamp(24px, 5vh, 64px)); display: grid; grid-template-rows: 1fr auto; overflow: clip; }
  .hero::before { content: ''; position: absolute; inset: auto 0 0; height: 45%; background: linear-gradient(to top, var(--paper-2), transparent); pointer-events: none; }
  .hero__grid { position: relative; display: grid; gap: 40px; align-items: center; }
  @media (min-width: 1000px) { .hero__grid { grid-template-columns: 1.05fr 0.95fr; gap: 24px; } }
  .hero__kicker { display: inline-flex; align-items: center; gap: 14px; color: var(--ink-2); }
  .hero__kicker-line { width: 36px; height: 1px; background: var(--marigold-600); }
  .hero__title { margin-top: 26px; max-width: 9.5ch; }
  .hero__title :global(em) { color: var(--navy-700); position: relative; }
  .hero__lead { margin-top: 28px; }
  .hero__ctas { margin-top: 40px; display: flex; flex-wrap: wrap; align-items: center; gap: 28px; }

  .hero__stage { position: relative; height: clamp(380px, 62vw, 640px); }
  @media (min-width: 1000px) { .hero__stage { height: min(68vh, 680px); } }
  .hero__stage > * { position: absolute; }
  .hero__motif { inset: 50% auto auto 50%; width: 120%; translate: 0 0; transform: translate(-50%, -50%); color: var(--marigold-600); opacity: 0.55; pointer-events: none; }
  .hero__motif :global(svg) { width: 100%; height: auto; }
  .hero__arch .arch { box-shadow: var(--shadow-3); }
  .hero__arch--a { width: 44%; left: 4%; top: 14%; z-index: 2; }
  .hero__arch--b { width: 34%; right: 4%; top: 0; z-index: 1; }
  .hero__arch--c { width: 38%; right: 12%; bottom: 0; z-index: 3; }
  .hero__seal { left: 6%; bottom: 4%; z-index: 4; width: 116px; height: 116px; border-radius: 50%; background: var(--navy-900); color: var(--paper); display: grid; place-content: center; text-align: center; box-shadow: var(--shadow-2); }
  .hero__seal-n { font-family: var(--font-display); font-size: 2rem; line-height: 1; letter-spacing: -0.03em; }
  .hero__seal-s { margin-top: 6px; font-size: 0.5625rem; font-weight: 800; letter-spacing: 0.14em; opacity: 0.6; }

  .hero__rail { position: relative; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px 24px; padding-block: 28px 36px; margin-top: 40px; border-top: 1px solid var(--line); }
  .hero__rail > div { display: grid; gap: 6px; }
  .hero__rail strong { font-weight: 700; }
  @media (min-width: 760px) { .hero__rail { grid-template-columns: repeat(3, 1fr) auto; align-items: center; } }
  .hero__scroll { display: none; align-items: center; gap: 14px; color: var(--ink-2); }
  @media (min-width: 760px) { .hero__scroll { display: inline-flex; } }
  .hero__scroll-track { position: relative; width: 22px; height: 36px; border-radius: 12px; box-shadow: inset 0 0 0 1.5px var(--line-strong); }
  .hero__scroll-dot { position: absolute; left: 50%; top: 7px; width: 4px; height: 7px; margin-left: -2px; border-radius: 2px; background: var(--navy-900); animation: scroll-dot 2.2s var(--ease-in-out) 2s 4; }
  @keyframes scroll-dot { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(12px); opacity: 0; } 100% { transform: translateY(0); opacity: 0; } }

  /* ---------- Intro ---------- */
  .intro__statement { margin-top: 32px; font-family: var(--font-display); font-size: clamp(1.75rem, 1.1rem + 2.7vw, 3.6rem); line-height: 1.16; letter-spacing: -0.025em; font-weight: 340; max-width: 24ch; }
  .intro__statement :global(.w) { opacity: 0.2; transition: opacity 500ms var(--ease-out); overflow: visible; }
