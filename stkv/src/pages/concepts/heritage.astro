---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/manrope/index.css';
import '@fontsource/tiro-devanagari-sanskrit/400.css';
import { Image } from 'astro:assets';
import ConceptBase from '../../components/concepts/ConceptBase.astro';
import Photo from '../../components/concepts/Photo.astro';
import { photos, logoTransparent as logoOfficial } from '../../data/photos';
import { verified as v } from '../../data/verified';

const today = new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
// Jeevan Vikas Shikshan Sanstha institutions, as published on stkvem.com/about-trust
const timeline = [
  { y: 1966, t: 'Jeevan Vikas Shikshan Sanstha founded', d: 'By Late Shri Sadanand T. Kadam and his associates.' },
  { y: 1968, t: 'S. T. Kadam Vidyalaya Secondary School', d: 'Marathi medium, Palghar.' },
  { y: 1970, t: 'Residential Primary School', d: 'Shigaon.' },
  { y: 1971, t: 'Anu Vikas Vidyalaya Secondary School', d: 'Dandi.' },
  { y: 1990, t: 'Residential Secondary School', d: 'Shigaon.' },
  { y: 2004, t: 'S. T. Kadam Vidyalaya Primary School', d: 'Marathi medium, Palghar.' },
  { y: 2008, t: 'S. T. Kadam Jr College of Arts & Commerce', d: 'Palghar.' },
  { y: 2009, t: 'Anu Vikas English High School', d: 'Dandi.' },
  { y: 2018, t: 'Shri S. T. Kadam Vidyalaya (CBSE)', d: 'Our school opens in Palghar.', hl: true },
  { y: 2023, t: 'CBSE affiliation granted', d: `Affiliation No. ${v.cbse.affiliationNo}, Secondary level.`, hl: true },
];
const numbers = [
  ['Learners, Bal Vatika to Class 10', v.stats.students.toLocaleString('en-IN')],
  ['Teachers', String(v.stats.teachers)],
  ['Digital classrooms', String(v.stats.digitalClassrooms)],
  ['Books in the library', v.stats.libraryBooks.toLocaleString('en-IN')],
  ['Laboratories', String(v.stats.labs)],
  ['Campus area', `${v.stats.campusSqM.toLocaleString('en-IN')} m²`],
];
---
<ConceptBase title="B · Heritage Editorial" theme="heritage">
  <header class="mast">
    <div class="mast__strip wrap">
      <span>{today}</span>
      <span class="mast__mid">A Jeevan Vikas Shikshan Sanstha institution · Since 1966</span>
      <span>CBSE {v.cbse.affiliationNo}</span>
    </div>
    <div class="mast__brand wrap" data-mast>
      <hr class="rule" data-rule />
      <a href="#" class="mast__logo"><Image src={logoOfficial} alt="Shri S. T. Kadam Vidyalaya — official logo" width={260} /></a>
      <hr class="rule" data-rule />
    </div>
    <nav class="mast__nav wrap" aria-label="Main">
      {['Our School', 'Academics', 'Campus Life', 'Admissions', 'News & Resources', 'Disclosure'].map((n) => <a href="#">{n}</a>)}
      <a class="mast__apply" href="#admissions">Admissions 2027–28 →</a>
    </nav>
  </header>

  <main>
    <section class="lead wrap">
      <div class="lead__copy">
        <p class="kicker" data-fade>The STKV Edition · Palghar, Maharashtra</p>
        <h1 class="lead__title" data-lines>A school <em>with a difference.</em></h1>
        <p class="lead__deck" data-fade>Every aspect of a child’s growth — intellectual, social, physical, emotional and moral — guided by teachers who know each student, and a curriculum that makes curiosity a habit.</p>
        <div class="lead__byline" data-fade>
          <div><span class="label">Our mission</span><p>{v.mission}</p></div>
          <div><span class="label">Our vision</span><p>{v.vision}</p></div>
        </div>
      </div>
      <div class="lead__collage">
        <div class="cl cl--main" data-wipe data-speed="-0.06"><Photo photo={photos.classroom} eager sizes="(min-width:1000px) 40vw, 100vw" /></div>
        <div class="cl cl--inset" data-wipe data-speed="0.12"><Photo photo={photos.lab} sizes="(min-width:1000px) 22vw, 60vw" /></div>
        <p class="cl__cap" data-fade><b>Fig. 1</b> Lessons that invite questions; experiments that answer them.</p>
        <div class="cl__seal" data-seal><span>Est.</span><b>2018</b><span>Palghar</span></div>
      </div>
    </section>

    <section class="time" aria-labelledby="time-t">
      <div class="time__pin" data-time-pin>
        <div class="wrap time__head">
          <p class="kicker kicker--gold">Six decades of Jeevan Vikas</p>
          <h2 class="h2" id="time-t">Our story began <em>in 1966.</em></h2>
        </div>
        <div class="time__track" data-time-track>
          <span class="time__line" aria-hidden="true"><span data-time-line></span></span>
          <ol role="list" class="time__list">
            {timeline.map((e) => (
              <li class:list={['ev', { 'ev--hl': e.hl }]}>
                <span class="ev__y">{e.y}</span>
                <span class="ev__dot" aria-hidden="true"></span>
                <h3>{e.t}</h3>
                <p>{e.d}</p>
              </li>
            ))}
          </ol>
        </div>
        <p class="wrap time__src">Source: stkvem.com · About Trust</p>
      </div>
    </section>

    <section class="feature">
      <div class="feature__photo" data-wipe><Photo photo={photos.riding} sizes="(min-width:1000px) 55vw, 100vw" /></div>
      <div class="feature__text">
        <p class="kicker">Inside the school week</p>
        <h2 class="h2" data-lines>Horse riding before history class? <em>At STKV, yes.</em></h2>
        <div class="cols" data-fade>
          <p class="drop">Physical fitness keeps an active mind, so the week is built around more than the timetable: horse riding, skating, music, dance, folk-fitness, brain-gym, yoga, Zumba and indoor motor-skill training sit alongside mathematics, reading, writing and critical thinking.</p>
          <p>Teachers vary their teaching styles so that each child can develop as an individual — understanding over memorising, creativity celebrated, freedom balanced with responsibility.</p>
        </div>
        <aside class="nums" aria-label="STKV by the numbers">
          <p class="label">By the numbers</p>
          <dl>{numbers.map(([k, n]) => <div data-num><dt>{k}</dt><dd>{n}</dd></div>)}</dl>
          <p class="nums__src">CBSE OASIS record, published by the school</p>
        </aside>
      </div>
    </section>

    <section class="strip">
      <div class="strip__row" data-strip>
        <div class="strip__item"><Photo photo={photos.janmashtami} sizes="30vw" /></div>
        <div class="strip__item strip__item--t"><Photo photo={photos.dance} sizes="20vw" /></div>
        <div class="strip__item"><Photo photo={photos.skating} sizes="30vw" /></div>
        <div class="strip__item strip__item--t"><Photo photo={photos.art} sizes="20vw" /></div>
        <div class="strip__item"><Photo photo={photos.carnival} sizes="30vw" /></div>
        <div class="strip__item"><Photo photo={photos.computer} sizes="30vw" /></div>
      </div>
    </section>

    <section class="motto">
      <div class="wrap motto__grid">
        <div class="motto__portrait" data-wipe><Photo photo={photos.founder} sizes="(min-width:1000px) 26vw, 70vw" /><p class="motto__cap">Late Shri S. T. Kadam · Founder Chairman</p></div>
        <div>
          <p class="kicker kicker--gold">Our motto</p>
          <p class="motto__sa" lang="sa" data-motto>{v.motto.sanskrit}</p>
          <p class="motto__en" data-fade>“{v.motto.meaning}.” <span>A trust founded on one idea: education for every section of society.</span></p>
        </div>
      </div>
    </section>

    <section class="notice wrap" id="admissions">
      <div class="notice__box" data-notice>
        <div class="notice__head"><span class="label">Notice</span><span class="label">Admissions 2027–28</span></div>
        <h2 class="notice__title" data-lines>Applications open on <em>1 December.</em></h2>
        <ol class="notice__steps" role="list">
          <li><b>I.</b> Collect or download the admission form.</li>
          <li><b>II.</b> Submit it at the school office.</li>
          <li><b>III.</b> Receive provisional admission and complete formalities.</li>
          <li><b>IV.</b> Admission confirmed.</li>
        </ol>
        <p class="notice__rule"><b>Age criterion.</b> {v.admissions.age}</p>
        <div class="notice__ctas"><a href="#" class="hbtn hbtn--solid">Make an enquiry</a><a href="#" class="hbtn">Book a campus visit</a><span class="notice__tel">Office: {v.contact.phone}</span></div>
      </div>
    </section>

    <footer class="hfoot">
      <div class="wrap hfoot__in">
        <p class="hfoot__name">Shri S. T. Kadam Vidyalaya</p>
        <p>{v.contact.address} · {v.contact.email} · {v.timings.office}</p>
        <p class="hfoot__honest">Concept preview · Photos marked “AI concept image” are illustrative and will be replaced by approved school photography.</p>
      </div>
    </footer>
  </main>
</ConceptBase>

<style is:global>
  .heritage { --paper: #f3ede2; --paper2: #e9e0cf; --maroon: #8c1c23; --red: #b8322c; --navy: #1d2b64; --gold: #c99a2e; --ink: #1a1614; --muted: #5c524a;
    --serif: 'Fraunces Variable', Georgia, serif; --sans: 'Manrope Variable', system-ui, sans-serif; --ease: cubic-bezier(.22,1,.36,1); }
  .heritage body { background: var(--paper); color: var(--ink); font: 500 1.05rem/1.65 var(--sans); }
  .heritage .wrap { width: min(100% - 2 * clamp(16px, 4vw, 56px), 1360px); margin-inline: auto; }
  .heritage .label, .heritage .kicker { font: 800 .72rem/1.3 var(--sans); letter-spacing: .18em; text-transform: uppercase; }
  .heritage .kicker { color: var(--maroon); } .heritage .kicker--gold { color: var(--gold); }
  .heritage .h2 { font: 400 clamp(2.3rem, 1.4rem + 3.6vw, 5rem)/1 var(--serif); letter-spacing: -0.03em; margin-top: 14px; }
  .heritage .h2 em, .heritage .lead__title em, .heritage .notice__title em { font-style: italic; color: var(--maroon); font-weight: 340; }
  .heritage .rule { border: 0; height: 2px; background: var(--ink); transform-origin: center; }

  .heritage .mast { background: var(--paper); border-bottom: 1px solid var(--ink); }
  .heritage .mast__strip { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; font: 700 .72rem var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  @media (max-width: 760px) { .heritage .mast__mid, .heritage .mast__strip span:first-child { display: none; } }
  .heritage .mast__brand { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; padding: 6px 0 10px; }
  .heritage .mast__logo img { width: clamp(150px, 16vw, 230px); height: auto; }
  .heritage .mast__nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 28px; padding: 14px 0; border-top: 1px solid var(--ink); font: 700 .9rem var(--sans); }
  .heritage .mast__nav a { position: relative; padding: 4px 0; }
  .heritage .mast__nav a::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--maroon); transform: scaleX(0); transform-origin: right; transition: transform .45s var(--ease); }
  .heritage .mast__nav a:hover::after { transform: scaleX(1); transform-origin: left; }
  .heritage .mast__apply { color: var(--maroon); }
  @media (max-width: 760px) { .heritage .mast__nav a:not(.mast__apply) { display: none; } }

  .heritage .lead { display: grid; gap: 48px; padding: clamp(40px, 6vw, 90px) 0 clamp(80px, 9vw, 130px); }
  @media (min-width: 1000px) { .heritage .lead { grid-template-columns: 1.1fr .9fr; gap: 64px; align-items: start; } }
  .heritage .lead__title { margin-top: 18px; font: 360 clamp(3.4rem, 1.8rem + 7vw, 9rem)/.9 var(--serif); letter-spacing: -0.045em; }
  .heritage .lead__deck { margin-top: 28px; font: 400 clamp(1.2rem, 1.05rem + .6vw, 1.55rem)/1.45 var(--serif); max-width: 34ch; }
  .heritage .lead__byline { margin-top: 36px; display: grid; gap: 22px; padding-top: 22px; border-top: 1px solid var(--ink); }
  @media (min-width: 700px) { .heritage .lead__byline { grid-template-columns: 1fr 1fr; } }
  .heritage .lead__byline .label { color: var(--maroon); }
  .heritage .lead__byline p { margin-top: 8px; font-size: .95rem; color: var(--muted); }
  .heritage .lead__collage { position: relative; min-height: 560px; }
  .heritage .cl { position: absolute; overflow: hidden; box-shadow: 0 30px 60px -20px rgb(26 22 20 / .45); }
  .heritage .cl .ph { width: 100%; height: 100%; }
  .heritage .cl--main { inset: 0 12% 14% 0; }
  .heritage .cl--inset { right: 0; bottom: 0; width: 54%; aspect-ratio: 4/5; border: 10px solid var(--paper); }
  .heritage .cl__cap { position: absolute; left: 0; bottom: 0; width: 40%; font: italic 400 .95rem/1.4 var(--serif); }
  .heritage .cl__cap b { font: 800 .7rem var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--maroon); display: block; }
  .heritage .cl__seal { position: absolute; left: -24px; top: 30px; width: 110px; height: 110px; border-radius: 50%; background: var(--maroon); color: var(--paper); display: grid; place-content: center; text-align: center; font: 700 .62rem var(--sans); letter-spacing: .14em; text-transform: uppercase; box-shadow: 0 0 0 6px var(--paper), 0 0 0 7px var(--maroon); }
  .heritage .cl__seal b { font: 400 2rem/1 var(--serif); letter-spacing: -0.02em; }
  @media (max-width: 999px) { .heritage .lead__collage { min-height: 480px; } .heritage .cl__seal { left: 8px; top: -20px; } }

  .heritage .time { background: var(--navy); color: var(--paper); overflow: clip; }
  .heritage .time__pin { min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr); align-content: center; gap: 40px; padding: 80px 0; }
  .heritage .time__head .h2 em { color: var(--gold); }
  .heritage .time__track { position: relative; padding: 0 max(clamp(16px, 4vw, 56px), calc((100vw - 1360px) / 2)); }
  .heritage .time__line { position: absolute; left: 0; right: 0; top: 76px; height: 2px; background: rgb(243 237 226 / .2); }
  .heritage .time__line span { position: absolute; inset: 0; background: var(--gold); transform-origin: left; transform: scaleX(0); }
  .heritage .time__list { display: flex; gap: 0; width: max-content; }
  .heritage .ev { position: relative; width: clamp(240px, 24vw, 320px); padding-right: 40px; display: grid; gap: 10px; align-content: start; }
  .heritage .ev__y { font: 300 clamp(3rem, 2rem + 2.6vw, 4.4rem)/1 var(--serif); letter-spacing: -0.04em; color: rgb(243 237 226 / .55); }
  .heritage .ev__dot { width: 16px; height: 16px; border-radius: 50%; background: var(--navy); box-shadow: inset 0 0 0 2px var(--gold); margin: 2px 0 8px; }
  .heritage .ev h3 { font: 400 1.25rem/1.2 var(--serif); }
  .heritage .ev p { font-size: .9rem; color: rgb(243 237 226 / .7); }
  .heritage .ev--hl .ev__y { color: var(--gold); } .heritage .ev--hl .ev__dot { background: var(--gold); }
  .heritage .time__src { font: 700 .7rem var(--sans); letter-spacing: .12em; text-transform: uppercase; opacity: .55; }
  @media (max-width: 760px) { .heritage .time__list { flex-direction: column; width: auto; gap: 28px; } .heritage .time__line { display: none; } .heritage .ev { width: auto; padding: 0 0 0 28px; border-left: 2px solid var(--gold); } .heritage .ev__dot { display: none; } }

  .heritage .feature { display: grid; }
  @media (min-width: 1000px) { .heritage .feature { grid-template-columns: 1.05fr .95fr; } }
  .heritage .feature__photo { min-height: 520px; position: relative; }
  .heritage .feature__photo .ph { position: absolute; inset: 0; }
  .heritage .feature__text { padding: clamp(48px, 6vw, 96px) clamp(20px, 5vw, 80px); background: var(--paper2); }
  .heritage .cols { margin-top: 28px; columns: 2 260px; column-gap: 36px; color: var(--muted); }
  .heritage .cols p + p { margin-top: 1em; }
  .heritage .drop::first-letter { float: left; font: 400 4.6em/.8 var(--serif); padding: .08em .1em 0 0; color: var(--maroon); }
  .heritage .nums { margin-top: 40px; padding: 24px; border: 2px solid var(--ink); background: var(--paper); }
  .heritage .nums dl { margin-top: 12px; display: grid; }
  .heritage .nums dl div { display: flex; align-items: baseline; gap: 10px; padding: 8px 0; border-bottom: 1px dashed rgb(26 22 20 / .3); }
  .heritage .nums dt { font-size: .9rem; color: var(--muted); flex: 1; }
  .heritage .nums dd { font: 400 1.7rem/1 var(--serif); color: var(--maroon); }
  .heritage .nums__src { margin-top: 10px; font-size: .72rem; color: var(--muted); }

  .heritage .strip { padding: 14px 0; background: var(--ink); overflow: clip; }
  .heritage .strip__row { display: flex; gap: 14px; width: max-content; }
  .heritage .strip__item { width: clamp(260px, 30vw, 440px); aspect-ratio: 3/2; }
  .heritage .strip__item--t { width: clamp(170px, 18vw, 270px); aspect-ratio: 2/3; }
  .heritage .strip__item .ph { width: 100%; height: 100%; }
  .heritage .strip__item--t { height: auto; } .heritage .strip__row { align-items: center; }

  .heritage .motto { padding: clamp(80px, 10vw, 150px) 0; background: var(--maroon); color: var(--paper); }
  .heritage .motto__grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .heritage .motto__grid { grid-template-columns: .45fr 1.55fr; gap: 80px; } }
  .heritage .motto__portrait .ph { aspect-ratio: 4/5; max-width: 330px; border: 10px solid var(--paper); }
  .heritage .motto__portrait .ph__img { filter: grayscale(1) sepia(.35) contrast(1.05); }
  .heritage .motto__cap { margin-top: 12px; font: italic 400 .95rem var(--serif); opacity: .85; }
  .heritage .motto__sa { margin-top: 18px; font: 400 clamp(3rem, 1.6rem + 6vw, 8rem)/1.25 'Tiro Devanagari Sanskrit', var(--serif); }
  .heritage .motto__en { margin-top: 18px; font: italic 400 clamp(1.3rem, 1.1rem + .9vw, 2rem)/1.35 var(--serif); max-width: 40ch; }
  .heritage .motto__en span { display: block; margin-top: 10px; font: 500 1rem/1.6 var(--sans); font-style: normal; opacity: .8; }

  .heritage .notice { padding: clamp(80px, 10vw, 140px) 0; }
  .heritage .notice__box { position: relative; padding: clamp(28px, 5vw, 64px); background: #fffdf8; border: 2px solid var(--ink); box-shadow: 14px 14px 0 var(--navy); }
  .heritage .notice__head { display: flex; justify-content: space-between; padding-bottom: 14px; border-bottom: 2px solid var(--ink); color: var(--maroon); }
  .heritage .notice__title { margin-top: 26px; font: 360 clamp(2.6rem, 1.6rem + 4.4vw, 6rem)/.95 var(--serif); letter-spacing: -0.04em; }
  .heritage .notice__steps { margin-top: 34px; display: grid; gap: 14px; }
  @media (min-width: 900px) { .heritage .notice__steps { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
  .heritage .notice__steps li { padding-top: 14px; border-top: 1px solid var(--ink); }
  .heritage .notice__steps b { display: block; font: 400 1.8rem var(--serif); color: var(--maroon); }
  .heritage .notice__rule { margin-top: 28px; padding: 14px 18px; background: var(--paper); border-left: 4px solid var(--gold); }
  .heritage .notice__ctas { margin-top: 30px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .heritage .hbtn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border: 2px solid var(--ink); font: 800 .95rem var(--sans); transition: background-color .3s, color .3s, transform .3s var(--ease); }
  .heritage .hbtn:hover { background: var(--ink); color: var(--paper); transform: translate(-3px, -3px); box-shadow: 3px 3px 0 var(--maroon); }
  .heritage .hbtn--solid { background: var(--maroon); border-color: var(--maroon); color: var(--paper); }
  .heritage .notice__tel { font-weight: 700; color: var(--muted); }

  .heritage .hfoot { padding: 50px 0 110px; border-top: 2px solid var(--ink); font-size: .9rem; color: var(--muted); }
  .heritage .hfoot__in { display: grid; gap: 10px; }
  .heritage .hfoot__name { font: 400 2rem var(--serif); color: var(--ink); }
  .heritage .hfoot__honest { font-size: .8rem; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';
  gsap.registerPlugin(ScrollTrigger, SplitText);

  const mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    // Masthead rules draw outward, logo rises
    gsap.from('[data-rule]', { scaleX: 0, duration: 1.4, ease: 'expo.inOut' });
    gsap.from('.mast__logo', { y: 20, autoAlpha: 0, duration: 1, ease: 'expo.out', delay: .3 });

    // Headlines: line-by-line mask rise (editorial)
    document.querySelectorAll<HTMLElement>('[data-lines]').forEach((h, i) => {
      const s = SplitText.create(h, { type: 'lines', mask: 'lines', autoSplit: true, onSplit: (self) =>
        gsap.from(self.lines, { yPercent: 105, duration: 1.2, stagger: .1, ease: 'expo.out', delay: i === 0 ? .4 : 0, scrollTrigger: i === 0 ? undefined : { trigger: h, start: 'top 85%' } }) });
      return s;
    });
    gsap.utils.toArray<HTMLElement>('[data-fade]').forEach((el) => gsap.from(el, { y: 24, autoAlpha: 0, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: el, start: 'top 90%' } }));

    // Photos wipe down like a printed plate, then drift at their own speed
    gsap.utils.toArray<HTMLElement>('[data-wipe]').forEach((el, i) => {
      gsap.fromTo(el, { clipPath: 'inset(0% 0% 100% 0%)' }, { clipPath: 'inset(0% 0% 0% 0%)', duration: 1.4, ease: 'power4.inOut', delay: i < 2 ? .5 + i * .2 : 0, scrollTrigger: i < 2 ? undefined : { trigger: el, start: 'top 80%' } });
      gsap.from(el.querySelector('.ph__img'), { scale: 1.25, duration: 2, ease: 'power3.out', delay: i < 2 ? .5 : 0, scrollTrigger: i < 2 ? undefined : { trigger: el, start: 'top 80%' } });
      if (el.dataset.speed) gsap.to(el, { yPercent: Number(el.dataset.speed) * 100, ease: 'none', scrollTrigger: { trigger: '.lead', start: 'top top', end: 'bottom top', scrub: true } });
    });
    gsap.from('[data-seal]', { scale: 0, rotate: -120, duration: 1.2, ease: 'back.out(1.7)', delay: 1.2 });
    gsap.to('[data-seal]', { rotate: 40, ease: 'none', scrollTrigger: { trigger: '.lead', start: 'top top', end: 'bottom top', scrub: true } });

    // Pinned horizontal heritage timeline (desktop/tablet only)
    const track = document.querySelector<HTMLElement>('[data-time-track] .time__list')!;
    const m2 = gsap.matchMedia();
    m2.add('(min-width: 761px)', () => {
      const dist = () => track.scrollWidth - window.innerWidth + 160;
      const tl = gsap.timeline({ scrollTrigger: { trigger: '[data-time-pin]', start: 'top top', end: () => `+=${dist()}`, pin: true, scrub: 1, invalidateOnRefresh: true } });
      tl.to(track, { x: () => -dist(), ease: 'none' }, 0).to('[data-time-line]', { scaleX: 1, ease: 'none' }, 0);
      gsap.utils.toArray<HTMLElement>('.ev').forEach((ev) => gsap.from(ev.children, { y: 30, autoAlpha: 0, stagger: .05, duration: .6, ease: 'power2.out', scrollTrigger: { trigger: ev, containerAnimation: tl, start: 'left 85%' } }));
    });

    // Numbers tick in with dotted leaders
    gsap.from('[data-num]', { x: -20, autoAlpha: 0, stagger: .08, duration: .7, ease: 'power3.out', scrollTrigger: { trigger: '.nums', start: 'top 80%' } });

    // Photo strip drifts horizontally with scroll (no pinning)
    gsap.fromTo('[data-strip]', { x: 0 }, { x: () => -(document.querySelector<HTMLElement>('[data-strip]')!.scrollWidth - innerWidth), ease: 'none', scrollTrigger: { trigger: '.strip', start: 'top bottom', end: 'bottom top', scrub: true, invalidateOnRefresh: true } });

    // Motto letters bloom
    const motto = SplitText.create('[data-motto]', { type: 'chars' });
    gsap.from(motto.chars, { autoAlpha: 0, y: 40, rotateX: -60, stagger: .04, duration: 1, ease: 'expo.out', scrollTrigger: { trigger: '[data-motto]', start: 'top 80%' } });

    // Notice board slams in with a shadow offset
    gsap.from('[data-notice]', { y: 60, rotate: -1.5, boxShadow: '0px 0px 0 #1d2b64', duration: 1.2, ease: 'expo.out', scrollTrigger: { trigger: '[data-notice]', start: 'top 80%' } });
  });
</script>
