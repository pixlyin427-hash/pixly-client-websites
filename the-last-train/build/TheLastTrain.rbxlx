<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item><Item class="Lighting" referent="RBX00000002"><Properties><string name="Name">Lighting</string><token name="Technology">3</token><bool name="GlobalShadows">true</bool></Properties></Item><Item class="Players" referent="RBX00000003"><Properties><string name="Name">Players</string><bool name="CharacterAutoLoads">false</bool></Properties></Item><Item class="ReplicatedStorage" referent="RBX00000010"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX0000000F"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX00000009"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">AudioConfig</string><ProtectedString name="Source"><![CDATA[--[[
	AudioConfig
	Every sound the game uses, in one place.

	IMPORTANT: Id = "" means "not configured yet". The SoundController skips
	empty ids entirely (no Sound is created, nothing errors in Output), so the
	game runs silently until you paste real asset ids here.

	How to fill: Studio > Toolbox > Audio (or create.roblox.com Creator Store),
	search the text in `Search`, preview, then paste "rbxassetid://<number>".
	Only use audio you own or that is marked free / Roblox-licensed.

	Kind:
	  "Loop2D"     - looped, non-positional bed for a zone (Terminal / Train)
	  "Random2D"   - one-shot, played at random intervals while in a zone
	  "Emitter"    - looped or random, positional; plays from world attachments
	                 tagged "SoundEmitter" whose SoundKey attribute matches
	  "OneShot"    - played on demand (UI, cabin feedback, countdown)
]]

local AudioConfig = {
	-- Default volumes for the three SoundGroups. Player settings scale these.
	Groups = {
		Ambience = 0.7,
		Effects = 0.8,
		Interface = 0.6,
	},

	Sounds = {
		-- TERMINAL AMBIENCE ------------------------------------------------
		TerminalRoomTone = { Id = "", Kind = "Loop2D", Zone = "Terminal", Group = "Ambience", Volume = 0.22, Search = "large hall room tone / station interior ambience" },
		TerminalWind = { Id = "", Kind = "Loop2D", Zone = "Terminal", Group = "Ambience", Volume = 0.16, Search = "distant wind exterior soft" },
		DistantMetal = { Id = "", Kind = "Random2D", Zone = "Terminal", Group = "Ambience", Volume = 0.18, Interval = { 25, 60 }, Search = "distant metal clank railway yard" },
		ClockTick = { Id = "", Kind = "Emitter", Looped = true, Group = "Ambience", Volume = 0.35, MaxDistance = 70, Search = "old clock ticking loop" },
		ClockMechanism = { Id = "", Kind = "OneShot", Group = "Effects", Volume = 0.4, Search = "clock mechanism clunk" },
		CabinHum = { Id = "", Kind = "Emitter", Looped = true, Group = "Ambience", Volume = 0.25, MaxDistance = 28, Search = "machinery hum soft / mechanical idle" },

		-- CABIN FEEDBACK ---------------------------------------------------
		CabinJoin = { Id = "", Kind = "OneShot", Group = "Effects", Volume = 0.5, Search = "mechanical switch click soft / relay latch" },
		CountdownTick = { Id = "", Kind = "OneShot", Group = "Effects", Volume = 0.45, Search = "mechanical signal tick / bell ding small" },
		DoorClose = { Id = "", Kind = "OneShot", Group = "Effects", Volume = 0.5, Search = "sliding metal door close" },
		Departure = { Id = "", Kind = "OneShot", Group = "Effects", Volume = 0.55, Search = "steam train whistle distant" },

		-- TRAIN AMBIENCE ---------------------------------------------------
		TrainRumble = { Id = "", Kind = "Loop2D", Zone = "Train", Group = "Ambience", Volume = 0.3, Search = "train interior rumble loop" },
		TrackClatter = { Id = "", Kind = "Loop2D", Zone = "Train", Group = "Ambience", Volume = 0.22, Search = "train wheels on tracks clickety loop" },
		WindowWind = { Id = "", Kind = "Loop2D", Zone = "Train", Group = "Ambience", Volume = 0.12, Search = "wind against window soft" },
		CarriageCreak = { Id = "", Kind = "Random2D", Zone = "Train", Group = "Ambience", Volume = 0.2, Interval = { 14, 35 }, Search = "wood creak train carriage" },
		TrainHorn = { Id = "", Kind = "Random2D", Zone = "Train", Group = "Ambience", Volume = 0.3, Interval = { 120, 240 }, Search = "distant steam train horn" },
		EngineIdle = { Id = "", Kind = "Emitter", Looped = true, Group = "Ambience", Volume = 0.4, MaxDistance = 90, Search = "steam engine idle chuff loop" },
		SteamRelease = { Id = "", Kind = "Emitter", Looped = false, Interval = { 18, 40 }, Group = "Ambience", Volume = 0.35, MaxDistance = 90, Search = "steam release hiss" },
		LockedDoor = { Id = "", Kind = "OneShot", Group = "Effects", Volume = 0.45, Search = "heavy locked door rattle" },

		-- INTERFACE --------------------------------------------------------
		UIClick = { Id = "", Kind = "OneShot", Group = "Interface", Volume = 0.4, Search = "ui click soft" },
		UIConfirm = { Id = "", Kind = "OneShot", Group = "Interface", Volume = 0.45, Search = "ui confirm soft" },
		UICancel = { Id = "", Kind = "OneShot", Group = "Interface", Volume = 0.4, Search = "ui cancel soft" },
	},
}

return AudioConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">CabinDefinitions</string><ProtectedString name="Source"><![CDATA[--[[
	CabinDefinitions
	The four expedition boarding cabins. The world builder reads the layout
	numbers, the ExpeditionService reads Id / Capacity / DisplayName.

	Order matters: cabins are placed left-to-right along the lower platform.
]]

local CabinDefinitions = {
	{
		Id = "Solo",
		DisplayName = "SOLO EXPEDITION",
		Capacity = 1,
		-- Interior footprint (studs): small and private.
		Width = 9,
		Depth = 9,
		Height = 11,
		DoorWidth = 4.5,
		Style = "Solo",
	},
	{
		Id = "Duo",
		DisplayName = "DUO EXPEDITION",
		Capacity = 2,
		Width = 12,
		Depth = 10,
		Height = 12,
		DoorWidth = 5.5,
		Style = "Duo",
	},
	{
		Id = "Squad",
		DisplayName = "SQUAD EXPEDITION",
		Capacity = 3,
		Width = 15,
		Depth = 11,
		Height = 13,
		DoorWidth = 6.5,
		Style = "Squad",
	},
	{
		Id = "Crew",
		DisplayName = "CREW EXPEDITION",
		Capacity = 4,
		Width = 19,
		Depth = 13,
		Height = 15,
		DoorWidth = 8,
		Style = "Crew",
	},
}

function CabinDefinitions.Get(id)
	for _, def in ipairs(CabinDefinitions) do
		if def.Id == id then
			return def
		end
	end
	return nil
end

function CabinDefinitions.CapacityLabel(capacity)
	if capacity == 1 then
		return "1 EXPLORER"
	end
	return tostring(capacity) .. " EXPLORERS"
end

return CabinDefinitions
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">DialogueData</string><ProtectedString name="Source"><![CDATA[--[[
	DialogueData
	Short, expandable dialogue. A ProximityPrompt with the attribute
	DialogueId = "<key>" opens the matching entry on the client.

	First = lines for the first conversation in a session.
	Repeat = lines for every later conversation (optional).
	Keep lines short: this is a world, not a novel.
]]

local DialogueData = {
	StationKeeper = {
		Speaker = "THE STATION KEEPER",
		First = {
			"First expedition?",
			"The cabins are ready.",
			"Choose your crew carefully.",
		},
		Repeat = {
			"The lower platform. Pick a cabin and step inside.",
			"And never mind the clock. It keeps its own time.",
		},
	},

	Conductor = {
		Speaker = "THE CONDUCTOR",
		First = {
			"All aboard.",
			"The route reveals itself to those who travel it.",
		},
		Repeat = {
			"We are making good time.",
		},
	},

	-- Inspect prompts reuse the same dialogue UI without a speaker portrait.
	MysteryDoor = {
		Speaker = "",
		First = {
			"The door is sealed.",
			"There is no keyhole. Only the emblem.",
		},
	},
}

return DialogueData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">GameConfig</string><ProtectedString name="Source"><![CDATA[--[[
	GameConfig
	Game-wide tuning values. Everything a designer is likely to tweak lives here
	so that systems never hard-code numbers.

	NOTE: shared/config modules are written in the Lua 5.1 subset of Luau so the
	offline test harness (tools/) can load them. Keep it that way.
]]

local GameConfig = {
	GameName = "THE LAST TRAIN",

	Expedition = {
		MinSize = 1, -- an expedition may depart with a single explorer
		MaxSize = 4,
		CountdownSeconds = 5, -- Duo / Squad / Crew
		SoloCountdownSeconds = 3, -- Solo departs a little faster
		ZoneCheckInterval = 0.2, -- seconds between server checks of who is standing in a cabin
		LeaveGraceSeconds = 0.6, -- stepping out for less than this does not drop you
		RejoinCooldownSeconds = 1.5, -- after leaving, ignore the cabin briefly
		ReopenDelaySeconds = 2.5, -- doors stay shut this long after a departure
	},

	Transition = {
		FadeOutTime = 0.8,
		HoldTime = 1.4, -- time spent on black while the group is moved
		FadeInTime = 1.0,
	},

	Train = {
		-- Scenery that scrolls past the windows (client only, only while aboard).
		ScenerySpeedNear = 44, -- studs / second
		ScenerySpeedMid = 16,
		SceneryWrapLength = 1400,
		HornIntervalMin = 120,
		HornIntervalMax = 240,
	},

	Camera = {
		TerminalMaxZoom = 26,
		TrainMaxZoom = 14, -- tighter inside carriages to avoid wall clipping
	},

	Clock = {
		StutterChance = 0.04, -- per second, the clock's second hand slips back one tick
	},

	Hints = {
		IntroHintDelay = 2.5,
		IntroHintText = "Choose an Expedition Cabin to begin.",
	},
}

return GameConfig
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">LightingPresets</string><ProtectedString name="Source"><![CDATA[--[[
	LightingPresets
	The server applies "Terminal" at startup. The client's ZoneController
	blends to "Train" while the local player is aboard and back again.

	Design intent: warm practical lamps inside, a cool and uncertain world
	outside. Bloom is deliberately low; nothing should glare.
]]

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local LightingPresets = {
	Terminal = {
		Lighting = {
			ClockTime = 18.85, -- late dusk: blue sky, last light on the horizon
			Brightness = 1.6,
			Ambient = rgb(74, 66, 62),
			OutdoorAmbient = rgb(104, 116, 138),
			ColorShift_Top = rgb(48, 52, 70),
			ColorShift_Bottom = rgb(0, 0, 0),
			EnvironmentDiffuseScale = 0.35,
			EnvironmentSpecularScale = 0.4,
			ExposureCompensation = 0.15,
		},
		Atmosphere = {
			Density = 0.32,
			Offset = 0.15,
			Color = rgb(156, 170, 192),
			Decay = rgb(92, 104, 128),
			Glare = 0,
			Haze = 1.6,
		},
		Bloom = { Intensity = 0.35, Size = 22, Threshold = 1.35 },
		ColorCorrection = { Brightness = 0.02, Contrast = 0.07, Saturation = -0.06, TintColor = rgb(255, 247, 238) },
	},

	Train = {
		Lighting = {
			ClockTime = 20.4, -- night has fallen once the train is under way
			Brightness = 1.2,
			Ambient = rgb(70, 62, 60),
			OutdoorAmbient = rgb(78, 90, 116),
			ColorShift_Top = rgb(30, 36, 56),
			ColorShift_Bottom = rgb(0, 0, 0),
			EnvironmentDiffuseScale = 0.3,
			EnvironmentSpecularScale = 0.35,
			ExposureCompensation = 0.2,
		},
		Atmosphere = {
			Density = 0.4,
			Offset = 0.2,
			Color = rgb(122, 140, 170),
			Decay = rgb(62, 74, 100),
			Glare = 0,
			Haze = 2.2,
		},
		Bloom = { Intensity = 0.32, Size = 22, Threshold = 1.35 },
		ColorCorrection = { Brightness = 0.03, Contrast = 0.06, Saturation = -0.08, TintColor = rgb(255, 246, 236) },
	},
}

return LightingPresets
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000000E"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Emblem</string><ProtectedString name="Source"><![CDATA[--[[
	Emblem
	The train's original symbol, drawn with plain GUI frames so it needs no
	uploaded image: a double ring around a railway track that converges on a
	single diamond — a destination nobody has reached.

	Works inside SurfaceGuis (signs, locomotive, doors) and ScreenGuis (HUD).

	Emblem.Create(parent, {
		Size = UDim2, Position = UDim2, AnchorPoint = Vector2,
		Color = Color3, Thickness = number (ring stroke in pixels), ZIndex = number,
	})
]]

local Emblem = {}

local function bar(parent, name, color, size, position, rotation, zIndex)
	local f = Instance.new("Frame")
	f.Name = name
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Size = size
	f.Position = position
	f.Rotation = rotation or 0
	f.ZIndex = zIndex
	f.Parent = parent
	return f
end

local function ring(parent, name, color, scale, thickness, zIndex)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.new(0.5, 0, 0.5, 0)
	f.Size = UDim2.new(scale, 0, scale, 0)
	f.ZIndex = zIndex
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = f
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.Parent = f
	f.Parent = parent
	return f
end

function Emblem.Create(parent, props)
	props = props or {}
	local color = props.Color or Color3.fromRGB(176, 140, 82)
	local thickness = props.Thickness or 3
	local z = props.ZIndex or 1

	local root = Instance.new("Frame")
	root.Name = "Emblem"
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.Size = props.Size or UDim2.new(1, 0, 1, 0)
	root.Position = props.Position or UDim2.new(0.5, 0, 0.5, 0)
	root.AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5)
	root.ZIndex = z

	ring(root, "OuterRing", color, 0.96, thickness, z)
	ring(root, "InnerRing", color, 0.8, math.max(1, thickness * 0.5), z)

	-- Two rails converging toward the horizon.
	bar(root, "RailLeft", color, UDim2.new(0.035, 0, 0.5, 0), UDim2.new(0.41, 0, 0.56, 0), 11, z)
	bar(root, "RailRight", color, UDim2.new(0.035, 0, 0.5, 0), UDim2.new(0.59, 0, 0.56, 0), -11, z)

	-- Sleepers shrink with distance.
	bar(root, "Sleeper1", color, UDim2.new(0.38, 0, 0.032, 0), UDim2.new(0.5, 0, 0.74, 0), 0, z)
	bar(root, "Sleeper2", color, UDim2.new(0.28, 0, 0.028, 0), UDim2.new(0.5, 0, 0.6, 0), 0, z)
	bar(root, "Sleeper3", color, UDim2.new(0.19, 0, 0.024, 0), UDim2.new(0.5, 0, 0.48, 0), 0, z)

	-- The destination.
	bar(root, "Destination", color, UDim2.new(0.11, 0, 0.11, 0), UDim2.new(0.5, 0, 0.29, 0), 45, z)

	root.Parent = parent
	return root
end

return Emblem
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">ExpeditionGroup</string><ProtectedString name="Source"><![CDATA[--[[
	ExpeditionGroup
	Pure membership state for one expedition cabin. No Roblox APIs are used,
	so it can be unit tested offline (tools/tests/test_expedition_group.lua).

	Rules:
	  * members are kept in join order
	  * the first member is the leader; when the leader leaves, the next
	    member in join order becomes leader
	  * a locked group accepts nobody (departure in progress)
	  * capacity is never exceeded
]]

local ExpeditionGroup = {}
ExpeditionGroup.__index = ExpeditionGroup

function ExpeditionGroup.new(id, capacity, minSize)
	assert(type(capacity) == "number" and capacity >= 1, "capacity must be >= 1")
	local self = setmetatable({}, ExpeditionGroup)
	self.Id = id
	self.Capacity = capacity
	self.MinSize = minSize or 1
	self._members = {}
	self._locked = false
	return self
end

function ExpeditionGroup:Count()
	return #self._members
end

function ExpeditionGroup:IsFull()
	return #self._members >= self.Capacity
end

function ExpeditionGroup:IsLocked()
	return self._locked
end

function ExpeditionGroup:Lock()
	self._locked = true
end

function ExpeditionGroup:Unlock()
	self._locked = false
end

function ExpeditionGroup:IsMember(player)
	for _, member in ipairs(self._members) do
		if member == player then
			return true
		end
	end
	return false
end

function ExpeditionGroup:GetLeader()
	return self._members[1]
end

function ExpeditionGroup:IsLeader(player)
	return player ~= nil and self._members[1] == player
end

-- Returns a copy so callers can iterate safely while the group changes.
function ExpeditionGroup:GetMembers()
	local copy = {}
	for i, member in ipairs(self._members) do
		copy[i] = member
	end
	return copy
end

function ExpeditionGroup:CanJoin(player)
	if player == nil then
		return false, "Invalid"
	end
	if self:IsMember(player) then
		return false, "AlreadyMember"
	end
	if self._locked then
		return false, "Locked"
	end
	if self:IsFull() then
		return false, "Full"
	end
	return true, nil
end

function ExpeditionGroup:Add(player)
	local ok, reason = self:CanJoin(player)
	if not ok then
		return false, reason
	end
	table.insert(self._members, player)
	return true, nil
end

-- Returns: removed (bool), leaderChanged (bool)
function ExpeditionGroup:Remove(player)
	for i, member in ipairs(self._members) do
		if member == player then
			table.remove(self._members, i)
			return true, i == 1 and #self._members > 0
		end
	end
	return false, false
end

function ExpeditionGroup:CanStart(player)
	if self._locked then
		return false, "Locked"
	end
	if not self:IsLeader(player) then
		return false, "NotLeader"
	end
	if #self._members < self.MinSize then
		return false, "NotEnough"
	end
	return true, nil
end

function ExpeditionGroup:Reset()
	self._members = {}
	self._locked = false
end

return ExpeditionGroup
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--[[
	Remotes
	Single source of truth for networking. The server creates every
	RemoteEvent under ReplicatedStorage.Shared.Remotes on first use; clients
	wait for them.

	Client -> Server
	  ExpeditionRequest(action: "Start" | "Leave")
	  TrainRequest(action: "ReturnToTerminal")

	Server -> Client
	  ExpeditionState(view | nil)     -- the card for the cabin you are in
	  Notice(text, kind)              -- short toast ("This cabin is full")
	  Transition(phase, title, sub)   -- "Out" fades to black, "In" fades back
	  TrainState(view | nil)          -- crew HUD while aboard
	  CabinFeedback(cabinId, kind)    -- "Joined" / "Tick" / "Depart" sounds
]]

local RunService = game:GetService("RunService")

local NAMES = {
	"ExpeditionRequest",
	"TrainRequest",
	"ExpeditionState",
	"Notice",
	"Transition",
	"TrainState",
	"CabinFeedback",
}

local Remotes = {}

local folder = nil

local function getFolder()
	if folder then
		return folder
	end
	local shared = script.Parent.Parent
	if RunService:IsServer() then
		folder = shared:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = shared
		end
		for _, name in ipairs(NAMES) do
			if not folder:FindFirstChild(name) then
				local remote = Instance.new("RemoteEvent")
				remote.Name = name
				remote.Parent = folder
			end
		end
	else
		folder = shared:WaitForChild("Remotes")
	end
	return folder
end

function Remotes.Get(name)
	local f = getFolder()
	if RunService:IsServer() then
		local remote = f:FindFirstChild(name)
		assert(remote, "Unknown remote " .. tostring(name))
		return remote
	end
	return f:WaitForChild(name)
end

return Remotes
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">UITheme</string><ProtectedString name="Source"><![CDATA[--[[
	UITheme
	Visual language shared by screen UI and in-world signage.
	Deep charcoal surfaces, warm lamp-amber accents, aged brass strokes.
]]

local UITheme = {
	Colors = {
		Background = Color3.fromRGB(17, 16, 15),
		Panel = Color3.fromRGB(24, 22, 20),
		PanelRaised = Color3.fromRGB(36, 33, 29),
		Stroke = Color3.fromRGB(122, 98, 66),
		StrokeSoft = Color3.fromRGB(64, 57, 48),
		Accent = Color3.fromRGB(226, 168, 96), -- old train lamp
		AccentDeep = Color3.fromRGB(150, 104, 52),
		AccentText = Color3.fromRGB(28, 20, 12),
		Text = Color3.fromRGB(238, 228, 210),
		TextMuted = Color3.fromRGB(166, 154, 136),
		TextFaint = Color3.fromRGB(112, 104, 94),
		Danger = Color3.fromRGB(186, 92, 76),
		Proceed = Color3.fromRGB(128, 168, 112),
		Brass = Color3.fromRGB(176, 140, 82),
		Parchment = Color3.fromRGB(226, 212, 182),
		Ink = Color3.fromRGB(42, 34, 26),
	},

	Fonts = {
		Title = Enum.Font.Merriweather, -- serif, used sparingly for names / numerals
		Label = Enum.Font.Oswald, -- condensed railway signage, small caps labels
		Body = Enum.Font.GothamMedium,
		BodyBold = Enum.Font.GothamBold,
	},

	PanelTransparency = 0.06,
	StrokeTransparency = 0.45,
	CornerRadius = 8,
	ButtonHeight = 46, -- 37px on the smallest phones after scaling: still tappable
}

return UITheme
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000023"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000011"><Properties><string name="Name">ServerMain</string><ProtectedString name="Source"><![CDATA[--[[
	ServerMain — the only server Script. Everything else is a ModuleScript.

	Order matters:
	  1. Stop automatic spawning (nobody lands in an unbuilt world).
	  2. Build the world (or detect a baked one).
	  3. Start services. 4. Load characters.
]]

local Players = game:GetService("Players")
local ServerScriptService = game:GetService("ServerScriptService")

Players.CharacterAutoLoads = false

local WorldBuilder = require(ServerScriptService.World.WorldBuilder)
local report = WorldBuilder.Build()
if #report.Errors > 0 then
	warn("[ServerMain] World built with " .. #report.Errors .. " error(s); see warnings above.")
end

local Services = ServerScriptService.Services
local TrainService = require(Services.TrainService)
local ExpeditionService = require(Services.ExpeditionService)
local PlayerService = require(Services.PlayerService)

TrainService.Init()
ExpeditionService.Init({ TrainService = TrainService })
PlayerService.Init()
ExpeditionService.Start()
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000015"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">ExpeditionService</string><ProtectedString name="Source"><![CDATA[--[[
	ExpeditionService (server authority)
	Physical expedition cabins: walk in to join, walk out (or press Leave) to
	leave, first explorer leads, leader starts, countdown, departure.

	Design notes
	  * Membership is decided ONLY here. Clients can send just two requests:
	    "Start" and "Leave"; both are validated against server state.
	  * Who stands in which cabin is checked on a fixed interval (default 5x per
	    second) with a cheap point-in-box test. This is more reliable than
	    Touched/TouchEnded, needs no physics queries and has one loop total.
	  * A player can belong to at most one cabin (playerCabin map) and is
	    ignored entirely while aboard the train.
	  * Countdowns are timestamps checked by the same loop: no extra threads,
	    nothing to cancel — resetting a cabin simply clears its timestamp.
	  * Poll(now) is public so the offline tests can drive time precisely.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local CabinDefinitions = require(Shared.Config.CabinDefinitions)
local ExpeditionGroup = require(Shared.Modules.ExpeditionGroup)
local Remotes = require(Shared.Modules.Remotes)

local CFG = GameConfig.Expedition

local ExpeditionService = {}
ExpeditionService.Clock = os.clock

local cabins = {} -- array of cabin records
local playerCabin = {} -- [Player] = cabin record
local cooldownUntil = {} -- [Player] = time before which joining is ignored
local outsideSince = {} -- [Player] = time first seen outside own cabin
local lastNotice = {} -- [Player] = { cabin = record, at = time }
local lastRequest = {} -- [Player] = time of last accepted remote request
local remotes = {}
local trainService = nil

local NOTICE_TEXT = {
	Full = "This cabin is full.",
	Locked = "This expedition is departing.",
}

-- HELPERS -------------------------------------------------------------------------
local function rootOf(player)
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health <= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart")
end

local function insideZone(zone, position)
	local rel = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

local function displayName(player)
	return player and (player.DisplayName or player.Name) or ""
end

local function writeAttributes(cabin)
	local model = cabin.Model
	model:SetAttribute("State", cabin.State)
	model:SetAttribute("Count", cabin.Group:Count())
	local leader = cabin.Group:GetLeader()
	model:SetAttribute("LeaderName", displayName(leader))
	model:SetAttribute("LeaderUserId", leader and leader.UserId or 0)
	model:SetAttribute("Countdown", cabin.Countdown)
end

local function viewFor(cabin, player)
	local leader = cabin.Group:GetLeader()
	return {
		CabinId = cabin.Id,
		Title = cabin.Def.DisplayName,
		Capacity = cabin.Def.Capacity,
		Count = cabin.Group:Count(),
		LeaderName = displayName(leader),
		IsLeader = leader == player,
		State = cabin.State,
		Countdown = cabin.Countdown,
	}
end

local function broadcast(cabin)
	writeAttributes(cabin)
	for _, member in ipairs(cabin.Group:GetMembers()) do
		remotes.ExpeditionState:FireClient(member, viewFor(cabin, member))
	end
end

local function feedback(cabin, kind)
	for _, member in ipairs(cabin.Group:GetMembers()) do
		remotes.CabinFeedback:FireClient(member, cabin.Id, kind)
	end
end

local function noticeOnce(player, cabin, reason, now)
	local last = lastNotice[player]
	if last and last.cabin == cabin and now - last.at < 4 then
		return
	end
	lastNotice[player] = { cabin = cabin, at = now }
	local text = NOTICE_TEXT[reason]
	if text then
		remotes.Notice:FireClient(player, text, "Info")
	end
end

local function resetCabin(cabin)
	cabin.Group:Reset()
	cabin.State = "Idle"
	cabin.DepartAt = nil
	cabin.Countdown = 0
	writeAttributes(cabin)
end

local function teleportOut(player, cabin)
	local character = player.Character
	if character and cabin.Exit then
		character:PivotTo(cabin.Exit.CFrame + Vector3.new(0, 3, 0))
	end
end

-- MEMBERSHIP ------------------------------------------------------------------------
local function join(player, cabin)
	local ok, reason = cabin.Group:Add(player)
	if not ok then
		return false, reason
	end
	playerCabin[player] = cabin
	outsideSince[player] = nil
	if cabin.State == "Idle" then
		cabin.State = "Boarding"
	end
	cabin.Model:SetAttribute("Pulse", (cabin.Model:GetAttribute("Pulse") or 0) + 1)
	remotes.CabinFeedback:FireClient(player, cabin.Id, "Joined")
	broadcast(cabin)
	return true
end

-- reason: "Manual" | "WalkedOut" | "Disconnected"
local function leave(player, reason, now)
	local cabin = playerCabin[player]
	if not cabin then
		return false
	end
	local _, leaderChanged = cabin.Group:Remove(player)
	playerCabin[player] = nil
	outsideSince[player] = nil
	if reason ~= "Disconnected" then
		remotes.ExpeditionState:FireClient(player, nil)
	end
	if cabin.Group:Count() == 0 then
		resetCabin(cabin) -- also cancels a running countdown
	else
		broadcast(cabin)
		if leaderChanged then
			remotes.Notice:FireClient(cabin.Group:GetLeader(), "You now lead this expedition.", "Info")
		end
	end
	if reason == "Manual" then
		cooldownUntil[player] = now + CFG.RejoinCooldownSeconds
		teleportOut(player, cabin)
	end
	return true
end

local function startExpedition(player, now)
	local cabin = playerCabin[player]
	if not cabin or cabin.State ~= "Boarding" then
		return false, "NotBoarding"
	end
	local ok, reason = cabin.Group:CanStart(player)
	if not ok then
		if reason == "NotLeader" then
			remotes.Notice:FireClient(player, "Only the expedition leader can start.", "Info")
		end
		return false, reason
	end
	cabin.Group:Lock()
	cabin.State = "Departing"
	local seconds = cabin.Def.Capacity == 1 and CFG.SoloCountdownSeconds or CFG.CountdownSeconds
	cabin.DepartAt = now + seconds
	cabin.Countdown = seconds
	feedback(cabin, "CountdownStart")
	broadcast(cabin)
	return true
end

local function depart(cabin, now)
	local members = cabin.Group:GetMembers()
	for _, member in ipairs(members) do
		playerCabin[member] = nil
		outsideSince[member] = nil
		remotes.CabinFeedback:FireClient(member, cabin.Id, "Depart")
		remotes.ExpeditionState:FireClient(member, nil)
	end
	local info = { CabinId = cabin.Id, Title = cabin.Def.DisplayName, Capacity = cabin.Def.Capacity }
	cabin.Group:Reset()
	cabin.State = "Departed" -- doors stay shut briefly, nobody can join
	cabin.DepartAt = nil
	cabin.Countdown = 0
	cabin.ReopenAt = now + CFG.ReopenDelaySeconds
	writeAttributes(cabin)
	if trainService then
		trainService.BoardExpedition(members, info)
	end
end

-- THE LOOP ---------------------------------------------------------------------------
function ExpeditionService.Poll(now)
	for _, player in ipairs(Players:GetPlayers()) do
		if not (trainService and trainService.IsAboard(player)) then
			local root = rootOf(player)
			local inCabin = nil
			if root then
				for _, cabin in ipairs(cabins) do
					if cabin.Zone and insideZone(cabin.Zone, root.Position) then
						inCabin = cabin
						break
					end
				end
			end
			local current = playerCabin[player]
			if current then
				if inCabin == current then
					outsideSince[player] = nil
				else
					outsideSince[player] = outsideSince[player] or now
					if now - outsideSince[player] >= CFG.LeaveGraceSeconds then
						leave(player, "WalkedOut", now)
					end
				end
			elseif inCabin and now >= (cooldownUntil[player] or 0) then
				if inCabin.State == "Idle" or inCabin.State == "Boarding" then
					local ok, reason = join(player, inCabin)
					if not ok then
						noticeOnce(player, inCabin, reason, now)
					end
				else
					noticeOnce(player, inCabin, "Locked", now)
				end
			end
		end
	end

	for _, cabin in ipairs(cabins) do
		if cabin.State == "Departing" and cabin.DepartAt then
			local remaining = math.max(0, math.ceil(cabin.DepartAt - now - 1e-6))
			if remaining ~= cabin.Countdown then
				cabin.Countdown = remaining
				if remaining > 0 then
					feedback(cabin, "Tick")
				end
				broadcast(cabin)
			end
			if now >= cabin.DepartAt then
				depart(cabin, now)
			end
		elseif cabin.State == "Departed" and now >= (cabin.ReopenAt or 0) then
			cabin.State = "Idle"
			writeAttributes(cabin)
		end
	end
end

-- PUBLIC -----------------------------------------------------------------------------
function ExpeditionService.GetCabinOf(player)
	local cabin = playerCabin[player]
	return cabin and cabin.Id or nil
end

function ExpeditionService.GetCabinState(cabinId)
	for _, cabin in ipairs(cabins) do
		if cabin.Id == cabinId then
			return cabin.State, cabin.Group:GetMembers(), cabin.Group:GetLeader()
		end
	end
	return nil
end

-- Exposed for tests and future systems (e.g. a menu "leave" button).
function ExpeditionService.HandleRequest(player, action)
	if type(action) ~= "string" then
		return false
	end
	local now = ExpeditionService.Clock()
	if lastRequest[player] and now - lastRequest[player] < 0.25 then
		return false -- simple spam guard
	end
	lastRequest[player] = now
	if action == "Start" then
		return startExpedition(player, now)
	elseif action == "Leave" then
		return leave(player, "Manual", now)
	end
	return false
end

function ExpeditionService.Init(deps)
	trainService = deps and deps.TrainService
	for _, name in ipairs({ "ExpeditionRequest", "ExpeditionState", "Notice", "CabinFeedback" }) do
		remotes[name] = Remotes.Get(name)
	end
	local folder = workspace:WaitForChild("ExpeditionCabins")
	for _, def in ipairs(CabinDefinitions) do
		local model = folder:FindFirstChild(def.Id)
		if model then
			local cabin = {
				Id = def.Id,
				Def = def,
				Model = model,
				Zone = model:FindFirstChild("Zone"),
				Exit = model:FindFirstChild("ExitPoint"),
				Group = ExpeditionGroup.new(def.Id, def.Capacity, CFG.MinSize),
				State = "Idle",
				Countdown = 0,
			}
			if not cabin.Zone then
				warn("[ExpeditionService] Cabin " .. def.Id .. " has no Zone part")
			end
			table.insert(cabins, cabin)
			writeAttributes(cabin)
		else
			warn("[ExpeditionService] Missing cabin model " .. def.Id)
		end
	end

	remotes.ExpeditionRequest.OnServerEvent:Connect(function(player, action)
		ExpeditionService.HandleRequest(player, action)
	end)
	Players.PlayerRemoving:Connect(function(player)
		leave(player, "Disconnected", ExpeditionService.Clock())
		cooldownUntil[player] = nil
		outsideSince[player] = nil
		lastNotice[player] = nil
		lastRequest[player] = nil
	end)
end

function ExpeditionService.Start()
	task.spawn(function()
		while true do
			task.wait(CFG.ZoneCheckInterval)
			local ok, err = pcall(ExpeditionService.Poll, ExpeditionService.Clock())
			if not ok then
				warn("[ExpeditionService] Poll error: " .. tostring(err))
			end
		end
	end)
end

return ExpeditionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">PlayerService</string><ProtectedString name="Source"><![CDATA[--[[
	PlayerService
	Characters are loaded manually (Players.CharacterAutoLoads = false) so no
	one can spawn before the world exists. Handles respawning after death.
]]

local Players = game:GetService("Players")

local PlayerService = {}

local function setup(player)
	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid then
			humanoid.Died:Connect(function()
				task.delay(Players.RespawnTime, function()
					if player.Parent then
						player:LoadCharacter()
					end
				end)
			end)
		end
	end)
	player:LoadCharacter()
end

function PlayerService.Init()
	Players.CharacterAutoLoads = false
	Players.PlayerAdded:Connect(function(player)
		setup(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		if not player.Character then
			task.spawn(setup, player)
		end
	end
end

return PlayerService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">TrainService</string><ProtectedString name="Source"><![CDATA[--[[
	TrainService (server authority)
	Receives departed expedition groups from ExpeditionService and moves them
	aboard THE LAST TRAIN (Workspace.ExpeditionTrain), keeping membership.

	Flow:  BoardExpedition(members) -> Transition "Out" (client fades to black)
	       -> after the fade, each member is placed on a free spawn point in
	       the Boarding Carriage -> Transition "In" -> crew HUD (TrainState).

	PHASE 2 LIMITATION (documented on purpose):
	  There is ONE physical train per server. If two expeditions depart in
	  the same server, both groups ride the same train. Each group keeps its
	  own membership, HUD count and leader-less crew record, and nothing one
	  group does changes the other group's state. Per-group train instances
	  (or reserved servers) are the planned next step.

	Leaving the train (development path): the Boarding Carriage's exit door
	prompt, or MENU > Return to Terminal.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Remotes = require(Shared.Modules.Remotes)

local TRANSITION = GameConfig.Transition
local MIN_SPAWN_GAP = 2.6

local TrainService = {}

local expeditions = {} -- [id] = { Id, Title, Capacity, CabinId, Members = { Player } }
local playerExpedition = {} -- [Player] = expedition record
local nextId = 0
local spawnPoints = {}
local returnPoint = nil
local remotes = {}

local function rootOf(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function crewView(rec)
	return {
		Title = rec.Title,
		CrewCount = #rec.Members,
		CrewMax = rec.Capacity,
		Status = "PREPARING ROUTE",
	}
end

local function sendCrew(rec)
	for _, member in ipairs(rec.Members) do
		remotes.TrainState:FireClient(member, crewView(rec))
	end
end

local function removeMember(player)
	local rec = playerExpedition[player]
	if not rec then
		return nil
	end
	playerExpedition[player] = nil
	for i, member in ipairs(rec.Members) do
		if member == player then
			table.remove(rec.Members, i)
			break
		end
	end
	if #rec.Members == 0 then
		expeditions[rec.Id] = nil
	else
		sendCrew(rec)
	end
	return rec
end

-- Choose the first spawn point no other character is standing on.
local function pickSpawn(reserved)
	local occupied = {}
	for _, pos in ipairs(reserved) do
		table.insert(occupied, pos)
	end
	for _, other in ipairs(Players:GetPlayers()) do
		local root = rootOf(other)
		if root then
			table.insert(occupied, root.Position)
		end
	end
	for _, spawn in ipairs(spawnPoints) do
		local free = true
		for _, pos in ipairs(occupied) do
			local flat = Vector3.new(pos.X - spawn.Position.X, 0, pos.Z - spawn.Position.Z)
			if flat.Magnitude < MIN_SPAWN_GAP and math.abs(pos.Y - spawn.Position.Y) < 6 then
				free = false
				break
			end
		end
		if free then
			return spawn.CFrame
		end
	end
	-- Every point taken (more than 8 riders): stagger along the aisle.
	local n = #reserved
	return spawnPoints[1].CFrame * CFrame.new(((n % 3) - 1) * 2.4, 0, 3 + math.floor(n / 3) * 2.4)
end

local function placeAboard(player, reserved)
	local character = player.Character
	local root = rootOf(player)
	if not (character and root) then
		return false
	end
	local cf = pickSpawn(reserved)
	character:PivotTo(cf + Vector3.new(0, 3, 0))
	root.AssemblyLinearVelocity = Vector3.zero
	table.insert(reserved, cf.Position)
	return true
end

function TrainService.IsAboard(player)
	return playerExpedition[player] ~= nil
end

function TrainService.GetExpedition(player)
	return playerExpedition[player]
end

function TrainService.BoardExpedition(members, info)
	nextId = nextId + 1
	local rec = { Id = nextId, Title = info.Title, Capacity = info.Capacity, CabinId = info.CabinId, Members = {} }
	for _, player in ipairs(members) do
		if player.Parent then
			table.insert(rec.Members, player)
			playerExpedition[player] = rec
		end
	end
	if #rec.Members == 0 then
		return nil
	end
	expeditions[rec.Id] = rec
	for _, player in ipairs(rec.Members) do
		remotes.Transition:FireClient(player, "Out", "ALL ABOARD", info.Title)
	end
	task.delay(TRANSITION.FadeOutTime + TRANSITION.HoldTime * 0.5, function()
		local reserved = {}
		for _, player in ipairs(rec.Members) do
			placeAboard(player, reserved)
		end
		task.delay(TRANSITION.HoldTime * 0.5, function()
			for _, player in ipairs(rec.Members) do
				remotes.Transition:FireClient(player, "In", "THE LAST TRAIN", "BOARDING CARRIAGE")
			end
			sendCrew(rec)
		end)
	end)
	return rec
end

function TrainService.ReturnToTerminal(player)
	if not removeMember(player) then
		return false
	end
	remotes.Transition:FireClient(player, "Out", "THE TERMINAL", "")
	task.delay(TRANSITION.FadeOutTime + TRANSITION.HoldTime * 0.5, function()
		if not player.Parent then
			return
		end
		local character = player.Character
		if character and returnPoint then
			local n = #Players:GetPlayers()
			character:PivotTo(returnPoint.CFrame * CFrame.new(((n % 3) - 1) * 3, 3, 0))
		end
		remotes.TrainState:FireClient(player, nil)
		task.delay(TRANSITION.HoldTime * 0.5, function()
			if player.Parent then
				remotes.Transition:FireClient(player, "In", "EXPEDITION TERMINAL", "")
			end
		end)
	end)
	return true
end

local function hookCharacter(player)
	player.CharacterAdded:Connect(function(character)
		if not playerExpedition[player] then
			return
		end
		-- Respawned while aboard: bring them back to the train, not the lobby.
		task.spawn(function()
			local root = character:WaitForChild("HumanoidRootPart", 10)
			if root and playerExpedition[player] then
				placeAboard(player, {})
				remotes.TrainState:FireClient(player, crewView(playerExpedition[player]))
			end
		end)
	end)
end

function TrainService.Init()
	for _, name in ipairs({ "Transition", "TrainState", "TrainRequest" }) do
		remotes[name] = Remotes.Get(name)
	end
	local zone = workspace:WaitForChild("ExpeditionTrain")
	local train = zone:WaitForChild("TheLastTrain")
	local spawns = train:WaitForChild("BoardingCarriage"):WaitForChild("BoardingSpawns")
	for i = 1, 16 do
		local p = spawns:FindFirstChild("Spawn" .. i)
		if p then
			table.insert(spawnPoints, p)
		end
	end
	assert(#spawnPoints > 0, "TrainService: no boarding spawn points")
	returnPoint = workspace:WaitForChild("Lobby"):WaitForChild("Spawn"):WaitForChild("ReturnPoint")

	for _, door in ipairs(CollectionService:GetTagged("ReturnToTerminal")) do
		local prompt = door:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt.Triggered:Connect(function(player)
				TrainService.ReturnToTerminal(player)
			end)
		end
	end
	remotes.TrainRequest.OnServerEvent:Connect(function(player, action)
		if action == "ReturnToTerminal" then
			TrainService.ReturnToTerminal(player)
		end
	end)

	Players.PlayerAdded:Connect(hookCharacter)
	for _, player in ipairs(Players:GetPlayers()) do
		hookCharacter(player)
	end
	Players.PlayerRemoving:Connect(removeMember)
end

return TrainService
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000022"><Properties><string name="Name">World</string></Properties><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">BuildKit</string><ProtectedString name="Source"><![CDATA[--[[
	BuildKit
	Small, dependable helpers used by every world builder.

	Conventions
	  * Every part is anchored, smooth-surfaced and named.
	  * Positions are given in a local "frame" CFrame so whole structures can be
	    moved or rotated by changing one CFrame.
	  * Only long-standing Enum.Material values are used (no 2022+ materials),
	    so nothing breaks on older Studio builds.
	  * Written in the Lua 5.1 subset of Luau (tools/ runs it offline to
	    generate the browser preview and to catch errors).
]]

local CollectionService = game:GetService("CollectionService")

local Kit = {}

local rad = math.rad

-- PALETTE ---------------------------------------------------------------
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

Kit.C = {
	Charcoal = rgb(38, 40, 44),
	Iron = rgb(48, 50, 54),
	BlueSteel = rgb(54, 63, 74),
	BlueSteelDark = rgb(40, 46, 55),
	Burgundy = rgb(98, 31, 37),
	BurgundyDeep = rgb(72, 23, 29),
	Brass = rgb(164, 129, 74),
	BrassDark = rgb(120, 94, 56),
	WoodDark = rgb(62, 41, 28),
	Wood = rgb(94, 63, 42),
	WoodLight = rgb(132, 95, 62),
	WoodWorn = rgb(112, 84, 60),
	Stone = rgb(116, 108, 97),
	StoneDark = rgb(80, 75, 69),
	StoneLight = rgb(148, 138, 124),
	Floor = rgb(88, 82, 74),
	Plaster = rgb(170, 154, 128),
	Cream = rgb(190, 174, 144),
	Leather = rgb(96, 58, 38),
	FabricRed = rgb(116, 42, 44),
	FabricGreen = rgb(56, 74, 62),
	Canvas = rgb(152, 138, 106),
	Parchment = rgb(224, 208, 174),
	Ink = rgb(46, 36, 28),
	Glass = rgb(150, 172, 186),
	GlassDark = rgb(52, 64, 78),
	BulbWarm = rgb(255, 196, 128),
	BulbOff = rgb(58, 52, 46),
	LightWarm = rgb(255, 176, 104),
	LightCold = rgb(150, 180, 220),
	Ground = rgb(36, 41, 39),
	Silhouette = rgb(30, 36, 42),
	Mountain = rgb(44, 52, 66),
	Foliage = rgb(32, 46, 40),
	Bark = rgb(48, 36, 28),
}

Kit.M = {
	Smooth = Enum.Material.SmoothPlastic,
	Metal = Enum.Material.Metal,
	Corroded = Enum.Material.CorrodedMetal,
	Plate = Enum.Material.DiamondPlate,
	Wood = Enum.Material.Wood,
	Planks = Enum.Material.WoodPlanks,
	Slate = Enum.Material.Slate,
	Concrete = Enum.Material.Concrete,
	Brick = Enum.Material.Brick,
	Cobble = Enum.Material.Cobblestone,
	Granite = Enum.Material.Granite,
	Marble = Enum.Material.Marble,
	Fabric = Enum.Material.Fabric,
	Glass = Enum.Material.Glass,
	Neon = Enum.Material.Neon,
	Pebble = Enum.Material.Pebble,
	Ground = Enum.Material.Ground,
	Rock = Enum.Material.Rock,
	Foil = Enum.Material.Foil,
}

-- DETERMINISTIC RANDOM (same layout every build) ---------------------------
function Kit.rng(seed)
	local state = seed % 2147483647
	if state <= 0 then
		state = state + 2147483646
	end
	return function(lo, hi)
		state = (state * 16807) % 2147483647
		local t = (state - 1) / 2147483646
		if lo == nil then
			return t
		end
		return lo + (hi - lo) * t
	end
end

-- INSTANCES ------------------------------------------------------------------
function Kit.folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Kit.model(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function finish(p, color, material, extra)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = color or Kit.C.Stone
	p.Material = material or Kit.M.Smooth
	if extra then
		for k, v in pairs(extra) do
			p[k] = v
		end
	end
end

-- Generic block. `extra` can set Name, Transparency, CanCollide, CastShadow...
function Kit.part(parent, size, cframe, color, material, extra)
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = cframe
	finish(p, color, material, extra)
	p.Parent = parent
	return p
end

-- Axis-aligned box between two corners, expressed inside `frame`.
function Kit.box(parent, frame, x0, y0, z0, x1, y1, z1, color, material, extra)
	local sx, sy, sz = math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0)
	if sx < 0.01 or sy < 0.01 or sz < 0.01 then
		return nil
	end
	local cf = frame * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2)
	return Kit.part(parent, Vector3.new(sx, sy, sz), cf, color, material, extra)
end

function Kit.wedge(parent, size, cframe, color, material, extra)
	local p = Instance.new("WedgePart")
	p.Size = size
	p.CFrame = cframe
	finish(p, color, material, extra)
	p.Parent = parent
	return p
end

local function shaped(parent, shape, size, cframe, color, material, extra)
	local p = Instance.new("Part")
	p.Shape = shape
	p.Size = size
	p.CFrame = cframe
	finish(p, color, material, extra)
	p.Parent = parent
	return p
end

-- Cylinders: Roblox cylinders run along their local X axis.
function Kit.cylX(parent, length, diameter, cframe, color, material, extra)
	return shaped(parent, Enum.PartType.Cylinder, Vector3.new(length, diameter, diameter), cframe, color, material, extra)
end

function Kit.cylY(parent, height, diameter, cframe, color, material, extra)
	return shaped(parent, Enum.PartType.Cylinder, Vector3.new(height, diameter, diameter), cframe * CFrame.Angles(0, 0, rad(90)), color, material, extra)
end

function Kit.cylZ(parent, length, diameter, cframe, color, material, extra)
	return shaped(parent, Enum.PartType.Cylinder, Vector3.new(length, diameter, diameter), cframe * CFrame.Angles(0, rad(90), 0), color, material, extra)
end

function Kit.ball(parent, diameter, cframe, color, material, extra)
	return shaped(parent, Enum.PartType.Ball, Vector3.new(diameter, diameter, diameter), cframe, color, material, extra)
end

-- A beam (block) running from p0 to p1.
function Kit.beam(parent, p0, p1, width, height, color, material, extra)
	local length = (p1 - p0).Magnitude
	local mid = (p0 + p1) / 2
	local cf
	local dir = (p1 - p0).Unit
	if math.abs(dir.Y) > 0.99 then
		cf = CFrame.lookAt(mid, p1, Vector3.new(1, 0, 0))
	else
		cf = CFrame.lookAt(mid, p1)
	end
	return Kit.part(parent, Vector3.new(width, height, length), cf, color, material, extra)
end

-- Right-triangle wall piece lying in the frame's XY plane (thin along Z).
-- The triangle spans xLow..xHigh at yBase, and rises to yTop above xHigh.
function Kit.triXY(parent, frame, xLow, xHigh, yBase, yTop, z, thickness, color, material, extra)
	local w = math.abs(xHigh - xLow)
	local h = yTop - yBase
	local cx = (xLow + xHigh) / 2
	local yaw = xHigh > xLow and rad(90) or rad(-90)
	local cf = frame * CFrame.new(cx, yBase + h / 2, z) * CFrame.Angles(0, yaw, 0)
	return Kit.wedge(parent, Vector3.new(thickness, h, w), cf, color, material, extra)
end

-- Slab whose underside follows the segment (xa,ya)->(xb,yb) in the frame's
-- XY plane, extruded along Z from z0 to z1. Used for arched roofs.
function Kit.slabXY(parent, frame, xa, ya, xb, yb, z0, z1, thickness, color, material, extra)
	local dx, dy = xb - xa, yb - ya
	local len = math.sqrt(dx * dx + dy * dy)
	local angle = math.atan2(dy, dx)
	local nx, ny = -math.sin(angle), math.cos(angle) -- outward (upward) normal
	local mx = (xa + xb) / 2 + nx * thickness / 2
	local my = (ya + yb) / 2 + ny * thickness / 2
	local cf = frame * CFrame.new(mx, my, (z0 + z1) / 2) * CFrame.Angles(0, 0, angle)
	return Kit.part(parent, Vector3.new(len + 0.05, thickness, math.abs(z1 - z0)), cf, color, material, extra)
end

-- Invisible helper volume (zones, spawn markers, exit points).
function Kit.marker(parent, name, size, cframe)
	return Kit.part(parent, size, cframe, Kit.C.Brass, Kit.M.Smooth, {
		Name = name,
		Transparency = 1,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
	})
end

-- Wall with rectangular holes. Splits the solid area into as few blocks as
-- possible. a = horizontal axis along the wall, b = vertical axis.
-- holes = { {a0, a1, b0, b1}, ... } (must lie inside the wall).
function Kit.solidRects(a0, a1, b0, b1, holes)
	local bs = { b0, b1 }
	for _, h in ipairs(holes) do
		table.insert(bs, math.max(b0, math.min(b1, h[3])))
		table.insert(bs, math.max(b0, math.min(b1, h[4])))
	end
	table.sort(bs)
	local rows = {}
	local last = nil
	for _, b in ipairs(bs) do
		if last == nil or b - last > 0.001 then
			table.insert(rows, b)
			last = b
		end
	end
	local rects = {}
	local open = {} -- key "a0:a1" -> rect being extended upward
	for i = 1, #rows - 1 do
		local rb0, rb1 = rows[i], rows[i + 1]
		local cuts = {}
		for _, h in ipairs(holes) do
			if h[3] <= rb0 + 0.001 and h[4] >= rb1 - 0.001 then
				table.insert(cuts, { h[1], h[2] })
			end
		end
		table.sort(cuts, function(x, y)
			return x[1] < y[1]
		end)
		local segs = {}
		local cursor = a0
		for _, c in ipairs(cuts) do
			if c[1] > cursor + 0.001 then
				table.insert(segs, { cursor, c[1] })
			end
			if c[2] > cursor then
				cursor = c[2]
			end
		end
		if a1 > cursor + 0.001 then
			table.insert(segs, { cursor, a1 })
		end
		local nextOpen = {}
		for _, s in ipairs(segs) do
			local key = string.format("%.3f:%.3f", s[1], s[2])
			local r = open[key]
			if r and math.abs(r[4] - rb0) < 0.001 then
				r[4] = rb1
			else
				r = { s[1], s[2], rb0, rb1 }
				table.insert(rects, r)
			end
			nextOpen[key] = r
		end
		open = nextOpen
	end
	return rects
end

-- Wall running along the frame's Z axis at x = xCenter (thickness along X).
function Kit.wallZ(parent, frame, xCenter, thickness, z0, z1, y0, y1, holes, color, material, extra)
	local parts = {}
	for _, r in ipairs(Kit.solidRects(z0, z1, y0, y1, holes or {})) do
		table.insert(parts, Kit.box(parent, frame, xCenter - thickness / 2, r[3], r[1], xCenter + thickness / 2, r[4], r[2], color, material, extra))
	end
	return parts
end

-- Wall running along the frame's X axis at z = zCenter (thickness along Z).
function Kit.wallX(parent, frame, zCenter, thickness, x0, x1, y0, y1, holes, color, material, extra)
	local parts = {}
	for _, r in ipairs(Kit.solidRects(x0, x1, y0, y1, holes or {})) do
		table.insert(parts, Kit.box(parent, frame, r[1], r[3], zCenter - thickness / 2, r[2], r[4], zCenter + thickness / 2, color, material, extra))
	end
	return parts
end

-- LIGHTS --------------------------------------------------------------------
function Kit.pointLight(part, range, brightness, color)
	local l = Instance.new("PointLight")
	l.Range = range
	l.Brightness = brightness
	l.Color = color or Kit.C.LightWarm
	l.Shadows = false
	l.Parent = part
	return l
end

function Kit.spotLight(part, face, range, brightness, angle, color)
	local l = Instance.new("SpotLight")
	l.Face = face
	l.Range = range
	l.Brightness = brightness
	l.Angle = angle
	l.Color = color or Kit.C.LightWarm
	l.Shadows = false
	l.Parent = part
	return l
end

-- A glowing bulb (Neon ball). Optional light.
function Kit.bulb(parent, diameter, cframe, color, lightRange, lightBrightness, lightColor)
	local b = Kit.ball(parent, diameter, cframe, color or Kit.C.BulbWarm, Kit.M.Neon, { Name = "Bulb", CastShadow = false, CanCollide = false })
	if lightRange then
		Kit.pointLight(b, lightRange, lightBrightness or 1, lightColor)
	end
	return b
end

-- GUI -------------------------------------------------------------------------
function Kit.surface(part, face, pixelsPerStud, props)
	local g = Instance.new("SurfaceGui")
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = pixelsPerStud or 50
	g.LightInfluence = 0.55
	g.Brightness = 1
	g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	g.MaxDistance = 220
	if props then
		for k, v in pairs(props) do
			g[k] = v
		end
	end
	g.Parent = part
	return g
end

function Kit.frame(parent, props)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundTransparency = 1
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

function Kit.label(parent, text, props)
	local t = Instance.new("TextLabel")
	t.BorderSizePixel = 0
	t.BackgroundTransparency = 1
	t.Text = text
	t.Font = Enum.Font.Oswald
	t.TextColor3 = Kit.C.Parchment
	t.TextScaled = true
	t.Size = UDim2.new(1, 0, 1, 0)
	for k, v in pairs(props or {}) do
		t[k] = v
	end
	t.Parent = parent
	return t
end

function Kit.corner(inst, scale, offset)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scale or 0, offset or 0)
	c.Parent = inst
	return c
end

function Kit.stroke(inst, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0
	s.Parent = inst
	return s
end

-- MISC ------------------------------------------------------------------------
function Kit.tag(inst, tag)
	CollectionService:AddTag(inst, tag)
	return inst
end

function Kit.attachment(part, name, localCFrame)
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = localCFrame or CFrame.new()
	a.Parent = part
	return a
end

-- Positional sound hook. The client creates the Sound if AudioConfig has an id.
function Kit.soundEmitter(part, soundKey, localCFrame)
	local a = Kit.attachment(part, "Sound_" .. soundKey, localCFrame)
	a:SetAttribute("SoundKey", soundKey)
	Kit.tag(a, "SoundEmitter")
	return a
end

function Kit.prompt(part, actionText, objectText, maxDistance)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = actionText
	p.ObjectText = objectText
	p.MaxActivationDistance = maxDistance or 10
	p.RequiresLineOfSight = false
	p.HoldDuration = 0
	p.Parent = part
	return p
end

return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">CabinBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	CabinBuilder — the four expedition boarding cabins on the lower platform.

	Each cabin is a Model under Workspace.ExpeditionCabins with attributes the
	server writes and the client reads:
	  CabinId, Capacity, DisplayName   (static)
	  State  = "Idle" | "Boarding" | "Departing" | "Departed"
	  Count, LeaderName, Countdown, Pulse (Pulse++ on every join)

	Named children the systems rely on:
	  Zone            invisible volume: standing inside = joining
	  ExitPoint       where "Leave" places you (outside the door)
	  DoorLeft/Right  pocket doors (attributes OpenCFrame / ClosedCFrame)
	  CounterPlate    status display (SurfaceGui "Display": Count/Status)
	  CapacityBulbs   Bulb1..BulbN, lit one per explorer
	  Semaphore.Arm   attributes CF_Idle / CF_Boarding / CF_Departing
	  Semaphore.SignalLamp, CabinLight (interior pendant bulb)

	Local frame of every cabin: origin = front-centre at platform level,
	+Z goes into the cabin (north), front wall occupies z 0..1.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent.BuildKit)
local Props = require(script.Parent.Props)
local Graphics = require(script.Parent.Graphics)
local Emblem = require(ReplicatedStorage.Shared.Modules.Emblem)
local CabinDefinitions = require(ReplicatedStorage.Shared.Config.CabinDefinitions)

local C, M = Kit.C, Kit.M
local rad = math.rad

local CabinBuilder = {}

local DOOR_H = 7.5

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local function pitchedRoof(model, F, hw, D, H, rise, overhang)
	local x0, x1 = -hw - 1 - overhang, hw + 1 + overhang
	local z0, z1 = -0.9, D + 2.9
	Kit.slabXY(model, F, x0, H - overhang * (rise / (hw + 1)), 0, H + rise, z0, z1, 0.5, C.BlueSteelDark, M.Metal, { Name = "Roof" })
	Kit.slabXY(model, F, 0, H + rise, x1, H - overhang * (rise / (hw + 1)), z0, z1, 0.5, C.BlueSteelDark, M.Metal, { Name = "Roof" })
	for _, z in ipairs({ 0.5, D + 1.5 }) do
		Kit.triXY(model, F, -hw - 1, 0, H, H + rise, z, 1, C.WoodDark, M.Planks, { Name = "Gable" })
		Kit.triXY(model, F, hw + 1, 0, H, H + rise, z, 1, C.WoodDark, M.Planks, { Name = "Gable" })
	end
	Kit.box(model, F, -0.35, H + rise + 0.1, z0, 0.35, H + rise + 0.6, z1, C.Brass, M.Metal, { Name = "RidgeCap" })
end

local function archedRoof(model, F, hw, D, H)
	local pts = { { -hw - 1.6, H - 0.2 }, { -hw * 0.5, H + 1.8 }, { hw * 0.5, H + 1.8 }, { hw + 1.6, H - 0.2 } }
	for i = 1, 3 do
		Kit.slabXY(model, F, pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2], -0.9, D + 2.9, 0.5, C.BlueSteelDark, M.Metal, { Name = "Roof" })
	end
	for _, z in ipairs({ 0.5, D + 1.5 }) do
		Kit.box(model, F, -hw * 0.5, H, z - 0.5, hw * 0.5, H + 1.8, z + 0.5, C.WoodDark, M.Planks, { Name = "RoofEnd" })
		Kit.triXY(model, F, -hw - 1, -hw * 0.5, H, H + 1.8, z, 1, C.WoodDark, M.Planks, { Name = "RoofEnd" })
		Kit.triXY(model, F, hw + 1, hw * 0.5, H, H + 1.8, z, 1, C.WoodDark, M.Planks, { Name = "RoofEnd" })
	end
end

local function flatRoof(model, F, hw, D, H)
	Kit.box(model, F, -hw - 1.8, H, -1.2, hw + 1.8, H + 0.7, D + 3, C.BlueSteelDark, M.Metal, { Name = "Roof" })
	Kit.box(model, F, -hw - 1.9, H + 0.7, -1.3, hw + 1.9, H + 0.95, D + 3.1, C.Brass, M.Metal, { Name = "Cornice" })
	Kit.box(model, F, -2.2, H + 0.95, D * 0.45, 2.2, H + 2.2, D * 0.45 + 3, C.Iron, M.Metal, { Name = "Ventilator" })
	Kit.box(model, F, -2.5, H + 2.2, D * 0.45 - 0.3, 2.5, H + 2.5, D * 0.45 + 3.3, C.BlueSteelDark, M.Metal, { Name = "VentilatorCap" })
	Kit.cylY(model, 3, 0.7, F * CFrame.new(hw - 1.2, H + 2.2, D), C.Iron, M.Metal, { Name = "Flue" })
end

local function semaphore(model, F, x, H)
	local sem = Kit.model(model, "Semaphore")
	local side = x < 0 and -1 or 1
	Kit.cylY(sem, 4.6, 0.45, F * CFrame.new(x, H + 2.0, -0.6), C.Iron, M.Metal, { Name = "Mast" })
	Kit.ball(sem, 0.6, F * CFrame.new(x, H + 4.4, -0.6), C.Brass, M.Metal, { Name = "MastCap" })
	local pivot = F * CFrame.new(x, H + 3.7, -0.95)
	local function armCF(angle)
		return pivot * CFrame.Angles(0, 0, rad(angle) * side) * CFrame.new(side * 1.4, 0, 0)
	end
	local arm = Kit.part(sem, V(2.8, 0.42, 0.16), armCF(0), C.Burgundy, M.Smooth, { Name = "Arm" })
	arm:SetAttribute("CF_Idle", armCF(0))
	arm:SetAttribute("CF_Boarding", armCF(38))
	arm:SetAttribute("CF_Departing", armCF(72))
	Kit.cylZ(sem, 0.3, 0.9, pivot * CFrame.new(0, 0, 0.1), C.Brass, M.Metal, { Name = "ArmHub" })
	-- the signal lamp below the arm changes colour with the cabin state
	local lampHousing = Kit.part(sem, V(0.9, 0.9, 0.6), F * CFrame.new(x, H + 2.6, -0.9), C.Iron, M.Metal, { Name = "LampHousing" })
	local lamp = Kit.cylZ(sem, 0.12, 0.6, lampHousing.CFrame * CFrame.new(0, 0, -0.32), C.BulbOff, M.Glass, { Name = "SignalLamp", CastShadow = false })
	-- small gear: the mechanism that drives the arm
	Kit.cylZ(sem, 0.3, 1.5, F * CFrame.new(x - side * 0.2, H + 1.1, -0.25), C.BrassDark, M.Metal, { Name = "Gear" })
	Kit.cylZ(sem, 0.34, 0.5, F * CFrame.new(x - side * 0.2, H + 1.1, -0.27), C.Iron, M.Metal, { Name = "GearHub" })
	return sem, lamp
end

local function interior(model, def, F, hw, D, H)
	local style = def.Style
	local rng = Kit.rng(#def.Id * 131 + def.Capacity)
	local floorY = 0.5
	local backZ = D + 1
	local function at(x, z, yaw)
		return F * CFrame.new(x, floorY, z) * CFrame.Angles(0, rad(yaw or 0), 0)
	end
	if style == "Solo" then
		Props.armchair(model, at(0, backZ - 1.6), C.FabricGreen)
		Props.table(model, at(hw - 1.3, backZ - 4.2, 90), 2.6, 1.6, 2.6, C.Wood)
		Kit.part(model, V(1.1, 0.04, 1.4), at(hw - 1.4, backZ - 4.4, 18) * CFrame.new(0, 2.62, 0), C.Parchment, M.Smooth, { Name = "RouteDocument" })
		Kit.part(model, V(1.0, 0.04, 1.3), at(hw - 1.1, backZ - 4.0, -9) * CFrame.new(0, 2.64, 0), C.Cream, M.Smooth, { Name = "RouteDocument" })
		Props.lantern(model, at(hw - 1.3, backZ - 3.4) * CFrame.new(0, 2.6, 0), 0.8)
		Graphics.poster(Props.panel(model, at(-hw + 0.15, backZ - 4.5, -90) * CFrame.new(0, 4.6, 0), 3, 4.2, C.WoodDark, C.Parchment, 50), "Line")
		Props.suitcase(model, at(-hw + 1.2, backZ - 1.2, 15), 1.8, 1.3, 0.8, C.Burgundy)
	elseif style == "Duo" then
		Props.bench(model, at(0, backZ - 1.3), 6.4, C.Wood)
		Graphics.tableMap(Props.panel(model, at(0, backZ - 0.15) * CFrame.new(0, 6, 0), 5.2, 2.6, C.WoodDark, C.Parchment, 40), 21)
		Props.suitcase(model, at(-hw + 1.1, backZ - 3.8, 80), 2.2, 1.4, 0.9, C.Leather)
		Props.trunk(model, at(hw - 1.5, backZ - 4.2, -6), 2.2, 1.6, 1.6, C.FabricGreen)
		Kit.part(model, V(2.6, 0.2, 1.0), at(hw - 0.5, 0, 90) * CFrame.new(0, 5.4, 0), C.WoodDark, M.Wood, { Name = "WallShelf" })
		Props.lantern(model, at(hw - 0.6, backZ - 4.4) * CFrame.new(0, 5.5, 0), 0.7)
	elseif style == "Squad" then
		Props.bench(model, at(0, backZ - 1.3), 9, C.Wood)
		Graphics.poster(Props.panel(model, at(-hw + 0.15, backZ - 5, -90) * CFrame.new(0, 4.8, 0), 3.2, 4.4, C.WoodDark, C.Parchment, 50), "Fog")
		local ys = Props.shelf(model, at(hw - 0.75, backZ - 5, 90), 3.6, 5.2, 1.3, 2, C.WoodDark)
		Props.lantern(model, at(hw - 0.75, backZ - 5.8) * CFrame.new(0, ys[2], 0), 0.75)
		Props.ropeCoil(model, at(hw - 0.75, backZ - 4.2) * CFrame.new(0, ys[2], 0), 1.1)
		Props.crate(model, at(hw - 0.75, backZ - 5) * CFrame.new(0, ys[1], 0), 1.6, 1.2, 1.0, C.Wood)
		Props.trunk(model, at(-hw + 1.6, backZ - 2.0, 4), 2.4, 1.6, 1.6, C.Leather)
	else -- Crew: the largest and most impressive room
		Props.bench(model, at(-hw + 1.1, D / 2 + 1.4, -90), 7, C.Wood)
		Props.bench(model, at(hw - 1.1, D / 2 + 1.4, 90), 7, C.Wood)
		local top = Props.table(model, at(0, D / 2 + 1.6), 4, 2.6, 2.7, C.WoodDark)
		local mapPart = Kit.part(model, V(3.4, 2.1, 0.04), top.CFrame * CFrame.new(0, 0.17, 0) * CFrame.Angles(rad(90), 0, 0), C.Parchment, M.Smooth, { Name = "TableMap", CanCollide = false })
		Graphics.tableMap(Kit.surface(mapPart, Enum.NormalId.Front, 50), 77)
		Kit.cylY(model, 0.1, 0.6, top.CFrame * CFrame.new(1.4, 0.2, -0.7), C.Brass, M.Metal, { Name = "Compass" })
		Graphics.poster(Props.panel(model, at(0, backZ - 0.15) * CFrame.new(0, 5.2, 0), 3.6, 5, C.WoodDark, C.Parchment, 45), "Dusk")
		Props.lantern(model, at(-2.8, backZ - 0.8), 0.9)
		Props.lantern(model, at(2.8, backZ - 0.8), 0.9)
		-- overhead luggage racks with a few bags
		for _, sx in ipairs({ -1, 1 }) do
			local x = sx * (hw - 0.9)
			Kit.box(model, F, x - 0.9, 7.6, 2.5, x + 0.9, 7.75, D - 0.5, C.WoodLight, M.Planks, { Name = "LuggageRack" })
			Kit.box(model, F, x - sx * 0.85 - 0.1, 7.9, 2.5, x - sx * 0.85 + 0.1, 8.1, D - 0.5, C.Brass, M.Metal, { Name = "RackRail" })
		end
		Props.suitcase(model, F * CFrame.new(-(hw - 0.9), 7.75, 4.4) * CFrame.Angles(0, rad(90), 0), 2.2, 1.0, 1.2, C.Burgundy)
		Props.trunk(model, F * CFrame.new(hw - 0.9, 7.75, D - 2.4) * CFrame.Angles(0, rad(90), 0), 2.4, 1.2, 1.4, C.Leather)
		Props.sack(model, F * CFrame.new(hw - 0.9, 7.75, 4.8), 2.2, 1.0)
	end
	-- interior lining keeps the walls warm-toned inside
	Kit.box(model, F, -hw, 0.5, backZ - 0.15, hw, H - 0.6, backZ, C.Wood, M.Planks, { Name = "Lining" })
	return rng
end

local function buildCabin(folder, def, F)
	local W, D, H, DW = def.Width, def.Depth, def.Height, def.DoorWidth
	local hw = W / 2
	local model = Kit.model(folder, def.Id)
	model:SetAttribute("CabinId", def.Id)
	model:SetAttribute("Capacity", def.Capacity)
	model:SetAttribute("DisplayName", def.DisplayName)
	model:SetAttribute("State", "Idle")
	model:SetAttribute("Count", 0)
	model:SetAttribute("LeaderName", "")
	model:SetAttribute("Countdown", 0)
	model:SetAttribute("Pulse", 0)

	-- Plinth, floor and a step up.
	Kit.box(model, F, -hw - 1.6, 0, -2.2, hw + 1.6, 0.4, D + 2.6, C.StoneLight, M.Slate, { Name = "Plinth" })
	Kit.box(model, F, -hw, 0.4, 1, hw, 0.5, D + 1, C.WoodLight, M.Planks, { Name = "Floor" })
	Kit.box(model, F, -DW / 2 - 0.3, 0.4, -0.1, DW / 2 + 0.3, 0.5, 1, C.Brass, M.Plate, { Name = "Threshold" })

	-- Side walls with windows (Solo stays private: a porthole only).
	local sideHoles = {}
	if def.Style ~= "Solo" then
		local count = def.Capacity >= 3 and 2 or 1
		for i = 1, count do
			local zc = 1 + D * i / (count + 1)
			table.insert(sideHoles, { zc - 1.6, zc + 1.6, 3.6, 7 })
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		Kit.wallZ(model, F, sx * (hw + 0.5), 1, 0, D + 2, 0.4, H, sideHoles, C.WoodDark, M.Planks, { Name = "SideWall" })
		for _, h in ipairs(sideHoles) do
			Kit.part(model, V(0.15, h[4] - h[3], h[2] - h[1]), F * CFrame.new(sx * (hw + 0.5), (h[3] + h[4]) / 2, (h[1] + h[2]) / 2), C.Glass, M.Glass, { Name = "Window", Transparency = 0.55, CastShadow = false })
			Kit.box(model, F, sx * (hw + 0.5) - 0.65, h[3] - 0.25, h[1] - 0.2, sx * (hw + 0.5) + 0.65, h[3], h[2] + 0.2, C.Brass, M.Metal, { Name = "WindowSill" })
		end
	end
	if def.Style == "Solo" then
		Kit.cylX(model, 1.15, 2.2, F * CFrame.new(-hw - 0.5, 5.2, D / 2 + 1), C.Brass, M.Metal, { Name = "PortholeRim" })
		Kit.cylX(model, 1.25, 1.6, F * CFrame.new(-hw - 0.5, 5.2, D / 2 + 1), C.GlassDark, M.Glass, { Name = "Porthole" })
	end
	Kit.wallX(model, F, D + 1.5, 1, -hw - 1, hw + 1, 0.4, H, {}, C.WoodDark, M.Planks, { Name = "BackWall" })

	-- Front facade: dark aged metal with the door opening and (larger cabins) windows.
	local frontHoles = { { -DW / 2, DW / 2, 0.4, DOOR_H + 0.4 } }
	local frontWindows = {}
	if def.Style ~= "Solo" then
		local inner = DW / 2 + 0.9
		local outer = hw - 0.6
		if outer - inner > 1 then
			table.insert(frontHoles, { -outer, -inner, 3.8, 6.8 })
			table.insert(frontHoles, { inner, outer, 3.8, 6.8 })
			table.insert(frontWindows, { -outer, -inner })
			table.insert(frontWindows, { inner, outer })
		end
	end
	Kit.wallX(model, F, 0.5, 1, -hw - 1, hw + 1, 0.4, H, frontHoles, C.BlueSteelDark, M.Metal, { Name = "Facade" })
	for _, w in ipairs(frontWindows) do
		Kit.part(model, V(w[2] - w[1], 3, 0.15), F * CFrame.new((w[1] + w[2]) / 2, 5.3, 0.5), C.Glass, M.Glass, { Name = "Window", Transparency = 0.55, CastShadow = false })
		Kit.box(model, F, w[1] - 0.2, 3.55, -0.25, w[2] + 0.2, 3.8, 1, C.Brass, M.Metal, { Name = "WindowSill" })
	end
	Kit.box(model, F, -hw - 1.05, H - 1.3, -0.12, hw + 1.05, H - 0.9, 0, C.Burgundy, M.Smooth, { Name = "Beltline" })
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(model, F, sx * (hw + 0.5) - 0.65, 0.4, -0.25, sx * (hw + 0.5) + 0.65, H + 0.2, 1.1, C.Iron, M.Metal, { Name = "CornerPost" })
		Kit.box(model, F, sx * (hw + 0.5) - 0.65, 0.4, D + 0.9, sx * (hw + 0.5) + 0.65, H + 0.2, D + 2.25, C.Iron, M.Metal, { Name = "CornerPost" })
	end

	-- Door frame, sliding pocket doors (hidden inside the wall while open).
	Kit.box(model, F, -DW / 2 - 0.35, 0.4, -0.18, -DW / 2, DOOR_H + 0.75, 0.02, C.Brass, M.Metal, { Name = "DoorFrame" })
	Kit.box(model, F, DW / 2, 0.4, -0.18, DW / 2 + 0.35, DOOR_H + 0.75, 0.02, C.Brass, M.Metal, { Name = "DoorFrame" })
	Kit.box(model, F, -DW / 2 - 0.35, DOOR_H + 0.4, -0.18, DW / 2 + 0.35, DOOR_H + 0.75, 0.02, C.Brass, M.Metal, { Name = "DoorFrame" })
	local leafW = DW / 2 + 0.05
	for _, sx in ipairs({ -1, 1 }) do
		local closed = F * CFrame.new(sx * (leafW / 2 - 0.05), 0.4 + DOOR_H / 2, 0.5)
		local open = F * CFrame.new(sx * (DW / 2 + leafW / 2 + 0.06), 0.4 + DOOR_H / 2, 0.5)
		local leaf = Kit.part(model, V(leafW, DOOR_H, 0.3), open, C.Burgundy, M.Metal, { Name = sx < 0 and "DoorLeft" or "DoorRight" })
		leaf:SetAttribute("OpenCFrame", open)
		leaf:SetAttribute("ClosedCFrame", closed)
		local g = Kit.surface(leaf, Enum.NormalId.Front, 30)
		Kit.frame(g, { Position = UDim2.new(0.18, 0, 0.1, 0), Size = UDim2.new(0.64, 0, 0.32, 0), BackgroundTransparency = 0, BackgroundColor3 = C.GlassDark })
		Kit.stroke(Kit.frame(g, { Position = UDim2.new(0.12, 0, 0.5, 0), Size = UDim2.new(0.76, 0, 0.42, 0) }), C.BrassDark, 2, 0.2)
		Kit.frame(g, { Position = UDim2.new(sx < 0 and 0.84 or 0.08, 0, 0.5, 0), Size = UDim2.new(0.08, 0, 0.14, 0), BackgroundTransparency = 0, BackgroundColor3 = C.Brass })
	end
	Kit.box(model, F, -DW - 0.4, DOOR_H + 0.8, -0.3, DW + 0.4, DOOR_H + 1.05, 0, C.Iron, M.Metal, { Name = "DoorRail" })

	-- Name sign above the door + capacity bulbs on top of it.
	local signW = W - 1
	local sy0, sy1 = DOOR_H + 1.25, math.min(H - 0.5, DOOR_H + 3.6)
	local sign = Kit.box(model, F, -signW / 2, sy0, -0.35, signW / 2, sy1, -0.05, C.Charcoal, M.Smooth, { Name = "Sign" })
	local CabinDefs = CabinDefinitions
	Graphics.signPlate(Kit.surface(sign, Enum.NormalId.Front, 40, { LightInfluence = 0.4, Brightness = 1.1 }), def.DisplayName, CabinDefs.CapacityLabel(def.Capacity), { TitleColor = C.Parchment })
	local bulbs = Kit.folder(model, "CapacityBulbs")
	for i = 1, def.Capacity do
		local bx = (i - (def.Capacity + 1) / 2) * 1.1
		Kit.cylY(bulbs, 0.3, 0.7, F * CFrame.new(bx, sy1 + 0.15, -0.2), C.BrassDark, M.Metal, { Name = "Socket" })
		Kit.ball(bulbs, 0.6, F * CFrame.new(bx, sy1 + 0.55, -0.2), C.BulbOff, M.Glass, { Name = "Bulb" .. i, CastShadow = false })
	end

	-- Status display beside the door (count + status), updated by the client.
	local plateW = math.min(2.4, hw - 0.2 - (DW / 2 + 0.35))
	local px0 = DW / 2 + 0.35
	local plate = Kit.box(model, F, px0, 4.0, -0.14, px0 + plateW, 5.7, -0.02, C.Charcoal, M.Smooth, { Name = "CounterPlate" })
	local display = Kit.surface(plate, Enum.NormalId.Front, 60, { Name = "Display", LightInfluence = 0.2, Brightness = 1.4 })
	Kit.frame(display, { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(22, 21, 20) })
	Kit.stroke(Kit.frame(display, { Size = UDim2.new(1, -6, 1, -6), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5) }), C.BrassDark, 2, 0.2)
	Kit.label(display, "0 / " .. def.Capacity, { Name = "Count", Position = UDim2.new(0.1, 0, 0.08, 0), Size = UDim2.new(0.8, 0, 0.46, 0), Font = Enum.Font.Merriweather, TextColor3 = C.Parchment })
	Kit.label(display, def.Capacity == 1 and "EXPLORER" or "EXPLORERS", { Name = "Unit", Position = UDim2.new(0.1, 0, 0.53, 0), Size = UDim2.new(0.8, 0, 0.16, 0), TextColor3 = C.Brass })
	Kit.label(display, "AVAILABLE", { Name = "Status", Position = UDim2.new(0.08, 0, 0.72, 0), Size = UDim2.new(0.84, 0, 0.18, 0), TextColor3 = C.Parchment })

	-- Exterior lamp by the door (no light object: the facade is lit by the platform).
	Props.sconce(model, F * CFrame.new(-DW / 2 - 1.1, DOOR_H - 0.3, 0) * CFrame.Angles(0, 0, 0), nil)

	-- Roof, by style.
	if def.Style == "Solo" then
		pitchedRoof(model, F, hw, D, H, 2.4, 0.8)
		local vent = Kit.cylZ(model, 0.3, 1.8, F * CFrame.new(0, H + 0.9, -0.05), C.Brass, M.Metal, { Name = "GableRoundel" })
		Emblem.Create(Kit.surface(vent, Enum.NormalId.Right, 60), { Color = C.Ink, Thickness = 3 })
	elseif def.Style == "Duo" then
		archedRoof(model, F, hw, D, H)
	elseif def.Style == "Squad" then
		flatRoof(model, F, hw, D, H)
	else
		pitchedRoof(model, F, hw, D, H, 5, 1.2)
		local roundel = Kit.cylZ(model, 0.3, 3.4, F * CFrame.new(0, H + 1.9, -0.05), C.Brass, M.Metal, { Name = "GableRoundel" })
		Emblem.Create(Kit.surface(roundel, Enum.NormalId.Right, 50), { Color = C.Ink, Thickness = 4 })
		-- roof lantern (clerestory) gives the Crew cabin its taller silhouette
		Kit.box(model, F, -1.4, H + 4.2, D * 0.35, 1.4, H + 6.4, D * 0.65, C.Iron, M.Metal, { Name = "RoofLantern" })
		Kit.box(model, F, -1.8, H + 6.4, D * 0.35 - 0.4, 1.8, H + 6.8, D * 0.65 + 0.4, C.BlueSteelDark, M.Metal, { Name = "RoofLanternCap" })
		Kit.box(model, F, -1.45, H + 4.9, D * 0.4, 1.45, H + 5.8, D * 0.6, C.BulbWarm, M.Neon, { Name = "RoofLanternGlow", Transparency = 0.35, CastShadow = false })
	end

	-- Semaphore boarding indicator on the left corner.
	semaphore(model, F, -hw - 0.5, H)

	-- Interior: lamp, furniture, the boarding zone and the exit point.
	local light = Props.pendant(model, F * CFrame.new(0, H - 0.3, D / 2 + 1), 1.4, 1.6, W + 8, 0.85)
	light.Name = "CabinLight"
	interior(model, def, F, hw, D, H)
	Kit.soundEmitter(Kit.marker(model, "HumSource", V(1, 1, 1), F * CFrame.new(0, 3, D + 0.5)), "CabinHum")
	Kit.marker(model, "Zone", V(W - 0.4, 8, D - 0.3), F * CFrame.new(0, 4.5, D / 2 + 1.05))
	Kit.marker(model, "ExitPoint", V(2, 1, 2), F * CFrame.new(0, 0.5, -5.5))
	Kit.tag(model, "ExpeditionCabin")
	return model
end

function CabinBuilder.Build(parent, platformY)
	local folder = Kit.folder(parent, "ExpeditionCabins")
	local gap = 5
	local total = -gap
	for _, def in ipairs(CabinDefinitions) do
		total = total + def.Width + 2 + gap
	end
	local x = -total / 2
	local frontZ = 46
	for _, def in ipairs(CabinDefinitions) do
		local ext = def.Width + 2
		buildCabin(folder, def, CFrame.new(x + ext / 2, platformY, frontZ))
		x = x + ext + gap
	end
	return folder
end

return CabinBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">CarriageInteriors</string><ProtectedString name="Source"><![CDATA[--[[
	CarriageInteriors — furniture and purpose for each carriage.

	Order (front to back): ENGINE | MYSTERY | CREW | DISCOVERY | EXPLORER | BOARDING
	Carriage local frame: x across (interior -7..7), y from rail level
	(floor surface 6.1), z = 0 at the end facing the engine, 40 at the rear.

	Future hooks (nothing here pretends to work yet):
	  * Models tagged "FutureInteraction" with attribute FutureSystem =
	    "Equipment" | "Inventory" | "Upgrades" mark where those systems go.
	    Each has an unlit "Indicator" bulb that can be lit when it ships.
	  * Parts tagged "DiscoveryDisplaySlot" (attribute SlotId) are the empty
	    places discoveries will fill.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent.BuildKit)
local Props = require(script.Parent.Props)
local Graphics = require(script.Parent.Graphics)
local Emblem = require(ReplicatedStorage.Shared.Modules.Emblem)

local C, M = Kit.C, Kit.M
local rad = math.rad
local FY = 6.1

local CarriageInteriors = {}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local function at(F, x, z, yaw, y)
	return F * CFrame.new(x, y or FY, z) * CFrame.Angles(0, rad(yaw or 0), 0)
end

-- Brass placard + unlit indicator marking a future system location.
local function futureStation(m, F, name, label, system, x, y, z, yaw)
	local station = Kit.model(m, name)
	station:SetAttribute("FutureSystem", system)
	Kit.tag(station, "FutureInteraction")
	local cf = at(F, x, z, yaw, y)
	local plate = Kit.part(station, V(2.8, 0.7, 0.1), cf, C.BrassDark, M.Metal, { Name = "Placard" })
	Graphics.signPlate(Kit.surface(plate, Enum.NormalId.Front, 60), label, "", { Background = C.BrassDark, Border = C.Ink, TitleColor = C.Ink, BorderThickness = 2 })
	Kit.ball(station, 0.35, cf * CFrame.new(1.75, 0, -0.05), C.BulbOff, M.Glass, { Name = "Indicator", CastShadow = false })
	return station
end

local function stool(m, cf)
	Kit.cylY(m, 0.3, 1.4, cf * CFrame.new(0, 1.85, 0), C.Leather, M.Fabric, { Name = "StoolSeat" })
	Kit.cylY(m, 1.7, 0.3, cf * CFrame.new(0, 0.85, 0), C.Iron, M.Metal, { Name = "StoolLeg" })
	Kit.cylY(m, 0.15, 1.1, cf * CFrame.new(0, 0.08, 0), C.Iron, M.Metal, { Name = "StoolFoot" })
end

local function gauge(m, cf, d)
	local disc = Kit.cylX(m, 0.2, d, cf, C.Brass, M.Metal, { Name = "Gauge" })
	local g = Kit.surface(disc, Enum.NormalId.Left, 60)
	local face = Kit.frame(g, { Size = UDim2.new(0.8, 0, 0.8, 0), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 0, BackgroundColor3 = C.Parchment })
	Kit.corner(face, 0.5, 0)
	Kit.frame(g, { Size = UDim2.new(0.03, 0, 0.36, 0), Position = UDim2.new(0.5, 0, 0.36, 0), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = 35, BackgroundTransparency = 0, BackgroundColor3 = C.Burgundy })
end

local function wallClock(m, cf)
	local disc = Kit.cylZ(m, 0.3, 1.8, cf, C.BrassDark, M.Metal, { Name = "WallClock" })
	local g = Kit.surface(disc, Enum.NormalId.Right, 60)
	local face = Kit.frame(g, { Size = UDim2.new(0.84, 0, 0.84, 0), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 0, BackgroundColor3 = C.Parchment })
	Kit.corner(face, 0.5, 0)
	Kit.frame(g, { Size = UDim2.new(0.04, 0, 0.3, 0), Position = UDim2.new(0.5, 0, 0.36, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 0, BackgroundColor3 = C.Ink })
	Kit.frame(g, { Size = UDim2.new(0.04, 0, 0.22, 0), Position = UDim2.new(0.56, 0, 0.55, 0), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = 125, BackgroundTransparency = 0, BackgroundColor3 = C.Ink })
end

-- BOARDING ----------------------------------------------------------------------
local function boarding(m, F)
	local rng = Kit.rng(404)
	local refs = {}

	-- Arrival space: eight spawn points (two rows), facing toward the engine.
	local spawns = Kit.folder(m, "BoardingSpawns")
	local i = 0
	for _, z in ipairs({ 13, 16.6 }) do
		for _, x in ipairs({ -4.5, -1.5, 1.5, 4.5 }) do
			i = i + 1
			Kit.marker(spawns, "Spawn" .. i, V(2, 1, 2), F * CFrame.new(x, FY + 0.5, z))
		end
	end
	refs.Spawns = spawns

	-- Compartment benches at the rear.
	for _, sx in ipairs({ -1, 1 }) do
		Props.bench(m, at(F, sx * 4.45, 30.7, 180), 5, C.FabricRed)
		Props.bench(m, at(F, sx * 4.45, 37.3, 0), 5, C.FabricRed)
	end

	-- Overhead luggage racks and small luggage storage.
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(m, F, sx * 5.3, 13.0, 2, sx * 7.0, 13.15, 22, C.WoodLight, M.Planks, { Name = "LuggageRack" })
		Kit.box(m, F, sx * 5.35 - 0.1, 13.35, 2, sx * 5.35 + 0.1, 13.5, 22, C.Brass, M.Metal, { Name = "RackRail" })
	end
	Props.suitcase(m, F * CFrame.new(-6.1, 13.15, 6) * CFrame.Angles(0, rad(90), 0), 2.4, 1.0, 1.2, C.Leather)
	Props.trunk(m, F * CFrame.new(6.1, 13.15, 9.5) * CFrame.Angles(0, rad(90), 0), 2.6, 1.2, 1.4, C.FabricGreen)
	Props.suitcase(m, F * CFrame.new(6.1, 13.15, 18) * CFrame.Angles(0, rad(90), 0), 2.0, 0.9, 1.1, C.Burgundy)
	local ys = Props.shelf(m, at(F, -6.35, 7.5, -90), 2.0, 3.2, 1.3, 2, C.WoodDark)
	Props.suitcase(m, at(F, -6.3, 7.5, -90, FY + ys[1]), 1.6, 1.0, 0.9, C.Burgundy)
	Props.suitcase(m, at(F, -6.3, 7.5, -90, FY + ys[2]), 1.4, 0.8, 0.8, C.Leather)
	Props.trunk(m, at(F, -5.6, 3.6, -80), 2.2, 1.4, 1.5, C.Leather)

	-- Route display over the doorway toward the rest of the train.
	local display = Kit.box(m, F, -4.6, 14.15, 1.2, 4.6, 15.35, 1.36, C.Charcoal, M.Smooth, { Name = "RouteDisplay" })
	local g = Kit.surface(display, Enum.NormalId.Back, 50, { LightInfluence = 0.2, Brightness = 1.3 })
	Kit.frame(g, { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(20, 19, 18) })
	Kit.label(g, "ROUTE", { Position = UDim2.new(0.03, 0, 0.18, 0), Size = UDim2.new(0.14, 0, 0.64, 0), TextColor3 = C.Brass })
	for k = 0, 7 do
		local cell = Kit.frame(g, { Position = UDim2.new(0.2 + k * 0.058, 0, 0.16, 0), Size = UDim2.new(0.05, 0, 0.68, 0), BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(34, 32, 30) })
		Kit.label(cell, "-", { TextColor3 = C.Parchment })
	end
	Kit.label(g, "PREPARING ROUTE", { Name = "Status", Position = UDim2.new(0.68, 0, 0.22, 0), Size = UDim2.new(0.3, 0, 0.56, 0), TextColor3 = C.Parchment })

	-- Vestibule doors (closed while travelling). The right one is the
	-- development exit back to the terminal.
	for _, sx in ipairs({ -1, 1 }) do
		local leaf = Kit.box(m, F, sx * 7.4, 6.0, 24, sx * 7.8, 13.6, 29, C.Burgundy, M.Metal, { Name = sx > 0 and "ExitDoor" or "SideDoor" })
		for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
			local dg = Kit.surface(leaf, face, 30)
			Kit.frame(dg, { Position = UDim2.new(0.2, 0, 0.12, 0), Size = UDim2.new(0.6, 0, 0.32, 0), BackgroundTransparency = 0, BackgroundColor3 = C.GlassDark })
			Kit.frame(dg, { Position = UDim2.new(0.84, 0, 0.5, 0), Size = UDim2.new(0.06, 0, 0.12, 0), BackgroundTransparency = 0, BackgroundColor3 = C.Brass })
		end
		if sx > 0 then
			local prompt = Kit.prompt(leaf, "Return to Terminal", "Exit Door", 9)
			prompt.HoldDuration = 0.4
			Kit.tag(leaf, "ReturnToTerminal")
			refs.ExitDoor = leaf
		end
	end
	Kit.box(m, F, -7, FY, 24, 7, FY + 0.05, 29, C.Iron, M.Plate, { Name = "VestibuleMat" })

	-- A few purposeful touches.
	Graphics.poster(Props.panel(m, at(F, -5.1, 38.75, 0, 10.6), 2.6, 3.6, C.WoodDark, C.Parchment, 50), "Dusk")
	wallClock(m, F * CFrame.new(5.1, 11.2, 38.8))
	Props.lantern(m, at(F, 6.0, 37.8), 0.7)
	refs.ConductorCFrame = at(F, 4.6, 5.4, 180)
	return refs
end

-- EXPLORER ----------------------------------------------------------------------
local function explorer(m, F)
	local rng = Kit.rng(512)

	-- Lockers (left) and the equipment rack (right).
	for i = 1, 4 do
		Props.locker(m, at(F, -6.3, 1.9 + i * 1.95, -90), 1.9, 7.2, 1.3, "0" .. i, C.BlueSteel)
	end
	local equip = futureStation(m, F, "EquipmentStation", "EQUIPMENT", "Equipment", 6.85, 13.0, 6, 90)
	Kit.box(equip, F, 6.75, 7.0, 2.2, 6.98, 12.6, 9.8, C.WoodWorn, M.Planks, { Name = "Pegboard" })
	Kit.box(equip, F, 6.3, 11.9, 2.4, 6.75, 12.05, 9.6, C.Brass, M.Metal, { Name = "HangRail" })
	for k, z in ipairs({ 3.4, 5.6 }) do
		Kit.part(equip, V(0.9, 2.2, 1.5), at(F, 6.2, z, 0, 9.4), k == 1 and C.Canvas or C.FabricGreen, M.Fabric, { Name = "Backpack" })
		Kit.part(equip, V(0.95, 0.9, 1.55), at(F, 6.15, z, 0, 10.3), C.Leather, M.Fabric, { Name = "BackpackFlap" })
	end
	Kit.cylX(equip, 0.5, 2.0, at(F, 6.45, 7.8, 0, 10.6), C.Canvas, M.Fabric, { Name = "RopeCoil" })
	Kit.beam(equip, F * V(6.4, 8.0, 9.2), F * V(6.4, 10.8, 9.0), 0.2, 0.2, C.WoodDark, M.Wood, { Name = "PickHandle" })
	Kit.part(equip, V(0.25, 0.3, 1.6), at(F, 6.4, 9.0, 0, 10.9) * CFrame.Angles(rad(12), 0, 0), C.Iron, M.Metal, { Name = "PickHead" })
	Kit.box(equip, F, 5.7, 6.1, 2.4, 6.9, 7.2, 9.6, C.WoodDark, M.Planks, { Name = "GearChest" })

	-- Central planning table with the route map and instruments.
	local top = Props.table(m, at(F, 0, 20, 90), 7.4, 3.6, 2.9, C.WoodDark)
	local map = Kit.part(m, V(6.6, 3.0, 0.04), top.CFrame * CFrame.new(0, 0.17, 0) * CFrame.Angles(rad(90), 0, 0), C.Parchment, M.Smooth, { Name = "PlanningMap", CanCollide = false })
	Graphics.tableMap(Kit.surface(map, Enum.NormalId.Front, 40), 314)
	Kit.cylY(m, 0.12, 0.8, top.CFrame * CFrame.new(-1.0, 0.22, 2.4), C.Brass, M.Metal, { Name = "Compass" })
	Kit.cylZ(m, 0.4, 2.2, top.CFrame * CFrame.new(1.0, 0.35, -2.6), C.Canvas, M.Fabric, { Name = "RolledMap" })
	Props.lantern(m, top.CFrame * CFrame.new(0.9, 0.15, 2.8), 0.6, 12, 0.6)
	for _, p in ipairs({ { -2.6, 17.4 }, { -2.6, 22.6 }, { 2.6, 17.4 }, { 2.6, 22.6 } }) do
		stool(m, at(F, p[1], p[2]))
	end

	-- Inventory preparation bench (left) — future system location.
	local prep = futureStation(m, F, "PreparationBench", "PREPARATION", "Inventory", -6.85, 14.4, 20, -90)
	Props.table(prep, at(F, -5.7, 20, 90), 6, 2.2, 2.7, C.WoodWorn)
	Props.trunk(prep, at(F, -5.7, 18.4, 90, FY + 2.7), 2.0, 1.4, 1.4, C.Leather)
	Props.sack(prep, at(F, -5.6, 21.4, 10, FY + 2.7), 1.8, 1.0)
	Props.crate(prep, at(F, -5.5, 22.2, 4), 1.8, 1.6, 1.6)

	-- Route engineering desk (right) — future expedition upgrades.
	local eng = futureStation(m, F, "EngineeringDesk", "ROUTE ENGINEERING", "Upgrades", 6.85, 14.4, 20, 90)
	Props.table(eng, at(F, 5.7, 20, 90), 5.2, 2.2, 2.9, C.WoodDark)
	local board = Kit.part(eng, V(0.14, 2.4, 4.2), at(F, 5.9, 20, 0, 10.0) * CFrame.Angles(0, 0, rad(-24)), C.Parchment, M.Smooth, { Name = "DraftingBoard" })
	Graphics.tableMap(Kit.surface(board, Enum.NormalId.Left, 50), 99)
	gauge(eng, F * CFrame.new(6.88, 11.2, 16.6), 1.3)
	gauge(eng, F * CFrame.new(6.88, 11.2, 23.4), 1.3)

	-- Wall map beside the forward doorway.
	Graphics.routeMap(Props.panel(m, at(F, -5.0, 1.32, 180, 10.6), 3.4, 2.4, C.WoodDark, C.Parchment, 60))

	-- Storage at the rear.
	for _, sx in ipairs({ -1, 1 }) do
		local shelfCF = at(F, sx * 6.35, 33.8, sx * 90)
		local levels = Props.shelf(m, shelfCF, 6.4, 6.6, 1.3, 3, C.WoodDark)
		for li = 1, #levels - 1 do
			local y = levels[li]
			Props.crate(m, shelfCF * CFrame.new(-2.0 + rng(-0.2, 0.2), y, 0), 1.6, 1.3, 1.0, C.WoodLight)
			Props.crate(m, shelfCF * CFrame.new(0.4 + rng(-0.3, 0.3), y, 0), 1.2, 1.0, 0.9, C.Wood)
			Kit.cylY(m, 1.0, 0.7, shelfCF * CFrame.new(2.2, y + 0.5, 0), C.Glass, M.Glass, { Name = "Jar", Transparency = 0.3 })
		end
	end
	Props.crate(m, at(F, 4.6, 37.6, 8), 2.2, 2.0, 2.0)
	Props.crate(m, at(F, 4.6, 37.6, 21, FY + 2.0), 1.5, 1.3, 1.5, C.Wood)
	Kit.box(m, F, -1.6, FY, 1, 1.6, FY + 0.04, 39, C.Iron, M.Plate, { Name = "AisleRunner" })
end

-- DISCOVERY -----------------------------------------------------------------------
local function discovery(m, F)
	local rng = Kit.rng(77)
	local slot = 0
	local function tagSlot(part, id)
		part:SetAttribute("SlotId", id)
		Kit.tag(part, "DiscoveryDisplaySlot")
	end

	-- Archive bookshelves (front).
	for _, sx in ipairs({ -1, 1 }) do
		local shelfCF = at(F, sx * 6.35, 6.0, sx * 90)
		local levels = Props.shelf(m, shelfCF, 7.4, 8.6, 1.3, 4, C.WoodDark)
		for li = 1, #levels - 1 do
			Props.books(m, shelfCF * CFrame.new(0, levels[li], 0), 6.6, rng)
		end
	end

	-- Display cases beneath the windows: empty, waiting.
	for _, sx in ipairs({ -1, 1 }) do
		for _, z in ipairs({ 14, 20, 26 }) do
			slot = slot + 1
			local glass = Props.displayCase(m, at(F, sx * 5.65, z, 90), 3.4, 3.6, 1.6)
			tagSlot(glass, "Case" .. slot)
		end
	end

	-- The central pedestal: the most important empty place on the train.
	Kit.cylY(m, 0.6, 4.4, at(F, 0, 20, 0, FY + 0.3), C.StoneDark, M.Marble, { Name = "CentralBase" })
	Kit.cylY(m, 2.6, 2.4, at(F, 0, 20, 0, FY + 1.9), C.Stone, M.Marble, { Name = "CentralColumn" })
	Kit.cylY(m, 0.4, 3.2, at(F, 0, 20, 0, FY + 3.4), C.StoneDark, M.Marble, { Name = "CentralTop" })
	local cradle = Kit.cylY(m, 0.25, 1.5, at(F, 0, 20, 0, FY + 3.72), C.Brass, M.Metal, { Name = "Cradle" })
	Kit.cylY(m, 0.27, 0.9, at(F, 0, 20, 0, FY + 3.72), Color3.fromRGB(26, 24, 22), M.Smooth, { Name = "CradleHollow" })
	Kit.cylY(m, 2.6, 2.6, at(F, 0, 20, 0, FY + 5.0), C.Glass, M.Glass, { Name = "BellJar", Transparency = 0.82, CastShadow = false, CanCollide = false })
	tagSlot(cradle, "Central")
	local plaque = Kit.part(m, V(1.6, 0.6, 0.1), at(F, 0, 18.75, 0, FY + 1.5) * CFrame.Angles(rad(-15), 0, 0), C.Brass, M.Metal, { Name = "Plaque" })
	Kit.label(Kit.surface(plaque, Enum.NormalId.Front, 80), "UNCATALOGUED", { TextColor3 = C.Ink, Position = UDim2.new(0.08, 0, 0.2, 0), Size = UDim2.new(0.84, 0, 0.6, 0) })
	local spot = Kit.marker(m, "PedestalSpot", V(0.5, 0.5, 0.5), F * CFrame.new(0, 16.9, 20))
	Kit.spotLight(spot, Enum.NormalId.Bottom, 14, 1.4, 36, Color3.fromRGB(226, 232, 255))
	Kit.cylY(m, 0.5, 1.2, F * CFrame.new(0, 17.1, 20), C.BrassDark, M.Metal, { Name = "SpotHousing" })

	-- Smaller empty pedestals.
	for _, p in ipairs({ { 0, 12 }, { 0, 28 }, { -3.4, 33.5 }, { 3.4, 33.5 } }) do
		slot = slot + 1
		local pTop = Props.pedestal(m, at(F, p[1], p[2]), 3.4, 1.4)
		tagSlot(pTop, "Pedestal" .. slot)
	end

	-- Collection cabinets at the rear: specimen drawers and a map chest.
	local cab = Kit.part(m, V(1.4, 6.2, 7.0), at(F, -6.2, 34.6, 0, FY + 3.1), C.WoodDark, M.Wood, { Name = "SpecimenCabinet" })
	local cg = Kit.surface(cab, Enum.NormalId.Right, 30)
	for r = 0, 5 do
		for c = 0, 3 do
			local drawer = Kit.frame(cg, { Position = UDim2.new(0.04 + c * 0.24, 0, 0.04 + r * 0.16, 0), Size = UDim2.new(0.22, 0, 0.14, 0), BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(78, 52, 34) })
			Kit.frame(drawer, { Position = UDim2.new(0.38, 0, 0.42, 0), Size = UDim2.new(0.24, 0, 0.16, 0), BackgroundTransparency = 0, BackgroundColor3 = C.Brass })
		end
	end
	Kit.part(m, V(1.6, 3.4, 7.0), at(F, 6.1, 34.6, 0, FY + 1.7), C.WoodDark, M.Wood, { Name = "MapChest" })
	Graphics.routeMap(Props.panel(m, at(F, 6.85, 34.6, 90, 11.4), 6, 3.4, C.BrassDark, C.Parchment, 40))
	Kit.box(m, F, -1.5, FY, 1, 1.5, FY + 0.05, 39, C.Burgundy, M.Fabric, { Name = "Runner" })
end

-- CREW ----------------------------------------------------------------------------
local function crew(m, F)
	local rng = Kit.rng(8)
	Kit.box(m, F, -6.6, FY, 8.5, 2.4, FY + 0.05, 21.5, Color3.fromRGB(110, 40, 42), M.Fabric, { Name = "Rug" })

	-- Lounge: sofa, armchairs and a low table with an unfinished game of cards.
	Props.sofa(m, at(F, -5.7, 15, -90), 7.4, C.FabricRed)
	Props.armchair(m, at(F, 2.6, 12.4, 90), C.FabricRed)
	Props.armchair(m, at(F, 2.6, 17.6, 90), C.FabricGreen)
	local low = Props.table(m, at(F, -1.4, 15, 0), 2.4, 4.2, 1.6, C.WoodDark)
	local cards = Kit.part(m, V(2.0, 3.6, 0.03), low.CFrame * CFrame.new(0, 0.16, 0) * CFrame.Angles(rad(90), 0, 0), C.WoodDark, M.Smooth, { Name = "Cards", CanCollide = false, Transparency = 1 })
	local cg = Kit.surface(cards, Enum.NormalId.Front, 60)
	for k = 0, 5 do
		Kit.frame(cg, { Position = UDim2.new(0.2 + (k % 3) * 0.22 + rng(-0.03, 0.03), 0, 0.25 + math.floor(k / 3) * 0.4, 0), Size = UDim2.new(0.18, 0, 0.16, 0), Rotation = rng(-25, 25), BackgroundTransparency = 0, BackgroundColor3 = C.Parchment })
	end
	Props.lantern(m, low.CFrame * CFrame.new(-0.6, 0.15, -1.3), 0.55, 10, 0.55)

	-- Card / map table with two chairs and a stool.
	Kit.cylY(m, 0.25, 3.8, at(F, 2.6, 31, 0, FY + 2.6), C.Wood, M.Wood, { Name = "RoundTableTop" })
	Kit.cylY(m, 2.4, 0.6, at(F, 2.6, 31, 0, FY + 1.25), C.WoodDark, M.Wood, { Name = "RoundTableLeg" })
	Kit.cylY(m, 0.2, 2.0, at(F, 2.6, 31, 0, FY + 0.1), C.WoodDark, M.Wood, { Name = "RoundTableFoot" })
	local mapTop = Kit.part(m, V(2.4, 1.6, 0.03), at(F, 2.6, 31, 15, FY + 2.75) * CFrame.Angles(rad(90), 0, 0), C.Parchment, M.Smooth, { Name = "TravelMap", CanCollide = false })
	Graphics.tableMap(Kit.surface(mapTop, Enum.NormalId.Front, 60), 5)
	Props.armchair(m, at(F, 2.6, 27.6, 180), C.FabricRed)
	Props.armchair(m, at(F, 2.6, 34.4, 0), C.FabricRed)
	stool(m, at(F, 5.6, 31))
	Props.lantern(m, at(F, 1.8, 30.4, 0, FY + 2.73), 0.55, 10, 0.5)

	-- Bookshelf between windows, travel gear, coat rack.
	local shelfCF = at(F, -6.35, 29.5, -90)
	local levels = Props.shelf(m, shelfCF, 2.6, 5.4, 1.3, 3, C.WoodDark)
	for li = 1, #levels - 1 do
		Props.books(m, shelfCF * CFrame.new(0, levels[li], 0), 2.2, rng)
	end
	Kit.cylY(m, 6.6, 0.3, at(F, -5.8, 3.4, 0, FY + 3.3), C.WoodDark, M.Wood, { Name = "CoatRack" })
	Kit.cylY(m, 0.2, 1.6, at(F, -5.8, 3.4, 0, FY + 0.1), C.WoodDark, M.Wood, { Name = "CoatRackFoot" })
	Kit.part(m, V(1.6, 3.2, 0.5), at(F, -5.8, 3.0, 20, FY + 4.3), C.FabricGreen, M.Fabric, { Name = "HangingCoat" })
	Kit.cylY(m, 0.12, 1.9, at(F, -5.8, 3.4, 0, FY + 6.7), C.Leather, M.Fabric, { Name = "HatBrim" })
	Kit.cylY(m, 0.7, 1.1, at(F, -5.8, 3.4, 0, FY + 7.1), C.Leather, M.Fabric, { Name = "HatCrown" })
	Props.trunk(m, at(F, 5.5, 3.6, -8), 2.6, 1.8, 1.6, C.Leather)
	Props.suitcase(m, at(F, 5.3, 6.0, 12), 1.8, 1.2, 0.8, C.Burgundy)
	Kit.cylY(m, 2.2, 0.8, at(F, 6.2, 37.8, 0, FY + 1.1), C.BrassDark, M.Metal, { Name = "UmbrellaStand" })
	Kit.cylY(m, 2.6, 0.2, at(F, 6.1, 37.7, 0, FY + 2.4), C.Ink, M.Fabric, { Name = "Umbrella" })
	Graphics.poster(Props.panel(m, at(F, -5.0, 38.75, 0, 10.8), 2.6, 3.6, C.WoodDark, C.Parchment, 50), "Vale")
end

-- MYSTERY (sealed) -------------------------------------------------------------------
local function mystery(m, F, L)
	local refs = {}
	local door = Kit.part(m, V(5.6, 8.2, 0.35), F * CFrame.new(0, 10.1, L + 0.17), Color3.fromRGB(34, 36, 42), M.Metal, { Name = "SealedDoor" })
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(m, F, sx * 2.8, 6.0, L, sx * 3.25, 14.6, L + 0.45, C.BrassDark, M.Metal, { Name = "DoorFrame" })
	end
	Kit.box(m, F, -3.25, 14.2, L, 3.25, 14.65, L + 0.45, C.BrassDark, M.Metal, { Name = "DoorFrame" })
	local roundel = Kit.cylZ(m, 0.25, 3.3, F * CFrame.new(0, 11.4, L + 0.42), C.BrassDark, M.Metal, { Name = "DoorEmblem" })
	Emblem.Create(Kit.surface(roundel, Enum.NormalId.Left, 60, { LightInfluence = 0.6 }), { Color = Color3.fromRGB(24, 26, 30), Thickness = 5, Size = UDim2.new(0.86, 0, 0.86, 0) })
	-- The lock: three notches, no keyhole.
	local lock = Kit.cylZ(m, 0.3, 1.6, F * CFrame.new(0, 8.2, L + 0.45), C.Brass, M.Metal, { Name = "Lock" })
	local lg = Kit.surface(lock, Enum.NormalId.Left, 80)
	local ring = Kit.frame(lg, { Size = UDim2.new(0.7, 0, 0.7, 0), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5) })
	Kit.corner(ring, 0.5, 0)
	Kit.stroke(ring, C.Ink, 4, 0)
	for k = 0, 2 do
		local a = rad(k * 120)
		Kit.frame(lg, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5 + 0.35 * math.sin(a), 0, 0.5 - 0.35 * math.cos(a), 0), Size = UDim2.new(0.1, 0, 0.18, 0), Rotation = k * 120, BackgroundTransparency = 0, BackgroundColor3 = C.Ink })
	end
	-- A cold lamp: the only light on the train that is not warm.
	Kit.box(m, F, -0.6, 14.9, L + 0.1, 0.6, 15.5, L + 0.9, C.Iron, M.Metal, { Name = "ColdLampHousing" })
	local cold = Kit.part(m, V(0.8, 0.5, 0.6), F * CFrame.new(0, 14.6, L + 0.55), Color3.fromRGB(150, 190, 230), M.Neon, { Name = "ColdLamp", CastShadow = false })
	Kit.pointLight(cold, 11, 0.75, Color3.fromRGB(140, 175, 225))
	local prompt = Kit.prompt(door, "Inspect", "Sealed Door", 9)
	door:SetAttribute("DialogueId", "MysteryDoor")
	door:SetAttribute("SoundKey", "LockedDoor")
	prompt:SetAttribute("DialogueId", "MysteryDoor")
	refs.Door = door
	return refs
end

function CarriageInteriors.Build(train, info)
	local L = 40
	local refs = {}
	local car = info.Carriages
	if car.Boarding then
		local r = boarding(train:FindFirstChild("BoardingCarriage"), car.Boarding.Frame)
		refs.Spawns = r.Spawns
		refs.ExitDoor = r.ExitDoor
		refs.ConductorCFrame = r.ConductorCFrame
	end
	if car.Explorer then
		explorer(train:FindFirstChild("ExplorerCarriage"), car.Explorer.Frame)
	end
	if car.Discovery then
		discovery(train:FindFirstChild("DiscoveryCarriage"), car.Discovery.Frame)
	end
	if car.Crew then
		crew(train:FindFirstChild("CrewCarriage"), car.Crew.Frame)
	end
	if car.Mystery then
		refs.MysteryDoor = mystery(train:FindFirstChild("MysteryCarriage"), car.Mystery.Frame, L).Door
	end
	return refs
end

return CarriageInteriors
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">EnvironmentBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	EnvironmentBuilder — the world just outside the terminal, and the train
	teaser.

	Seen through the east windows: a cold, foggy railway yard where THE LAST
	TRAIN waits with its headlamp lit and steam rising. Players cannot reach
	the yard (the terminal is enclosed); it is a glimpse, not a level.
	Seen through the north windows: firs and a far ridge fading into fog.
]]

local Kit = require(script.Parent.BuildKit)
local TrainBuilder = require(script.Parent.TrainBuilder)

local C, M = Kit.C, Kit.M
local rad = math.rad

local EnvironmentBuilder = {}

local RAIL_Y = -11

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

-- Fir silhouette: trunk + two triangular tiers (wedge pairs), five parts.
-- The triangle faces local X: use yaw ~0 when seen along X, ~90 along Z.
function EnvironmentBuilder.Fir(parent, base, height, yaw, color)
	local m = parent
	local cf = CFrame.new(base) * CFrame.Angles(0, rad(yaw or 0), 0)
	Kit.cylY(m, height * 0.3, height * 0.06, cf * CFrame.new(0, height * 0.15, 0), C.Bark, M.Wood, { Name = "Trunk", CastShadow = false })
	local tiers = { { 0.18, 0.55, 0.46 }, { 0.5, 0.5, 0.32 } }
	for _, t in ipairs(tiers) do
		local y0, h, w = height * t[1], height * t[2], height * t[3]
		local thick = w * 0.8
		Kit.wedge(m, V(thick, h, w / 2), cf * CFrame.new(0, y0 + h / 2, -w / 4), color or C.Foliage, M.Smooth, { Name = "Foliage", CastShadow = false })
		Kit.wedge(m, V(thick, h, w / 2), cf * CFrame.new(0, y0 + h / 2, w / 4) * CFrame.Angles(0, rad(180), 0), color or C.Foliage, M.Smooth, { Name = "Foliage", CastShadow = false })
	end
end

-- Ridge silhouette: a long triangular prism, thin enough to stay cheap.
function EnvironmentBuilder.Ridge(parent, center, length, height, thickness, yaw, color)
	local cf = CFrame.new(center) * CFrame.Angles(0, rad(yaw or 0), 0)
	Kit.wedge(parent, V(thickness, height, length / 2), cf * CFrame.new(0, height / 2, -length / 4), color or C.Mountain, M.Smooth, { Name = "Ridge", CastShadow = false })
	Kit.wedge(parent, V(thickness, height, length / 2), cf * CFrame.new(0, height / 2, length / 4) * CFrame.Angles(0, rad(180), 0), color or C.Mountain, M.Smooth, { Name = "Ridge", CastShadow = false })
end

local function track(parent, x, z0, z1, sleepers)
	Kit.box(parent, CFrame.new(), x - 7, RAIL_Y - 1.5, z0, x + 7, RAIL_Y - 0.55, z1, Color3.fromRGB(58, 56, 54), M.Pebble, { Name = "Ballast" })
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(parent, CFrame.new(), x + sx * 4 - 0.25, RAIL_Y - 0.55, z0, x + sx * 4 + 0.25, RAIL_Y, z1, Color3.fromRGB(90, 88, 86), M.Metal, { Name = "Rail" })
	end
	if sleepers then
		for z = z0 + 2, z1 - 2, 4 do
			Kit.box(parent, CFrame.new(), x - 6, RAIL_Y - 0.75, z - 0.6, x + 6, RAIL_Y - 0.45, z + 0.6, C.WoodDark, M.Wood, { Name = "Sleeper" })
		end
	end
end

function EnvironmentBuilder.Build(parent)
	local env = Kit.folder(parent, "Environment")
	local yard = Kit.folder(env, "TrainYard")

	-- Ground under everything outside.
	Kit.box(env, CFrame.new(), -700, -14, -700, 700, -13, 700, C.Ground, M.Ground, { Name = "Ground", CastShadow = false })
	Kit.box(yard, CFrame.new(), 46, -13, -150, 150, -12.4, 220, Color3.fromRGB(46, 47, 45), M.Pebble, { Name = "YardBed" })

	-- Tracks: the train's line (with sleepers in view) and an empty siding.
	track(yard, 76, -150, 220, false)
	for z = -70, 140, 4 do
		Kit.box(yard, CFrame.new(), 70, RAIL_Y - 0.75, z - 0.6, 82, RAIL_Y - 0.45, z + 0.6, C.WoodDark, M.Wood, { Name = "Sleeper" })
	end
	track(yard, 102, -150, 220, false)

	-- THE LAST TRAIN, waiting. Exterior only, engine + two carriages.
	local teaser = TrainBuilder.Build(env, CFrame.new(76, RAIL_Y, -40), {
		Name = "TrainTeaser",
		Carriages = { "Mystery", "Crew" },
		Interiors = false,
	})
	teaser:SetAttribute("Note", "Visual teaser only. The playable train is Workspace.ExpeditionTrain.")

	-- Yard furniture: a signal, a water crane, a cold yard lamp.
	local sig = Kit.model(yard, "Signal")
	Kit.cylY(sig, 12, 0.6, CFrame.new(90, RAIL_Y + 6, -56), C.Iron, M.Metal, { Name = "SignalPost" })
	Kit.part(sig, V(0.5, 0.6, 3.4), CFrame.new(90, RAIL_Y + 11, -57.6) * CFrame.Angles(rad(-20), 0, 0), C.Burgundy, M.Smooth, { Name = "SignalArm" })
	Kit.ball(sig, 0.7, CFrame.new(90.4, RAIL_Y + 10.2, -56), Color3.fromRGB(200, 58, 48), M.Neon, { Name = "SignalLamp", CastShadow = false })
	local crane = Kit.model(yard, "WaterCrane")
	Kit.cylY(crane, 10, 1.2, CFrame.new(91, RAIL_Y + 5, 14), C.Iron, M.Metal, { Name = "Column" })
	Kit.cylX(crane, 7, 0.9, CFrame.new(87.5, RAIL_Y + 9.6, 14), C.Iron, M.Metal, { Name = "Arm" })
	Kit.cylY(crane, 2.4, 0.7, CFrame.new(84.2, RAIL_Y + 8.2, 14), C.Iron, M.Metal, { Name = "Spout" })
	Kit.cylY(crane, 0.6, 2.2, CFrame.new(91, RAIL_Y + 0.3, 14), C.Iron, M.Metal, { Name = "Base" })
	local lamp = Kit.model(yard, "YardLamp")
	Kit.cylY(lamp, 14, 0.5, CFrame.new(60, RAIL_Y + 6.6, -12), C.Iron, M.Metal, { Name = "Post" })
	local head = Kit.part(lamp, V(1, 0.8, 1), CFrame.new(60, RAIL_Y + 13.8, -12), Color3.fromRGB(176, 200, 228), M.Neon, { Name = "Lamp", CastShadow = false })
	Kit.pointLight(head, 34, 0.9, C.LightCold)

	-- Distant silhouettes (static). East, beyond the yard.
	local far = Kit.folder(env, "Silhouettes")
	local rng = Kit.rng(2027)
	for i = 1, 14 do
		local z = -120 + i * 22 + rng(-8, 8)
		EnvironmentBuilder.Fir(far, V(150 + rng(0, 40), -13, z), rng(22, 38), rng(-25, 25), C.Silhouette)
	end
	EnvironmentBuilder.Ridge(far, V(420, -13, -60), 520, 150, 60, 0, C.Mountain)
	EnvironmentBuilder.Ridge(far, V(520, -13, 220), 600, 210, 70, 8, Color3.fromRGB(52, 60, 76))
	-- North, behind the cabins.
	for i = 1, 12 do
		local x = -110 + i * 18 + rng(-6, 6)
		EnvironmentBuilder.Fir(far, V(x, -13, 92 + rng(0, 50)), rng(26, 42), rng(65, 115), C.Silhouette)
	end
	EnvironmentBuilder.Ridge(far, V(-40, -13, 380), 700, 170, 60, 90, C.Mountain)
	return env
end

return EnvironmentBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">ExpeditionZoneBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	ExpeditionZoneBuilder — the playable train and the night it travels through.

	Workspace.ExpeditionTrain (far from the terminal, z ≈ 4000):
	  TheLastTrain          locomotive + Mystery, Crew, Discovery, Explorer, Boarding
	  Scenery/Near|Mid      parts the client scrolls past the windows (+Z)
	  Scenery/Far           static ridges and one distant light
	  Bounds                zone volume (Zone = "Train") for client lighting / audio

	The train itself never moves: the world slides past it. That keeps physics
	trivial, players never slip, and it costs a single BulkMoveTo per frame on
	the client only while someone is aboard.
]]

local Kit = require(script.Parent.BuildKit)
local TrainBuilder = require(script.Parent.TrainBuilder)
local CarriageInteriors = require(script.Parent.CarriageInteriors)
local EnvironmentBuilder = require(script.Parent.EnvironmentBuilder)

local C, M = Kit.C, Kit.M
local rad = math.rad

local ExpeditionZoneBuilder = {}

ExpeditionZoneBuilder.ORIGIN = Vector3.new(0, 0, 4000)
ExpeditionZoneBuilder.SCENERY_Z0 = 3700 -- scenery lives in [Z0, Z0 + wrap]
ExpeditionZoneBuilder.SCENERY_WRAP = 1400
ExpeditionZoneBuilder.SLEEPER_Z0 = 4268
ExpeditionZoneBuilder.SLEEPER_WRAP = 336 -- multiple of the 4 stud spacing

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

function ExpeditionZoneBuilder.Build(parent)
	local zone = Kit.folder(parent, "ExpeditionTrain")
	local O = ExpeditionZoneBuilder.ORIGIN
	local T = CFrame.new(O)

	local train, info = TrainBuilder.Build(zone, T, {
		Name = "TheLastTrain",
		Carriages = { "Mystery", "Crew", "Discovery", "Explorer", "Boarding" },
		Interiors = true,
	})
	local refs = CarriageInteriors.Build(train, info)

	-- Static ground, ballast and rails (motion is invisible on uniform rails).
	local static = Kit.folder(zone, "Static")
	Kit.box(static, CFrame.new(), -900, -3.4, O.Z - 700, 900, -2.4, O.Z + 1100, Color3.fromRGB(30, 36, 34), M.Ground, { Name = "Ground", CastShadow = false })
	Kit.box(static, CFrame.new(), -7, -2.4, O.Z - 400, 7, -0.55, O.Z + 700, Color3.fromRGB(54, 52, 50), M.Pebble, { Name = "Ballast" })
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(static, CFrame.new(), sx * 4 - 0.25, -0.55, O.Z - 400, sx * 4 + 0.25, 0, O.Z + 700, Color3.fromRGB(96, 94, 92), M.Metal, { Name = "Rail" })
	end

	-- Scrolling scenery.
	local scenery = Kit.folder(zone, "Scenery")
	local near = Kit.folder(scenery, "Near")
	local mid = Kit.folder(scenery, "Mid")
	local far = Kit.folder(scenery, "Far")
	near:SetAttribute("Layer", "Near")
	mid:SetAttribute("Layer", "Mid")
	local Z0, WRAP = ExpeditionZoneBuilder.SCENERY_Z0, ExpeditionZoneBuilder.SCENERY_WRAP
	local rng = Kit.rng(4111)

	-- Sleepers behind the train, seen from the observation deck.
	local sleepers = Kit.folder(scenery, "Sleepers")
	sleepers:SetAttribute("Layer", "Near")
	sleepers:SetAttribute("WrapZ0", ExpeditionZoneBuilder.SLEEPER_Z0)
	sleepers:SetAttribute("WrapLength", ExpeditionZoneBuilder.SLEEPER_WRAP)
	for z = ExpeditionZoneBuilder.SLEEPER_Z0, ExpeditionZoneBuilder.SLEEPER_Z0 + ExpeditionZoneBuilder.SLEEPER_WRAP - 4, 4 do
		Kit.box(sleepers, CFrame.new(), -6, -0.75, z - 0.6, 6, -0.45, z + 0.6, C.WoodDark, M.Wood, { Name = "Sleeper", CastShadow = false })
	end

	-- Telegraph poles: the clearest sense of speed from a window.
	for z = Z0, Z0 + WRAP - 70, 70 do
		Kit.cylY(near, 15, 0.6, CFrame.new(19, 5, z), C.WoodDark, M.Wood, { Name = "Pole", CastShadow = false })
		Kit.part(near, V(0.4, 0.4, 4.6), CFrame.new(19, 11.8, z), C.WoodDark, M.Wood, { Name = "Crossarm", CastShadow = false })
	end
	-- Near firs and boulders on both sides.
	for i = 1, 26 do
		local z = Z0 + (i - 0.5) * WRAP / 26 + rng(-15, 15)
		local side = (i % 2 == 0) and 1 or -1
		EnvironmentBuilder.Fir(near, V(side * rng(26, 60), -2.4, z), rng(18, 34), rng(-30, 30), C.Foliage)
	end
	for i = 1, 10 do
		local z = Z0 + rng(0, WRAP)
		local d = rng(4, 9)
		Kit.ball(near, d, CFrame.new((i % 2 == 0 and 1 or -1) * rng(20, 45), -2.4 + d * 0.15, z), Color3.fromRGB(62, 64, 66), M.Rock, { Name = "Boulder", CastShadow = false })
	end
	-- Mid-distance forest.
	for i = 1, 30 do
		local z = Z0 + (i - 0.5) * WRAP / 30 + rng(-20, 20)
		local side = (i % 2 == 0) and 1 or -1
		EnvironmentBuilder.Fir(mid, V(side * rng(80, 190), -2.4, z), rng(30, 52), rng(-30, 30), C.Silhouette)
	end
	-- Far ridges stay put: the horizon should feel unreachable.
	for _, r in ipairs({ { -420, 3600, 900, 180 }, { 460, 3900, 1000, 230 }, { -520, 4500, 800, 160 }, { 400, 4700, 900, 200 } }) do
		EnvironmentBuilder.Ridge(far, V(r[1], -2.4, r[2]), r[3], r[4], 90, 0, C.Mountain)
	end
	-- One distant tower with a single cold light. Nobody on the train mentions it.
	Kit.part(far, V(8, 120, 8), CFrame.new(-380, 57, 3720), C.Silhouette, M.Smooth, { Name = "DistantTower", CastShadow = false })
	Kit.ball(far, 3.5, CFrame.new(-380, 119, 3720), Color3.fromRGB(150, 190, 236), M.Neon, { Name = "DistantLight", CastShadow = false })

	-- Zone volume for the client (lighting, ambience, camera).
	local bounds = Kit.marker(zone, "Bounds", V(60, 70, info.Length + 30), CFrame.new(O.X, 20, O.Z + info.Length / 2))
	bounds:SetAttribute("Zone", "Train")
	Kit.tag(bounds, "ZoneBounds")

	return zone, {
		Train = train,
		Spawns = refs.Spawns,
		ExitDoor = refs.ExitDoor,
		MysteryDoor = refs.MysteryDoor,
		ConductorCFrame = refs.ConductorCFrame,
	}
end

return ExpeditionZoneBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">Graphics</string><ProtectedString name="Source"><![CDATA[--[[
	Graphics
	Asset-free artwork drawn with GUI frames on SurfaceGuis: travel posters,
	route maps, sign plates. No uploaded images are needed, so the place
	works the moment it is opened and nothing can fail to load.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent.BuildKit)
local Emblem = require(ReplicatedStorage.Shared.Modules.Emblem)

local C = Kit.C

local Graphics = {}

local function U(xs, xo, ys, yo)
	return UDim2.new(xs, xo or 0, ys, yo or 0)
end

local function fill(g, color)
	return Kit.frame(g, { Size = U(1, 0, 1, 0), BackgroundTransparency = 0, BackgroundColor3 = color, Name = "Background" })
end

local function text(parent, str, x, y, w, h, color, font, extra)
	local props = { Position = U(x, 0, y, 0), Size = U(w, 0, h, 0), TextColor3 = color, Font = font or Enum.Font.Oswald }
	if extra then
		for k, v in pairs(extra) do
			props[k] = v
		end
	end
	return Kit.label(parent, str, props)
end

local function rect(parent, x, y, w, h, color, rotation, transparency)
	return Kit.frame(parent, {
		Position = U(x, 0, y, 0),
		Size = U(w, 0, h, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = transparency or 0,
		BackgroundColor3 = color,
		Rotation = rotation or 0,
	})
end

local function circle(parent, x, y, d, color, transparency)
	local f = rect(parent, x, y, d, d, color, 0, transparency)
	Kit.corner(f, 0.5, 0)
	return f
end

-- Dark sign plate with brass border: title + optional subtitle.
function Graphics.signPlate(g, title, subtitle, opts)
	opts = opts or {}
	fill(g, opts.Background or C.Charcoal)
	local border = Kit.frame(g, { Size = U(1, -10, 1, -10), Position = U(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5) })
	Kit.stroke(border, opts.Border or C.Brass, opts.BorderThickness or 3, 0.15)
	if subtitle and subtitle ~= "" then
		text(g, title, 0.06, 0.1, 0.88, 0.5, opts.TitleColor or C.Parchment, opts.TitleFont or Enum.Font.Oswald)
		text(g, subtitle, 0.1, 0.62, 0.8, 0.26, opts.SubtitleColor or C.Brass, Enum.Font.Oswald)
	else
		text(g, title, 0.06, 0.16, 0.88, 0.68, opts.TitleColor or C.Parchment, opts.TitleFont or Enum.Font.Oswald)
	end
end

function Graphics.poster(g, design)
	if design == "Vale" then
		fill(g, Color3.fromRGB(56, 66, 90))
		circle(g, 0.5, 0.34, 0.34, Color3.fromRGB(232, 170, 102))
		local hills = Kit.frame(g, { Position = U(0, 0, 0.42, 0), Size = U(1, 0, 0.3, 0), ClipsDescendants = true })
		rect(hills, 0.28, 0.95, 0.62, 0.62, Color3.fromRGB(36, 44, 62), 45)
		rect(hills, 0.72, 1.05, 0.7, 0.7, Color3.fromRGB(30, 36, 52), 45)
		Kit.frame(g, { Position = U(0, 0, 0.72, 0), Size = U(1, 0, 0.28, 0), BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(24, 26, 32) })
		text(g, "THE SUNKEN VALE", 0.08, 0.75, 0.84, 0.11, C.Parchment)
		text(g, "EXPEDITIONS NOW BOARDING", 0.16, 0.87, 0.68, 0.06, Color3.fromRGB(232, 170, 102))
	elseif design == "Dusk" then
		fill(g, C.BurgundyDeep)
		Emblem.Create(g, { Size = U(0.62, 0, 0.42, 0), Position = U(0.5, 0, 0.36, 0), Color = Color3.fromRGB(214, 172, 104), Thickness = 4 })
		text(g, "EXPEDITIONS", 0.1, 0.66, 0.8, 0.1, C.Parchment)
		text(g, "DEPART AT DUSK", 0.1, 0.76, 0.8, 0.08, C.Parchment)
		text(g, "THE LAST TRAIN", 0.25, 0.88, 0.5, 0.05, Color3.fromRGB(214, 172, 104))
	elseif design == "Fog" then
		fill(g, Color3.fromRGB(88, 100, 112))
		for i = 0, 5 do
			rect(g, 0.5 + (i % 2) * 0.08 - 0.04, 0.16 + i * 0.085, 0.7 - (i % 3) * 0.12, 0.022, Color3.fromRGB(176, 186, 194), 0, 0.35)
		end
		rect(g, 0.38, 0.5, 0.28, 0.07, Color3.fromRGB(30, 32, 38))
		rect(g, 0.6, 0.5, 0.16, 0.06, Color3.fromRGB(30, 32, 38))
		rect(g, 0.27, 0.455, 0.035, 0.06, Color3.fromRGB(30, 32, 38))
		circle(g, 0.25, 0.49, 0.025, Color3.fromRGB(238, 196, 128))
		text(g, "MIND THE FOG", 0.1, 0.68, 0.8, 0.11, Color3.fromRGB(28, 30, 36))
		text(g, "STAY WITH YOUR CREW", 0.18, 0.8, 0.64, 0.06, Color3.fromRGB(44, 46, 52))
	else -- "Line"
		fill(g, C.Parchment)
		text(g, "THE HOLLOW LINE", 0.08, 0.06, 0.84, 0.1, C.Ink)
		rect(g, 0.3, 0.55, 0.018, 0.62, C.Burgundy)
		local stops = { { 0.3, "TERMINAL" }, { 0.45, "ASHFORD HALT" }, { 0.6, "GREYWATER" }, { 0.75, "?" } }
		for _, s in ipairs(stops) do
			circle(g, 0.3, s[1], 0.06, C.Burgundy)
			circle(g, 0.3, s[1], 0.03, C.Parchment)
			text(g, s[2], 0.38, s[1] - 0.03, 0.55, 0.06, C.Ink, Enum.Font.Oswald, { TextXAlignment = Enum.TextXAlignment.Left })
		end
		text(g, "ALL STATIONS UNCONFIRMED", 0.12, 0.9, 0.76, 0.05, C.Burgundy)
	end
end

-- Large wall mural: the routes that are known, fading into what is not.
function Graphics.routeMap(g)
	fill(g, C.Parchment)
	local unknown = Kit.frame(g, { Position = U(0.62, 0, 0, 0), Size = U(0.38, 0, 1, 0), BackgroundTransparency = 0.55, BackgroundColor3 = Color3.fromRGB(150, 134, 108) })
	for i = 1, 5 do
		Kit.frame(unknown, { Position = U(0, 0, i / 6, 0), Size = U(1, 0, 0.004, 0), BackgroundTransparency = 0.5, BackgroundColor3 = C.Ink })
		Kit.frame(unknown, { Position = U(i / 6, 0, 0, 0), Size = U(0.004, 0, 1, 0), BackgroundTransparency = 0.5, BackgroundColor3 = C.Ink })
	end
	-- coastline
	local coast = { { 0.04, 0.82, 0.16, -18 }, { 0.17, 0.74, 0.14, -40 }, { 0.27, 0.62, 0.12, -10 }, { 0.37, 0.6, 0.12, 25 }, { 0.47, 0.67, 0.12, -5 }, { 0.57, 0.64, 0.1, -35 } }
	for _, s in ipairs(coast) do
		rect(g, s[1] + s[3] / 2, s[2], s[3], 0.012, Color3.fromRGB(86, 96, 108), s[4])
	end
	-- the route, dashed, stations as rings
	local route = { { 0.12, 0.48 }, { 0.26, 0.4 }, { 0.4, 0.44 }, { 0.54, 0.34 }, { 0.66, 0.3 }, { 0.78, 0.22 } }
	for i = 1, #route - 1 do
		local a, b = route[i], route[i + 1]
		local dx, dy = (b[1] - a[1]), (b[2] - a[2]) * 0.55
		local len = math.sqrt(dx * dx + dy * dy)
		local angle = math.deg(math.atan2(dy, dx))
		local alpha = i >= 4 and 0.45 + (i - 4) * 0.25 or 0
		for k = 0, 3 do
			local t = (k + 0.5) / 4
			rect(g, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t, len / 6, 0.012, C.Burgundy, angle, alpha)
		end
	end
	local names = { "TERMINAL", "ASHFORD HALT", "GREYWATER", "THE HOLLOW", "", "" }
	for i, p in ipairs(route) do
		if i <= 4 then
			circle(g, p[1], p[2], 0.036, C.Burgundy)
			circle(g, p[1], p[2], 0.018, C.Parchment)
			text(g, names[i], p[1] - 0.08, p[2] + 0.04, 0.16, 0.05, C.Ink)
		end
	end
	text(g, "?", 0.8, 0.12, 0.06, 0.12, C.Burgundy, Enum.Font.Merriweather)
	text(g, "KNOWN ROUTES", 0.04, 0.05, 0.4, 0.09, C.Ink, Enum.Font.Merriweather, { TextXAlignment = Enum.TextXAlignment.Left })
	text(g, "SURVEYED BY THE EXPEDITION OFFICE", 0.04, 0.14, 0.4, 0.04, C.Burgundy, Enum.Font.Oswald, { TextXAlignment = Enum.TextXAlignment.Left })
	text(g, "UNCHARTED", 0.66, 0.88, 0.3, 0.06, C.Ink, Enum.Font.Oswald)
	-- compass rose
	circle(g, 0.12, 0.2, 0.08, C.Ink, 0.6)
	rect(g, 0.12, 0.2, 0.01, 0.16, C.Ink)
	rect(g, 0.12, 0.2, 0.05, 0.005, C.Ink)
	text(g, "N", 0.105, 0.04, 0.03, 0.05, C.Ink)
end

-- Small table-top map (expedition planning).
function Graphics.tableMap(g, seed)
	local rng = Kit.rng(seed or 7)
	fill(g, Color3.fromRGB(214, 196, 158))
	for _ = 1, 9 do
		rect(g, rng(0.1, 0.9), rng(0.15, 0.85), rng(0.08, 0.22), 0.01, Color3.fromRGB(94, 104, 112), rng(-60, 60), 0.2)
	end
	local x, y = 0.15, rng(0.3, 0.7)
	for _ = 1, 6 do
		local nx, ny = x + rng(0.08, 0.14), math.max(0.15, math.min(0.85, y + rng(-0.15, 0.15)))
		local dx, dy = nx - x, ny - y
		rect(g, (x + nx) / 2, (y + ny) / 2, math.sqrt(dx * dx + dy * dy), 0.012, C.Burgundy, math.deg(math.atan2(dy, dx)))
		circle(g, nx, ny, 0.03, C.Burgundy)
		x, y = nx, ny
	end
	circle(g, 0.85, 0.2, 0.1, C.Ink, 0.7)
end

return Graphics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">LightingBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	LightingBuilder
	Applies the Terminal lighting preset and creates the post-processing
	effects once. Effects are named so the client can find and blend them.

	Lighting.Technology is not scriptable; the place file ships with
	ShadowMap (good quality / mobile cost balance). Change it in Studio if needed.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local LightingPresets = require(ReplicatedStorage.Shared.Config.LightingPresets)

local LightingBuilder = {}

local function ensure(className, name)
	local existing = Lighting:FindFirstChild(name)
	if existing and existing:IsA(className) then
		return existing
	end
	local inst = Instance.new(className)
	inst.Name = name
	inst.Parent = Lighting
	return inst
end

function LightingBuilder.Apply(preset, atmosphere, bloom, colorCorrection)
	for k, v in pairs(preset.Lighting) do
		Lighting[k] = v
	end
	for k, v in pairs(preset.Atmosphere) do
		atmosphere[k] = v
	end
	for k, v in pairs(preset.Bloom) do
		bloom[k] = v
	end
	for k, v in pairs(preset.ColorCorrection) do
		colorCorrection[k] = v
	end
end

function LightingBuilder.Build()
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.3
	Lighting.GeographicLatitude = 38

	local atmosphere = ensure("Atmosphere", "LastTrainAtmosphere")
	local bloom = ensure("BloomEffect", "LastTrainBloom")
	local colorCorrection = ensure("ColorCorrectionEffect", "LastTrainColor")

	LightingBuilder.Apply(LightingPresets.Terminal, atmosphere, bloom, colorCorrection)
end

return LightingBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">LobbyBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	LobbyBuilder — THE EXPEDITION TERMINAL

	Layout (top view, +Z is north, players spawn facing north):

	   z=66  ┌──────────── north wall (high windows) ────────────┐
	         │  [SOLO] [ DUO ] [ SQUAD ] [   CREW   ]   lower     │ east wall:
	         │                                         platform   │ tall arched
	   z=27  │            ═══ grand stairs ═══          (y=-6)    │ windows onto
	   z=16  │------------ balustrade -------------------------- │ the train yard
	         │  outfitters            (clock overhead)            │ (teaser train)
	         │  route map   kiosk+Keeper  info board   view bay    │
	         │                   ║ guidance path ║                │
	  z=-52  │                   ◎ spawn medallion                │
	  z=-64  └──────────── south wall: grand entrance ───────────┘
	        x=-44                                              x=44

	The concourse floor is y=0, the lower platform y=-6.
	Sightline from spawn: path -> clock -> platform sign -> cabins.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent.BuildKit)
local Props = require(script.Parent.Props)
local Graphics = require(script.Parent.Graphics)
local Emblem = require(ReplicatedStorage.Shared.Modules.Emblem)
local CabinDefinitions = require(ReplicatedStorage.Shared.Config.CabinDefinitions)

local C, M = Kit.C, Kit.M
local rad = math.rad

local LobbyBuilder = {}

local O = CFrame.new()
local HX = 44
local CZ0, CZ1 = -64, 16
local PZ0, PZ1 = 27, 66
local PY = -6
local ROOF = { { -44, 30 }, { -34, 37 }, { -20, 42 }, { 0, 44 }, { 20, 42 }, { 34, 37 }, { 44, 30 } }
local TRUSS_Z = { -56, -40, -24, -8, 8, 24, 40, 56 }

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local function roofY(x)
	for i = 1, #ROOF - 1 do
		local a, b = ROOF[i], ROOF[i + 1]
		if x >= a[1] and x <= b[1] then
			local t = (x - a[1]) / (b[1] - a[1])
			return a[2] + (b[2] - a[2]) * t
		end
	end
	return 30
end

-- FLOORS & STAIRS --------------------------------------------------------------
local function buildFloors(model)
	local floors = Kit.folder(model, "Floors")
	Kit.box(floors, O, -HX, PY, CZ0, HX, 0, CZ1, C.Floor, M.Slate, { Name = "ConcourseFloor" })
	Kit.box(floors, O, -HX, PY - 7, PZ0, HX, PY, PZ1, C.StoneDark, M.Slate, { Name = "PlatformFloor" })

	-- Guidance: a lighter stone runner with brass inlay leads from the spawn
	-- medallion straight to the stairs. No arrows needed.
	Kit.box(floors, O, -5, 0, -58, 5, 0.06, CZ1, C.StoneLight, M.Concrete, { Name = "GuidePath" })
	Kit.box(floors, O, -5.3, 0, -58, -5, 0.08, CZ1, C.Brass, M.Metal, { Name = "GuideInlay" })
	Kit.box(floors, O, 5, 0, -58, 5.3, 0.08, CZ1, C.Brass, M.Metal, { Name = "GuideInlay" })
	-- Border band where floor meets the walls.
	Kit.box(floors, O, -HX, 0, CZ0, HX, 0.04, CZ0 + 3, C.StoneDark, M.Slate, { Name = "Border" })

	-- Boardwalk in front of the cabins.
	Kit.box(floors, O, -41, PY, 39, 41, PY + 0.06, 46, C.Wood, M.Planks, { Name = "Boardwalk" })

	-- Grand stairs (z 16 -> 27, 0.5 stud rise per step).
	local stairs = Kit.folder(model, "Stairs")
	for i = 1, 11 do
		Kit.box(stairs, O, -12, PY, CZ1 + i - 1, 12, -0.5 * i, CZ1 + i, C.StoneLight, M.Slate, { Name = "Step" .. i })
	end
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * 12.6
		Kit.wedge(stairs, V(1.2, 6, 11), CFrame.new(x, PY + 4, CZ1 + 5.5) * CFrame.Angles(0, rad(180), 0), C.Stone, M.Slate, { Name = "StairCheek" })
		Kit.box(stairs, O, x - 0.6, PY, CZ1, x + 0.6, PY + 1, CZ1 + 11, C.Stone, M.Slate, { Name = "StairCheekBase" })
		Kit.box(stairs, O, x - 0.6, 0, CZ1 - 1.2, x + 0.6, 1.2, CZ1, C.Stone, M.Slate, { Name = "StairCheekTop" })
		Kit.beam(stairs, V(x, 2.5, CZ1 - 0.4), V(x, PY + 2.4, CZ1 + 11), 0.35, 0.35, C.Brass, M.Metal, { Name = "Handrail" })
		Kit.cylY(stairs, 3.2, 0.9, CFrame.new(x, 1.6, CZ1 - 0.6), C.Iron, M.Metal, { Name = "Newel" })
		Kit.ball(stairs, 1.0, CFrame.new(x, 3.4, CZ1 - 0.6), C.Brass, M.Metal, { Name = "NewelCap" })
	end

	-- Balustrade along the concourse edge.
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = sx * 13.2, sx * HX
		Kit.box(stairs, O, math.min(x0, x1), 0, CZ1 - 0.5, math.max(x0, x1), 1, CZ1 + 0.5, C.Stone, M.Slate, { Name = "BalustradeBase" })
		Kit.box(stairs, O, math.min(x0, x1), 3.0, CZ1 - 0.15, math.max(x0, x1), 3.3, CZ1 + 0.15, C.Brass, M.Metal, { Name = "BalustradeRail" })
		for k = 0, 5 do
			local x = x0 + (x1 - x0) * k / 5
			Kit.cylY(stairs, 2.1, 0.3, CFrame.new(x, 2.05, CZ1), C.Iron, M.Metal, { Name = "BalustradePost" })
		end
	end
end

-- WALLS ------------------------------------------------------------------------
local function glassPane(parent, cf, size)
	return Kit.part(parent, size, cf, C.Glass, M.Glass, { Name = "WindowGlass", Transparency = 0.62, CastShadow = false })
end

local function eastWindows(walls)
	local holes = {}
	local windows = {}
	for _, zc in ipairs({ -52, -36, -20, -4 }) do
		table.insert(holes, { zc - 5, zc + 5, 4, 22 })
		table.insert(windows, { zc, 4 })
	end
	for _, zc in ipairs({ 36, 52 }) do
		table.insert(holes, { zc - 5, zc + 5, -2, 22 })
		table.insert(windows, { zc, -2 })
	end
	Kit.wallZ(walls, O, HX + 1, 2, CZ0 - 2, PZ1 + 2, -13, 30, holes, C.Stone, M.Brick, { Name = "EastWall" })
	for _, w in ipairs(windows) do
		local zc, y0 = w[1], w[2]
		-- arched top corners
		Kit.wedge(walls, V(2, 2.5, 2.5), CFrame.new(HX + 1, 20.75, zc - 3.75) * CFrame.Angles(rad(180), 0, 0), C.Stone, M.Brick, { Name = "ArchCorner" })
		Kit.wedge(walls, V(2, 2.5, 2.5), CFrame.new(HX + 1, 20.75, zc + 3.75) * CFrame.Angles(0, 0, rad(180)), C.Stone, M.Brick, { Name = "ArchCorner" })
		glassPane(walls, CFrame.new(HX + 1, (y0 + 22) / 2, zc), V(0.2, 22 - y0, 10))
		Kit.box(walls, O, HX + 0.6, y0, zc - 0.15, HX + 1.4, 22, zc + 0.15, C.Iron, M.Metal, { Name = "Mullion" })
		for _, t in ipairs({ 0.36, 0.7 }) do
			local y = y0 + (22 - y0) * t
			Kit.box(walls, O, HX + 0.6, y - 0.15, zc - 5, HX + 1.4, y + 0.15, zc + 5, C.Iron, M.Metal, { Name = "Transom" })
		end
		Kit.box(walls, O, HX - 0.8, y0 - 0.3, zc - 5.6, HX, y0, zc + 5.6, C.StoneLight, M.Slate, { Name = "Sill" })
	end
	-- Pilasters between bays add depth to the long wall.
	for _, z in ipairs({ -60, -44, -28, -12, 4, 28, 44, 60 }) do
		local y0 = z > CZ1 and PY or 0
		Kit.box(walls, O, HX - 1.2, y0, z - 1, HX, 30, z + 1, C.StoneLight, M.Slate, { Name = "Pilaster" })
	end
end

local function westWall(walls)
	local holes = {
		{ -2, 12, 0, 10 }, -- outfitters alcove
		{ -56, -48, 17, 25 },
		{ -16, -8, 17, 25 },
		{ 48, 56, 17, 25 },
	}
	Kit.wallZ(walls, O, -HX - 1, 2, CZ0 - 2, PZ1 + 2, -13, 30, holes, C.Stone, M.Brick, { Name = "WestWall" })
	for _, zc in ipairs({ -52, -12, 52 }) do
		glassPane(walls, CFrame.new(-HX - 1, 21, zc), V(0.2, 8, 8))
		Kit.box(walls, O, -HX - 1.4, 20.85, zc - 4, -HX - 0.6, 21.15, zc + 4, C.Iron, M.Metal, { Name = "Transom" })
	end
	for _, z in ipairs({ -60, -46, -20, -4, 14, 28, 44, 60 }) do
		local y0 = z > CZ1 and PY or 0
		Kit.box(walls, O, -HX, y0, z - 1, -HX + 1.2, 30, z + 1, C.StoneLight, M.Slate, { Name = "Pilaster" })
	end

	-- Future cosmetic area: a closed outfitters shop front. Shutter down,
	-- no interaction yet — it simply exists in the world.
	local alcove = Kit.model(walls, "OutfittersAlcove")
	Kit.box(alcove, O, -52, PY, -2, -46, 0, 12, C.Floor, M.Slate, { Name = "AlcoveFloor" })
	Kit.box(alcove, O, -53, -1, -3, -52, 12, 13, C.Stone, M.Brick, { Name = "AlcoveBack" })
	Kit.box(alcove, O, -52, -1, -3, -46, 12, -2, C.Stone, M.Brick, { Name = "AlcoveSide" })
	Kit.box(alcove, O, -52, -1, 12, -46, 12, 13, C.Stone, M.Brick, { Name = "AlcoveSide" })
	Kit.box(alcove, O, -53, 10, -3, -46, 12, 13, C.Stone, M.Brick, { Name = "AlcoveCeiling" })
	local shutter = Kit.box(alcove, O, -44.9, 0, -2, -44.5, 9, 12, C.BlueSteelDark, M.Corroded, { Name = "Shutter" })
	local sg = Kit.surface(shutter, Enum.NormalId.Right, 20)
	for i = 0, 17 do
		Kit.frame(sg, { Position = UDim2.new(0, 0, i / 18, 0), Size = UDim2.new(1, 0, 0.012, 0), BackgroundTransparency = 0.3, BackgroundColor3 = C.Charcoal })
	end
	Kit.cylZ(alcove, 14.4, 1.4, CFrame.new(-44.4, 9.6, 5), C.Iron, M.Metal, { Name = "ShutterDrum" })
	local sign = Kit.box(alcove, O, -44, 10.6, 0.5, -43.7, 12.8, 9.5, C.Charcoal, M.Smooth, { Name = "OutfittersSign" })
	Graphics.signPlate(Kit.surface(sign, Enum.NormalId.Right, 40), "EXPEDITION OUTFITTERS", "", { TitleColor = C.Brass })
end

local function southWall(walls)
	Kit.wallX(walls, O, CZ0 - 1, 2, -HX - 2, HX + 2, -13, 30, { { -7, 7, 0, 15 } }, C.Stone, M.Brick, { Name = "SouthWall" })
	-- arched corners (right angle at the top outer corner of the opening)
	Kit.wedge(walls, V(2, 3, 3), CFrame.new(-5.5, 13.5, CZ0 - 1) * CFrame.Angles(0, rad(90), 0) * CFrame.Angles(rad(180), 0, 0), C.Stone, M.Brick, { Name = "ArchCorner" })
	Kit.wedge(walls, V(2, 3, 3), CFrame.new(5.5, 13.5, CZ0 - 1) * CFrame.Angles(0, rad(-90), 0) * CFrame.Angles(rad(180), 0, 0), C.Stone, M.Brick, { Name = "ArchCorner" })

	-- The grand entrance stays shut: players arrived by the terminal's own means.
	local doors = Kit.model(walls, "GrandEntrance")
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(doors, O, sx < 0 and -7 or 0.05, 0, CZ0 - 0.9, sx < 0 and -0.05 or 7, 15, CZ0 - 0.3, C.WoodDark, M.Wood, { Name = "DoorLeaf" })
		for _, y in ipairs({ 3, 8, 12.5 }) do
			Kit.box(doors, O, sx < 0 and -6.6 or 0.4, y, CZ0 - 0.3, sx < 0 and -0.4 or 6.6, y + 0.3, CZ0 - 0.2, C.BrassDark, M.Metal, { Name = "DoorStrap" })
		end
	end
	Kit.box(doors, O, -8, 15, CZ0 - 0.4, 8, 16, CZ0 + 0.2, C.StoneLight, M.Slate, { Name = "Lintel" })
	local disc = Kit.cylZ(doors, 0.3, 4.2, CFrame.new(0, 7.5, CZ0 - 0.1), C.Brass, M.Metal, { Name = "EntranceRoundel" })
	Emblem.Create(Kit.surface(disc, Enum.NormalId.Left, 60), { Color = C.Ink, Thickness = 5, Size = UDim2.new(0.9, 0, 0.9, 0) })

	-- Station name over the entrance (seen when players turn around).
	local plate = Kit.box(walls, O, -16, 18, CZ0 - 0.3, 16, 23.5, CZ0 + 0.1, C.Charcoal, M.Smooth, { Name = "StationNameplate" })
	Graphics.signPlate(Kit.surface(plate, Enum.NormalId.Back, 30), "THE LAST TRAIN", "EXPEDITION TERMINAL", { TitleFont = Enum.Font.Merriweather, TitleColor = C.Parchment })
end

local function northWall(walls)
	local holes = {}
	for _, xc in ipairs({ -30, -10, 10, 30 }) do
		table.insert(holes, { xc - 5, xc + 5, 12, 26 })
	end
	Kit.wallX(walls, O, PZ1 + 1, 2, -HX - 2, HX + 2, -13, 30, holes, C.Stone, M.Brick, { Name = "NorthWall" })
	for _, xc in ipairs({ -30, -10, 10, 30 }) do
		glassPane(walls, CFrame.new(xc, 19, PZ1 + 1), V(10, 14, 0.2))
		Kit.box(walls, O, xc - 0.15, 12, PZ1 + 0.6, xc + 0.15, 26, PZ1 + 1.4, C.Iron, M.Metal, { Name = "Mullion" })
		Kit.box(walls, O, xc - 5, 18.85, PZ1 + 0.6, xc + 5, 19.15, PZ1 + 1.4, C.Iron, M.Metal, { Name = "Transom" })
	end
end

local function gable(walls, z, roundWindow)
	local t = 2
	Kit.box(walls, O, -34, 30, z - t / 2, 34, 37, z + t / 2, C.Stone, M.Brick, { Name = "Gable" })
	Kit.box(walls, O, -20, 37, z - t / 2, 20, 42, z + t / 2, C.Stone, M.Brick, { Name = "Gable" })
	Kit.triXY(walls, O, -HX - 2, -34, 28.6, 37, z, t, C.Stone, M.Brick, { Name = "GableTri" })
	Kit.triXY(walls, O, -34, -20, 37, 42, z, t, C.Stone, M.Brick, { Name = "GableTri" })
	Kit.triXY(walls, O, -20, 0, 42, 44, z, t, C.Stone, M.Brick, { Name = "GableTri" })
	Kit.triXY(walls, O, 20, 0, 42, 44, z, t, C.Stone, M.Brick, { Name = "GableTri" })
	Kit.triXY(walls, O, 34, 20, 37, 42, z, t, C.Stone, M.Brick, { Name = "GableTri" })
	Kit.triXY(walls, O, HX + 2, 34, 28.6, 37, z, t, C.Stone, M.Brick, { Name = "GableTri" })
	if roundWindow then
		Kit.cylZ(walls, t + 0.3, 8.4, CFrame.new(0, 36, z), C.Iron, M.Metal, { Name = "RoundWindowRim" })
		Kit.cylZ(walls, t + 0.5, 7.2, CFrame.new(0, 36, z), Color3.fromRGB(58, 74, 98), M.Glass, { Name = "RoundWindow" })
	end
end

-- ROOF -------------------------------------------------------------------------
local function buildRoof(model)
	local roof = Kit.folder(model, "Roof")
	local z0, z1 = CZ0 - 3, PZ1 + 3
	for i = 1, #ROOF - 1 do
		local a, b = ROOF[i], ROOF[i + 1]
		local xa, ya, xb, yb = a[1], a[2], b[1], b[2]
		if i == 1 then
			xa, ya = xa - 3, ya - 2.1
		elseif i == #ROOF - 1 then
			xb, yb = xb + 3, yb - 2.1
		end
		local glass = (i == 3 or i == 4)
		if glass then
			Kit.slabXY(roof, O, xa, ya, xb, yb, z0, z1, 0.4, Color3.fromRGB(70, 88, 110), M.Glass, { Name = "Skylight", Transparency = 0.45, CastShadow = false })
		else
			Kit.slabXY(roof, O, xa, ya, xb, yb, z0, z1, 1, C.WoodDark, M.Planks, { Name = "RoofSlab" })
		end
	end
	-- Ridge cap and glazing bars on the skylight.
	Kit.box(roof, O, -0.8, 44, z0, 0.8, 44.8, z1, C.Iron, M.Metal, { Name = "Ridge" })
	for z = z0 + 6, z1 - 6, 13 do
		Kit.beam(roof, V(-20, 41.95, z), V(0, 43.95, z), 0.3, 0.3, C.Iron, M.Metal, { Name = "GlazingBar" })
		Kit.beam(roof, V(0, 43.95, z), V(20, 41.95, z), 0.3, 0.3, C.Iron, M.Metal, { Name = "GlazingBar" })
	end

	-- Riveted arch trusses: the hall's rhythm and its strongest silhouette.
	for _, z in ipairs(TRUSS_Z) do
		local truss = Kit.model(roof, "Truss")
		for i = 1, #ROOF - 1 do
			local a, b = ROOF[i], ROOF[i + 1]
			Kit.beam(truss, V(a[1] * 0.985, a[2] - 0.9, z), V(b[1] * 0.985, b[2] - 0.9, z), 0.8, 1.4, C.Iron, M.Metal, { Name = "Rafter" })
		end
		Kit.beam(truss, V(-43.4, 30.3, z), V(43.4, 30.3, z), 0.4, 0.4, C.Iron, M.Metal, { Name = "Tie" })
		for _, x in ipairs({ -20, 0, 20 }) do
			Kit.beam(truss, V(x, 30.3, z), V(x, roofY(x) - 1.6, z), 0.3, 0.3, C.Iron, M.Metal, { Name = "Hanger" })
		end
		for _, sx in ipairs({ -1, 1 }) do
			Kit.beam(truss, V(sx * 43.2, 25, z), V(sx * 37, 33.2, z), 0.6, 0.9, C.Iron, M.Metal, { Name = "KneeBrace" })
			Kit.box(truss, O, sx * 43.9 - 0.9, 23.5, z - 1.1, sx * 43.9 + 0.9, 25, z + 1.1, C.StoneLight, M.Slate, { Name = "Corbel" })
		end
		Kit.cylZ(truss, 0.9, 1.6, CFrame.new(0, 30.3, z), C.BrassDark, M.Metal, { Name = "TieBoss" })
	end
end

-- THE STATION CLOCK (central landmark) ----------------------------------------
local ROMAN = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI" }

local function clockFace(g)
	local dial = Kit.frame(g, { Name = "Dial", Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0, BackgroundColor3 = C.Parchment })
	Kit.corner(dial, 0.5, 0)
	local rim = Kit.frame(g, { Size = UDim2.new(0.93, 0, 0.93, 0), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5) })
	Kit.corner(rim, 0.5, 0)
	Kit.stroke(rim, C.Ink, 4, 0.1)
	for i = 0, 59 do
		local major = (i % 5 == 0)
		local a = rad(i * 6)
		local r = 0.415
		Kit.frame(g, {
			Name = "Tick",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5 + r * math.sin(a), 0, 0.5 - r * math.cos(a), 0),
			Size = major and UDim2.new(0.014, 0, 0.055, 0) or UDim2.new(0.006, 0, 0.028, 0),
			Rotation = i * 6,
			BackgroundTransparency = 0,
			BackgroundColor3 = C.Ink,
		})
	end
	-- A thirteenth mark, between XI and XII. Nobody mentions it.
	Kit.frame(g, {
		Name = "Mark13",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5 + 0.415 * math.sin(rad(345)), 0, 0.5 - 0.415 * math.cos(rad(345)), 0),
		Size = UDim2.new(0.01, 0, 0.05, 0),
		Rotation = 345,
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Burgundy,
	})
	for h = 1, 11 do
		local a = rad(h * 30)
		Kit.label(g, ROMAN[h], {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5 + 0.33 * math.sin(a), 0, 0.5 - 0.33 * math.cos(a), 0),
			Size = UDim2.new(0.13, 0, 0.085, 0),
			Font = Enum.Font.Merriweather,
			TextColor3 = C.Ink,
		})
	end
	Emblem.Create(g, { Size = UDim2.new(0.13, 0, 0.13, 0), Position = UDim2.new(0.5, 0, 0.17, 0), Color = C.Burgundy, Thickness = 2 })
	Kit.label(g, "THE LAST TRAIN", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.66, 0), Size = UDim2.new(0.3, 0, 0.04, 0), TextColor3 = C.Burgundy })

	local function hand(name, width, length, color)
		local holder = Kit.frame(g, { Name = name, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(width, 0, length * 2, 0) })
		Kit.frame(holder, { Name = "Blade", Size = UDim2.new(1, 0, 0.5, 0), BackgroundTransparency = 0, BackgroundColor3 = color })
		return holder
	end
	hand("HourHand", 0.03, 0.24, C.Ink)
	hand("MinuteHand", 0.02, 0.36, C.Ink)
	hand("SecondHand", 0.008, 0.39, C.Burgundy)
	local cap = Kit.frame(g, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0.05, 0, 0.05, 0), BackgroundTransparency = 0, BackgroundColor3 = C.Brass })
	Kit.corner(cap, 0.5, 0)
end

local function buildClock(model)
	local clock = Kit.model(model, "StationClock")
	local cx, cy, cz = 0, 21, -24
	local center = CFrame.new(cx, cy, cz)
	local drum = Kit.cylZ(clock, 2.4, 12, center, C.Charcoal, M.Metal, { Name = "Drum" })
	for _, s in ipairs({ -1, 1 }) do
		Kit.cylZ(clock, 0.4, 12.8, center * CFrame.new(0, 0, s * 1.2), C.Brass, M.Metal, { Name = "Bezel" })
		local face = Kit.cylZ(clock, 0.06, 11, center * CFrame.new(0, 0, s * 1.42), C.Parchment, M.Smooth, { Name = s < 0 and "FaceSouth" or "FaceNorth", CastShadow = false })
		clockFace(Kit.surface(face, s < 0 and Enum.NormalId.Right or Enum.NormalId.Left, 44, { LightInfluence = 0.25, Brightness = 1.2, MaxDistance = 400 }))
	end
	Kit.part(clock, V(3.2, 1.1, 2.8), center * CFrame.new(0, 6.4, 0), C.Iron, M.Metal, { Name = "Crown" })
	Kit.ball(clock, 1.3, center * CFrame.new(0, 7.4, 0), C.Brass, M.Metal, { Name = "Finial" })
	Kit.ball(clock, 1.0, center * CFrame.new(0, -6.3, 0), C.Brass, M.Metal, { Name = "Pendant" })
	for _, sx in ipairs({ -1, 1 }) do
		Kit.beam(clock, V(cx + sx * 1.2, cy + 6.9, cz), V(cx + sx * 1.2, 30.3, cz), 0.25, 0.25, C.Iron, M.Metal, { Name = "Rod" })
		-- small lamps on scrolled arms light the dials softly
		Kit.beam(clock, V(cx + sx * 5.6, cy + 2.6, cz), V(cx + sx * 7.4, cy + 4.6, cz), 0.3, 0.3, C.Iron, M.Metal, { Name = "LampArm" })
		Kit.cylY(clock, 0.4, 1.1, CFrame.new(cx + sx * 7.4, cy + 5.0, cz), C.Iron, M.Metal, { Name = "LampCap" })
		Kit.bulb(clock, 0.8, CFrame.new(cx + sx * 7.4, cy + 4.4, cz), C.BulbWarm, 18, 0.9)
	end
	Kit.soundEmitter(drum, "ClockTick")
	return clock
end

-- INFORMATION BOARD, KIOSK, SIGNS ------------------------------------------------
local function buildInfoBoard(model)
	local board = Kit.model(model, "InformationBoard")
	local f = CFrame.new(-15, 0, -34) * CFrame.Angles(0, rad(-35), 0)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.cylY(board, 11, 0.6, f * CFrame.new(sx * 6.6, 5.5, 0.1), C.Iron, M.Metal, { Name = "Post" })
		Kit.part(board, V(1.4, 0.6, 1.4), f * CFrame.new(sx * 6.6, 0.3, 0.1), C.Iron, M.Metal, { Name = "Foot" })
	end
	local panel = Kit.part(board, V(13, 6, 0.5), f * CFrame.new(0, 7, 0), C.Charcoal, M.Smooth, { Name = "BoardPanel" })
	Kit.part(board, V(14, 0.35, 2.2), f * CFrame.new(0, 10.4, -0.3) * CFrame.Angles(rad(-12), 0, 0), C.Iron, M.Metal, { Name = "Hood" })
	Kit.part(board, V(13.2, 0.25, 0.7), f * CFrame.new(0, 3.9, 0), C.Brass, M.Metal, { Name = "Trim" })
	Kit.bulb(board, 0.5, f * CFrame.new(-3.5, 10, -1.0), C.BulbWarm)
	Kit.bulb(board, 0.5, f * CFrame.new(3.5, 10, -1.0), C.BulbWarm, 14, 0.7)

	local g = Kit.surface(panel, Enum.NormalId.Front, 40, { LightInfluence = 0.35, Brightness = 1.1 })
	Kit.frame(g, { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(26, 25, 24) })
	Kit.stroke(Kit.frame(g, { Size = UDim2.new(1, -10, 1, -10), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5) }), C.Brass, 2, 0.3)
	Kit.label(g, "THE LAST TRAIN", { Position = UDim2.new(0.1, 0, 0.07, 0), Size = UDim2.new(0.8, 0, 0.2, 0), Font = Enum.Font.Merriweather, TextColor3 = C.Parchment })
	Kit.label(g, "EXPEDITIONS DEPART FROM THE LOWER PLATFORM", { Position = UDim2.new(0.08, 0, 0.29, 0), Size = UDim2.new(0.84, 0, 0.09, 0), TextColor3 = C.Brass })
	Kit.frame(g, { Position = UDim2.new(0.08, 0, 0.43, 0), Size = UDim2.new(0.84, 0, 0.006, 0), BackgroundTransparency = 0.4, BackgroundColor3 = C.Brass })
	for i, def in ipairs(CabinDefinitions) do
		local y = 0.48 + (i - 1) * 0.12
		Kit.label(g, def.DisplayName, { Name = "Row_" .. def.Id, Position = UDim2.new(0.1, 0, y, 0), Size = UDim2.new(0.5, 0, 0.09, 0), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.Parchment })
		Kit.label(g, "AVAILABLE", { Name = "Status_" .. def.Id, Position = UDim2.new(0.6, 0, y, 0), Size = UDim2.new(0.3, 0, 0.09, 0), TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = C.Brass })
	end
	local back = Kit.surface(panel, Enum.NormalId.Back, 30)
	Kit.frame(back, { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(26, 25, 24) })
	Emblem.Create(back, { Size = UDim2.new(0.34, 0, 0.74, 0), Color = C.BrassDark, Thickness = 3 })
	Kit.tag(board, "DeparturesBoard")
	return board
end

local function buildKiosk(model)
	local kiosk = Kit.model(model, "StationOffice")
	local f = CFrame.new(-23, 0, -23) * CFrame.Angles(0, rad(-90), 0)
	local function b(x0, y0, z0, x1, y1, z1, col, mat, name)
		return Kit.box(kiosk, f, x0, y0, z0, x1, y1, z1, col, mat, { Name = name })
	end
	b(-3.5, 0, -3, -3, 9, 3, C.Wood, M.Planks, "Side")
	b(3, 0, -3, 3.5, 9, 3, C.Wood, M.Planks, "Side")
	b(-3.5, 0, 2.5, 3.5, 9, 3, C.Wood, M.Planks, "Back")
	b(-3.5, 0, -3, 3.5, 3.6, -2.5, C.WoodDark, M.Planks, "CounterFront")
	b(-3.5, 7, -3, 3.5, 9, -2.5, C.WoodDark, M.Planks, "Header")
	b(-3.8, 3.6, -3.6, 3.8, 3.9, -2.2, C.WoodLight, M.Wood, "Counter")
	b(-4.4, 9, -4, 4.4, 9.5, 4, C.Iron, M.Metal, "Roof")
	b(-4.6, 9.5, -4.2, 4.6, 9.8, -3.6, C.Brass, M.Metal, "RoofTrim")
	for _, x in ipairs({ -1.2, 1.2 }) do
		b(x - 0.08, 3.9, -2.8, x + 0.08, 7, -2.7, C.Iron, M.Metal, "WindowBar")
	end
	local header = b(-3.2, 7.2, -3.06, 3.2, 8.8, -3.0, C.Charcoal, M.Smooth, "OfficeSign")
	Graphics.signPlate(Kit.surface(header, Enum.NormalId.Front, 40), "STATION OFFICE", "", { TitleColor = C.Brass, BorderThickness = 2 })
	Kit.ball(kiosk, 0.5, f * CFrame.new(1.8, 4.15, -3.1), C.Brass, M.Metal, { Name = "CounterBell" })
	Props.pendant(kiosk, f * CFrame.new(0, 8.9, 0), 1.2, 1.4, 12, 0.7)
	Props.shelf(kiosk, f * CFrame.new(0, 0, 1.9), 5.6, 5.5, 1.1, 3, C.WoodDark)
	return kiosk
end

local function buildPlatformSign(model)
	local gantry = Kit.model(model, "PlatformGantry")
	for _, sx in ipairs({ -1, 1 }) do
		Kit.cylY(gantry, 13, 0.8, CFrame.new(sx * 13.8, 6.5, CZ1 - 0.6), C.Iron, M.Metal, { Name = "GantryPost" })
	end
	Kit.box(gantry, O, -14.4, 12.6, CZ1 - 1, 14.4, 13.4, CZ1 - 0.2, C.Iron, M.Metal, { Name = "GantryBeam" })
	for _, sx in ipairs({ -1, 1 }) do
		Kit.beam(gantry, V(sx * 5, 12.6, CZ1 - 0.6), V(sx * 5, 11.6, CZ1 - 0.6), 0.2, 0.2, C.Iron, M.Metal, { Name = "Hanger" })
	end
	local sign = Kit.box(gantry, O, -8.5, 8.6, CZ1 - 0.85, 8.5, 11.6, CZ1 - 0.35, C.Charcoal, M.Smooth, { Name = "PlatformSign" })
	Graphics.signPlate(Kit.surface(sign, Enum.NormalId.Front, 36), "LOWER PLATFORM", "EXPEDITION CABINS", { TitleColor = C.Parchment })
	Graphics.signPlate(Kit.surface(sign, Enum.NormalId.Back, 36), "CONCOURSE", "", { TitleColor = C.Parchment })
end

-- SPAWN -------------------------------------------------------------------------
local function buildSpawn(model)
	local spawnFolder = Kit.folder(model, "Spawn")
	local z = -52
	Kit.cylY(spawnFolder, 0.1, 13.2, CFrame.new(0, 0.05, z), C.BrassDark, M.Metal, { Name = "MedallionRing" })
	Kit.cylY(spawnFolder, 0.14, 12.2, CFrame.new(0, 0.07, z), C.StoneLight, M.Marble, { Name = "MedallionStone" })
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Size = V(6, 0.3, 6)
	spawn.CFrame = CFrame.lookAt(V(0, 0.05, z), V(0, 0.05, z + 10))
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0 -- no forcefield bubble
	spawn.Color = C.Charcoal
	spawn.Material = M.Slate
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Parent = spawnFolder
	local plate = Kit.part(spawnFolder, V(5.4, 5.4, 0.05), CFrame.new(0, 0.225, z) * CFrame.Angles(rad(90), 0, 0), C.Charcoal, M.Smooth, { Name = "EmblemPlate", CanCollide = false, CastShadow = false })
	Emblem.Create(Kit.surface(plate, Enum.NormalId.Front, 50, { LightInfluence = 0.8 }), { Color = C.Brass, Thickness = 5, Size = UDim2.new(0.92, 0, 0.92, 0) })
	-- Where players appear when they come back from the train.
	Kit.marker(spawnFolder, "ReturnPoint", V(6, 1, 6), CFrame.lookAt(V(0, 0.5, z + 4), V(0, 0.5, z + 14)))
	return spawn
end

-- FURNITURE, LIGHTS & STORYTELLING ---------------------------------------------------
local function buildFurnishing(model)
	local f = Kit.folder(model, "Furnishing")
	local rng = Kit.rng(1937)

	-- Benches (some for waiting, one for looking at the train).
	Props.bench(f, CFrame.new(16, 0, -44) * CFrame.Angles(0, rad(90), 0), 7)
	Props.bench(f, CFrame.new(16, 0, -10) * CFrame.Angles(0, rad(90), 0), 7)
	Props.bench(f, CFrame.new(-16, 0, -48) * CFrame.Angles(0, rad(-90), 0), 7)
	Props.bench(f, CFrame.new(37, 0, -20) * CFrame.Angles(0, rad(-90), 0), 6, C.WoodLight)
	Props.bench(f, CFrame.new(-24, PY, 33) * CFrame.Angles(0, rad(180), 0), 7)
	Props.bench(f, CFrame.new(24, PY, 33) * CFrame.Angles(0, rad(180), 0), 7)
	-- a coat left draped over a bench back
	Kit.part(f, V(1.6, 1.4, 0.3), CFrame.new(-16.9, 3.2, -46.5) * CFrame.Angles(0, rad(-90), rad(8)), C.FabricGreen, M.Fabric, { Name = "DrapedCoat" })
	Props.suitcase(f, CFrame.new(13.2, 0, -6.2) * CFrame.Angles(0, rad(12), 0), 2.4, 1.6, 0.8, C.Burgundy)

	-- Luggage cart heading for the platform.
	local cart = CFrame.new(-20, 0, 8) * CFrame.Angles(0, rad(20), 0)
	local deck = Props.cart(f, cart, 3.4, 6)
	Props.trunk(f, cart * CFrame.new(0, deck, -1.4), 3.0, 1.7, 2.0, C.Leather)
	Props.suitcase(f, cart * CFrame.new(-0.1, deck, 1.5) * CFrame.Angles(0, rad(8), 0), 2.6, 1.1, 1.6, C.FabricGreen)
	Props.suitcase(f, cart * CFrame.new(0.2, deck + 1.7, -1.3) * CFrame.Angles(0, rad(-14), 0), 1.8, 0.9, 1.2, C.Burgundy)

	-- Expedition supplies waiting by the east windows.
	Props.crate(f, CFrame.new(32, 0, 6) * CFrame.Angles(0, rad(4), 0), 4, 4, 4)
	Props.crate(f, CFrame.new(32.2, 4, 6.2) * CFrame.Angles(0, rad(19), 0), 2.8, 2.6, 2.8, C.Wood)
	Props.crate(f, CFrame.new(36.2, 0, 3.6) * CFrame.Angles(0, rad(-11), 0), 3.2, 2.4, 2.6)
	Props.sack(f, CFrame.new(30.8, 0, 10.2) * CFrame.Angles(0, rad(70), 0), 4, 1.4, C.Canvas)
	Props.lantern(f, CFrame.new(36.4, 2.4, 3.4), 1)
	Props.ropeCoil(f, CFrame.new(28.5, 0, 4.2), 2.2)

	-- Mail for the line, by the office.
	Props.sack(f, CFrame.new(-27, 0, -16.5) * CFrame.Angles(0, rad(30), 0), 3, 1.6)
	Props.sack(f, CFrame.new(-28.5, 0, -14.4) * CFrame.Angles(0, rad(-25), 0), 2.6, 1.4, C.StoneLight)
	Props.crate(f, CFrame.new(-25.3, 0, -14.8) * CFrame.Angles(0, rad(9), 0), 2, 1.6, 2)

	-- Viewing bay telescope, aimed at the waiting train.
	local head = V(40.6, 4.6, -14)
	for i = 0, 2 do
		local a = rad(i * 120 + 20)
		Kit.beam(f, head, V(40.6 + math.cos(a) * 1.5, 0, -14 + math.sin(a) * 1.5), 0.18, 0.18, C.WoodDark, M.Wood, { Name = "TripodLeg" })
	end
	Kit.cylZ(f, 3.4, 0.55, CFrame.lookAt(head, V(76, -2, -32)) * CFrame.new(0, 0.2, -0.6), C.Brass, M.Metal, { Name = "Telescope" })

	-- Platform: luggage and equipment beside the cabins.
	Props.suitcase(f, CFrame.new(-39.5, PY, 42) * CFrame.Angles(0, rad(-25), 0), 2.2, 1.5, 0.8, C.Leather)
	local cart2 = CFrame.new(-37, PY, 31) * CFrame.Angles(0, rad(80), 0)
	local deck2 = Props.cart(f, cart2, 3.2, 5.4)
	Props.crate(f, cart2 * CFrame.new(0, deck2, -1), 2.6, 2.2, 2.6, C.Wood)
	Props.sack(f, cart2 * CFrame.new(0, deck2, 1.6), 2.6, 1.2)
	Props.crate(f, CFrame.new(40, PY, 41) * CFrame.Angles(0, rad(-7), 0), 3.4, 3.2, 3.2)
	Props.trunk(f, CFrame.new(40.6, PY, 36.4) * CFrame.Angles(0, rad(84), 0), 3, 1.8, 2, C.FabricGreen)
	Props.ropeCoil(f, CFrame.new(37.6, PY, 38.4), 2)

	-- Lamps.
	for _, p in ipairs({ { -8, -47.5 }, { 8, -47.5 }, { -8, -8 }, { 8, -8 } }) do
		Props.lampPost(f, CFrame.new(p[1], 0, p[2]), 9, 22, 1.0)
	end
	for _, x in ipairs({ -25.5, -6.5, 15.5 }) do
		Props.lampPost(f, CFrame.new(x, PY, 41.5), 8, 20, 1.0)
	end
	Props.pendant(f, CFrame.new(0, 30.1, -40), 6.5, 2.6, 30, 1.1)
	Props.pendant(f, CFrame.new(0, 30.1, -8), 6.5, 2.6, 30, 1.1)
	Props.pendant(f, CFrame.new(-20, 30.1, 40), 12, 2.6, 28, 1.0)
	Props.pendant(f, CFrame.new(20, 30.1, 40), 12, 2.6, 28, 1.0)
	for _, x in ipairs({ -11, 11 }) do
		Props.sconce(f, CFrame.new(x, 9, CZ0) * CFrame.Angles(0, rad(180), 0), 16, 0.8)
	end
	Props.sconce(f, CFrame.new(-HX, 17.5, -33) * CFrame.Angles(0, rad(-90), 0), 20, 0.8)

	-- Posters and the route map: the terminal's quiet storytelling.
	local posters = {
		{ CFrame.new(-HX + 0.2, 7, -56) * CFrame.Angles(0, rad(-90), 0), "Vale" },
		{ CFrame.new(-HX + 0.2, 7, -11) * CFrame.Angles(0, rad(-90), 0), "Line" },
		{ CFrame.new(-24, 7, CZ0 + 0.2) * CFrame.Angles(0, rad(180), 0), "Dusk" },
		{ CFrame.new(24, 7, CZ0 + 0.2) * CFrame.Angles(0, rad(180), 0), "Fog" },
	}
	for _, p in ipairs(posters) do
		Graphics.poster(Props.panel(f, p[1], 5, 7, C.WoodDark, C.Parchment, 40), p[2])
	end
	Graphics.routeMap(Props.panel(f, CFrame.new(-HX + 0.3, 10, -33) * CFrame.Angles(0, rad(-90), 0), 22, 12, C.WoodDark, C.Parchment, 26))
	Kit.box(f, O, -HX + 1.6, 0, -44, -HX + 1.9, 2.6, -22, C.Brass, M.Metal, { Name = "MapRail" })
	for _, z in ipairs({ -44, -33, -22 }) do
		Kit.cylY(f, 2.6, 0.3, CFrame.new(-HX + 1.75, 1.3, z), C.Iron, M.Metal, { Name = "MapRailPost" })
	end
	return rng
end

function LobbyBuilder.Build(parent)
	local lobby = Kit.model(parent, "Lobby")
	buildFloors(lobby)
	local walls = Kit.folder(lobby, "Walls")
	eastWindows(walls)
	westWall(walls)
	southWall(walls)
	northWall(walls)
	gable(walls, CZ0 - 1, false)
	gable(walls, PZ1 + 1, true)
	buildRoof(lobby)
	buildClock(lobby)
	buildInfoBoard(lobby)
	buildKiosk(lobby)
	buildPlatformSign(lobby)
	local spawn = buildSpawn(lobby)
	buildFurnishing(lobby)
	local roomTone = Kit.marker(lobby, "Bounds", V(2 * HX + 16, 70, PZ1 - CZ0 + 20), CFrame.new(0, 12, (CZ0 + PZ1) / 2))
	roomTone:SetAttribute("Zone", "Terminal")
	Kit.tag(roomTone, "ZoneBounds")
	lobby.PrimaryPart = spawn
	return lobby, {
		KeeperCFrame = CFrame.new(-16.8, 0, -25.5) * CFrame.Angles(0, rad(-31), 0),
		PlatformY = PY,
	}
end

return LobbyBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">NPCBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	NPCBuilder — The Station Keeper and The Conductor.

	Stylised figures built from parts (no Humanoid: they never move, so they
	cost no physics and show no default nameplate). Each one has:
	  * a recognisable silhouette (Keeper: wide-brim hat, long field coat,
	    lantern; Conductor: tall peaked cap, ankle-length frock coat)
	  * a face drawn on a SurfaceGui
	  * a ProximityPrompt (attribute DialogueId) handled by the client
	  * a small amber diamond indicator above the head
]]

local Kit = require(script.Parent.BuildKit)
local Props = require(script.Parent.Props)

local C, M = Kit.C, Kit.M
local rad = math.rad

local NPCBuilder = {}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local KINDS = {
	StationKeeper = {
		ObjectText = "The Station Keeper",
		Scale = 1.0,
		Coat = Color3.fromRGB(70, 80, 64),
		CoatLength = 1.9,
		Trousers = Color3.fromRGB(52, 42, 34),
		Skin = Color3.fromRGB(186, 142, 108),
		Hands = Color3.fromRGB(96, 64, 44), -- work gloves
	},
	Conductor = {
		ObjectText = "The Conductor",
		Scale = 1.08,
		Coat = Color3.fromRGB(34, 38, 48),
		CoatLength = 2.3,
		Trousers = Color3.fromRGB(28, 30, 36),
		Skin = Color3.fromRGB(172, 128, 98),
		Hands = Color3.fromRGB(220, 214, 200), -- white gloves
	},
}

local function face(head, kind, s)
	local plate = Kit.part(head.Parent, V(1.1 * s, 0.9 * s, 0.05), head.CFrame * CFrame.new(0, 0.05 * s, -0.71 * s), C.Glass, M.Smooth, { Name = "FacePlate", Transparency = 1, CanCollide = false, CastShadow = false })
	local g = Kit.surface(plate, Enum.NormalId.Front, 100, { LightInfluence = 1 })
	local ink = Color3.fromRGB(34, 26, 22)
	for _, x in ipairs({ 0.3, 0.7 }) do
		Kit.frame(g, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(x, 0, 0.36, 0), Size = UDim2.new(0.1, 0, kind == "Conductor" and 0.07 or 0.12, 0), BackgroundTransparency = 0, BackgroundColor3 = ink })
		Kit.frame(g, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(x, 0, 0.2, 0), Size = UDim2.new(0.2, 0, 0.045, 0), Rotation = x < 0.5 and 8 or -8, BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(110, 104, 98) })
	end
	if kind == "StationKeeper" then
		local stache = Kit.frame(g, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.64, 0), Size = UDim2.new(0.46, 0, 0.11, 0), BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(150, 146, 140) })
		Kit.corner(stache, 0.5, 0)
	else
		local beard = Kit.frame(g, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.62, 0), Size = UDim2.new(0.62, 0, 0.36, 0), BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(96, 94, 92) })
		Kit.corner(beard, 0.4, 0)
		Kit.frame(g, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.7, 0), Size = UDim2.new(0.22, 0, 0.035, 0), BackgroundTransparency = 0, BackgroundColor3 = ink })
	end
end

local function indicator(head, s)
	local bb = Instance.new("BillboardGui")
	bb.Name = "TalkIndicator"
	bb.Size = UDim2.new(0, 22, 0, 22)
	bb.StudsOffset = Vector3.new(0, 1.9 * s, 0)
	bb.MaxDistance = 45
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.Parent = head
	local diamond = Kit.frame(bb, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 11, 0, 11), Rotation = 45, BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(226, 168, 96) })
	Kit.stroke(diamond, Color3.fromRGB(40, 30, 20), 1.5, 0.2)
end

function NPCBuilder.Build(parent, cf, kind)
	local k = KINDS[kind]
	assert(k, "Unknown NPC kind " .. tostring(kind))
	local s = k.Scale
	local folder = parent:FindFirstChild("NPCs") or Kit.folder(parent, "NPCs")
	local m = Kit.model(folder, kind)
	local function P(name, size, x, y, z, color, material, extra)
		local props = { Name = name }
		if extra then
			for kk, vv in pairs(extra) do
				props[kk] = vv
			end
		end
		return Kit.part(m, size * s, cf * CFrame.new(x * s, y * s, z * s), color, material or M.Fabric, props)
	end

	-- Body.
	for _, sx in ipairs({ -1, 1 }) do
		P("Boot", V(0.95, 0.55, 1.35), sx * 0.5, 0.275, -0.12, Color3.fromRGB(40, 30, 24), M.Smooth)
		P("Leg", V(0.85, 2.4, 0.85), sx * 0.5, 1.75, 0, k.Trousers)
		P("Sleeve", V(0.72, 2.3, 0.82), sx * 1.48, 4.0, 0, k.Coat)
		P("Hand", V(0.55, 0.5, 0.6), sx * 1.48, 2.6, 0, k.Hands, M.Smooth)
	end
	local torso = P("Torso", V(2.2, 2.3, 1.15), 0, 4.1, 0, k.Coat)
	P("CoatSkirt", V(2.3, k.CoatLength, 1.3), 0, 2.95 - k.CoatLength / 2, 0.02, k.Coat)
	local head = Kit.ball(m, 1.45 * s, cf * CFrame.new(0, 6.1 * s, 0), k.Skin, M.Smooth, { Name = "Head" })
	face(head, kind, s)
	m.PrimaryPart = torso

	if kind == "StationKeeper" then
		P("Belt", V(2.32, 0.3, 1.32), 0, 3.05, 0, C.Leather, M.Smooth)
		P("Scarf", V(1.5, 0.45, 1.25), 0, 5.4, 0, C.Burgundy)
		P("ScarfTail", V(0.4, 1.3, 0.15), -0.45, 4.6, -0.62, C.Burgundy)
		Kit.cylY(m, 0.14 * s, 2.7 * s, cf * CFrame.new(0, 6.85 * s, 0), Color3.fromRGB(60, 48, 40), M.Fabric, { Name = "HatBrim" })
		Kit.cylY(m, 0.95 * s, 1.55 * s, cf * CFrame.new(0, 7.35 * s, 0), Color3.fromRGB(60, 48, 40), M.Fabric, { Name = "HatCrown" })
		Kit.cylY(m, 0.2 * s, 1.58 * s, cf * CFrame.new(0, 7.05 * s, 0), C.Burgundy, M.Fabric, { Name = "HatBand" })
		P("Satchel", V(0.6, 1.0, 1.1), 1.32, 3.1, 0.1, C.Leather)
		Kit.beam(m, cf * V(-0.9 * s, 5.2 * s, -0.6 * s), cf * V(0.95 * s, 3.4 * s, -0.6 * s), 0.18 * s, 0.1 * s, C.Leather, M.Fabric, { Name = "Strap" })
		Kit.beam(m, cf * V(-0.6 * s, 3.65 * s, -0.6 * s), cf * V(0.3 * s, 3.35 * s, -0.6 * s), 0.08 * s, 0.08 * s, C.Brass, M.Metal, { Name = "WatchChain" })
		-- He carries a lantern: a little warm light that follows the terminal's mood.
		Props.lantern(m, cf * CFrame.new(-1.48 * s, 0.95 * s, -0.15 * s), 0.6, 9, 0.6)
	else
		Kit.part(m, V(0.12, 4.0, 0.05) * s, cf * CFrame.new(0, 3.3 * s, -0.66 * s), C.Burgundy, M.Smooth, { Name = "Piping" })
		for _, sx in ipairs({ -1, 1 }) do
			for row = 0, 2 do
				Kit.ball(m, 0.2 * s, cf * CFrame.new(sx * 0.42 * s, (4.7 - row * 0.6) * s, -0.62 * s), C.Brass, M.Metal, { Name = "Button" })
			end
			P("Epaulette", V(0.8, 0.15, 0.9), sx * 1.3, 5.3, 0, C.BrassDark, M.Metal)
			P("Cuff", V(0.76, 0.3, 0.86), sx * 1.48, 3.0, 0, C.Burgundy)
		end
		P("Collar", V(1.2, 0.35, 1.0), 0, 5.4, 0, k.Coat)
		Kit.cylY(m, 0.6 * s, 1.6 * s, cf * CFrame.new(0, 7.0 * s, 0), Color3.fromRGB(28, 30, 38), M.Fabric, { Name = "CapBand" })
		Kit.cylY(m, 0.18 * s, 1.85 * s, cf * CFrame.new(0, 7.38 * s, 0), Color3.fromRGB(34, 36, 46), M.Fabric, { Name = "CapTop" })
		Kit.part(m, V(1.3, 0.1, 0.65) * s, cf * CFrame.new(0, 6.72 * s, -0.95 * s) * CFrame.Angles(rad(14), 0, 0), Color3.fromRGB(20, 20, 24), M.Smooth, { Name = "CapVisor" })
		Kit.cylZ(m, 0.08 * s, 0.42 * s, cf * CFrame.new(0, 7.05 * s, -0.82 * s), C.Brass, M.Metal, { Name = "CapBadge" })
		P("TicketPunch", V(0.25, 0.5, 0.6), 1.48, 2.2, -0.25, C.Brass, M.Metal)
	end

	local prompt = Kit.prompt(torso, "Talk", k.ObjectText, 10)
	prompt:SetAttribute("DialogueId", kind)
	indicator(head, s)
	Kit.tag(m, "NPC")
	return m
end

return NPCBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">Props</string><ProtectedString name="Source"><![CDATA[--[[
	Props
	Reusable, low part-count props. Each prop is built at `cf`, which is the
	prop's floor-level centre; the prop's front faces cf.LookVector (-Z).
	Typical prop: 2-7 parts. Variety comes from size / colour / rotation
	parameters chosen by the caller, not from extra geometry.
]]

local Kit = require(script.Parent.BuildKit)

local C, M = Kit.C, Kit.M
local rad = math.rad

local Props = {}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

local function at(cf, x, y, z)
	return cf * CFrame.new(x, y, z)
end

function Props.crate(parent, cf, w, h, d, color)
	color = color or C.WoodLight
	local body = Kit.part(parent, V(w, h, d), at(cf, 0, h / 2, 0), color, M.Planks, { Name = "Crate" })
	Kit.part(parent, V(w + 0.12, 0.25, d + 0.12), at(cf, 0, h - 0.12, 0), C.WoodDark, M.Wood, { Name = "CrateRim" })
	Kit.part(parent, V(w + 0.12, 0.25, d + 0.12), at(cf, 0, 0.12, 0), C.WoodDark, M.Wood, { Name = "CrateRim" })
	return body
end

function Props.trunk(parent, cf, w, h, d, color)
	color = color or C.Leather
	local body = Kit.part(parent, V(w, h * 0.72, d), at(cf, 0, h * 0.36, 0), color, M.Fabric, { Name = "Trunk" })
	Kit.part(parent, V(w + 0.1, h * 0.28, d + 0.1), at(cf, 0, h * 0.86, 0), C.WoodDark, M.Wood, { Name = "TrunkLid" })
	Kit.part(parent, V(0.18, h + 0.04, d + 0.16), at(cf, -w * 0.3, h / 2, 0), C.BrassDark, M.Metal, { Name = "Strap" })
	Kit.part(parent, V(0.18, h + 0.04, d + 0.16), at(cf, w * 0.3, h / 2, 0), C.BrassDark, M.Metal, { Name = "Strap" })
	return body
end

function Props.suitcase(parent, cf, w, h, d, color)
	color = color or C.Leather
	local body = Kit.part(parent, V(w, h, d), at(cf, 0, h / 2, 0), color, M.Fabric, { Name = "Suitcase" })
	Kit.part(parent, V(w * 0.35, 0.18, 0.18), at(cf, 0, h + 0.09, 0), C.WoodDark, M.Smooth, { Name = "Handle" })
	Kit.part(parent, V(w + 0.04, 0.12, d + 0.04), at(cf, 0, h * 0.55, 0), C.BrassDark, M.Metal, { Name = "Band" })
	return body
end

function Props.sack(parent, cf, length, diameter, color)
	return Kit.cylX(parent, length, diameter, at(cf, 0, diameter / 2, 0), color or C.Canvas, M.Fabric, { Name = "Sack" })
end

function Props.ropeCoil(parent, cf, diameter)
	Kit.cylY(parent, 0.5, diameter, at(cf, 0, 0.25, 0), C.Canvas, M.Fabric, { Name = "RopeCoil" })
	Kit.cylY(parent, 0.52, diameter * 0.45, at(cf, 0, 0.25, 0), C.WoodDark, M.Smooth, { Name = "RopeCore" })
end

-- Lantern. lightRange = nil -> unlit decorative lantern.
function Props.lantern(parent, cf, scale, lightRange, brightness)
	local s = scale or 1
	Kit.cylY(parent, 0.25 * s, 0.9 * s, at(cf, 0, 0.12 * s, 0), C.Iron, M.Metal, { Name = "LanternBase" })
	local core = Kit.part(parent, V(0.55 * s, 0.9 * s, 0.55 * s), at(cf, 0, 0.7 * s, 0), lightRange and C.BulbWarm or C.BulbOff, lightRange and M.Neon or M.Glass, { Name = "LanternGlass", CastShadow = false })
	Kit.part(parent, V(0.1 * s, 1.0 * s, 0.75 * s), at(cf, 0, 0.7 * s, 0), C.Iron, M.Metal, { Name = "LanternCage" })
	Kit.part(parent, V(0.75 * s, 1.0 * s, 0.1 * s), at(cf, 0, 0.7 * s, 0), C.Iron, M.Metal, { Name = "LanternCage" })
	Kit.cylY(parent, 0.3 * s, 0.8 * s, at(cf, 0, 1.3 * s, 0), C.Iron, M.Metal, { Name = "LanternCap" })
	if lightRange then
		Kit.pointLight(core, lightRange, brightness or 0.8)
	end
	return core
end

-- Cast-iron station bench. Sitters face cf.LookVector.
function Props.bench(parent, cf, length, woodColor, useSeat)
	woodColor = woodColor or C.Wood
	local seat
	if useSeat ~= false then
		seat = Instance.new("Seat")
		seat.Size = V(length, 0.35, 1.8)
		seat.CFrame = at(cf, 0, 1.6, 0)
		seat.Anchored = true
		seat.TopSurface = Enum.SurfaceType.Smooth
		seat.BottomSurface = Enum.SurfaceType.Smooth
		seat.Color = woodColor
		seat.Material = M.Planks
		seat.Name = "BenchSeat"
		seat.Parent = parent
	else
		seat = Kit.part(parent, V(length, 0.35, 1.8), at(cf, 0, 1.6, 0), woodColor, M.Planks, { Name = "BenchSeat" })
	end
	Kit.part(parent, V(length, 1.7, 0.25), at(cf, 0, 2.75, 0.85) * CFrame.Angles(rad(12), 0, 0), woodColor, M.Planks, { Name = "BenchBack" })
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * (length / 2 - 0.25)
		Kit.part(parent, V(0.3, 1.45, 1.6), at(cf, x, 0.72, 0.05), C.Iron, M.Metal, { Name = "BenchEnd" })
		Kit.part(parent, V(0.34, 0.22, 1.5), at(cf, x, 2.35, 0), C.Iron, M.Metal, { Name = "BenchArm" })
		Kit.part(parent, V(0.3, 2.3, 0.3), at(cf, x, 2.3, 0.85), C.Iron, M.Metal, { Name = "BenchPost" })
	end
	return seat
end

function Props.armchair(parent, cf, color)
	color = color or C.FabricRed
	local seat = Instance.new("Seat")
	seat.Size = V(2.6, 0.7, 2.4)
	seat.CFrame = at(cf, 0, 1.25, 0)
	seat.Anchored = true
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.BottomSurface = Enum.SurfaceType.Smooth
	seat.Color = color
	seat.Material = M.Fabric
	seat.Name = "ArmchairSeat"
	seat.Parent = parent
	Kit.part(parent, V(2.6, 0.9, 2.4), at(cf, 0, 0.45, 0), C.WoodDark, M.Wood, { Name = "ArmchairBase" })
	Kit.part(parent, V(2.6, 2.4, 0.5), at(cf, 0, 2.1, 1.0), color, M.Fabric, { Name = "ArmchairBack" })
	Kit.part(parent, V(0.45, 1.0, 2.4), at(cf, -1.3, 1.8, 0), color, M.Fabric, { Name = "ArmchairArm" })
	Kit.part(parent, V(0.45, 1.0, 2.4), at(cf, 1.3, 1.8, 0), color, M.Fabric, { Name = "ArmchairArm" })
	return seat
end

function Props.sofa(parent, cf, length, color)
	color = color or C.FabricRed
	local seat = Instance.new("Seat")
	seat.Size = V(length - 0.8, 0.6, 2.4)
	seat.CFrame = at(cf, 0, 1.3, -0.1)
	seat.Anchored = true
	seat.TopSurface = Enum.SurfaceType.Smooth
	seat.BottomSurface = Enum.SurfaceType.Smooth
	seat.Color = color
	seat.Material = M.Fabric
	seat.Name = "SofaSeat"
	seat.Parent = parent
	Kit.part(parent, V(length, 1.0, 2.6), at(cf, 0, 0.5, 0), C.WoodDark, M.Wood, { Name = "SofaBase" })
	Kit.part(parent, V(length, 2.4, 0.6), at(cf, 0, 2.2, 1.1), color, M.Fabric, { Name = "SofaBack" })
	Kit.part(parent, V(0.5, 1.2, 2.6), at(cf, -length / 2 + 0.25, 1.6, 0), color, M.Fabric, { Name = "SofaArm" })
	Kit.part(parent, V(0.5, 1.2, 2.6), at(cf, length / 2 - 0.25, 1.6, 0), color, M.Fabric, { Name = "SofaArm" })
	return seat
end

function Props.table(parent, cf, w, d, h, color, material)
	color = color or C.Wood
	local top = Kit.part(parent, V(w, 0.3, d), at(cf, 0, h - 0.15, 0), color, material or M.Wood, { Name = "TableTop" })
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			Kit.part(parent, V(0.3, h - 0.3, 0.3), at(cf, sx * (w / 2 - 0.35), (h - 0.3) / 2, sz * (d / 2 - 0.35)), C.WoodDark, M.Wood, { Name = "TableLeg" })
		end
	end
	return top
end

-- Open shelf unit against a wall (back at +Z).
function Props.shelf(parent, cf, w, h, d, levels, color)
	color = color or C.WoodDark
	Kit.part(parent, V(0.25, h, d), at(cf, -w / 2 + 0.125, h / 2, 0), color, M.Wood, { Name = "ShelfSide" })
	Kit.part(parent, V(0.25, h, d), at(cf, w / 2 - 0.125, h / 2, 0), color, M.Wood, { Name = "ShelfSide" })
	Kit.part(parent, V(w, h, 0.15), at(cf, 0, h / 2, d / 2 - 0.075), color, M.Wood, { Name = "ShelfBack" })
	local ys = {}
	for i = 0, levels do
		local y = 0.2 + (h - 0.4) * i / levels
		Kit.part(parent, V(w - 0.3, 0.2, d - 0.1), at(cf, 0, y, -0.05), color, M.Wood, { Name = "ShelfBoard" })
		ys[#ys + 1] = y + 0.1
	end
	return ys
end

-- A run of books standing on a shelf board, starting at the shelf's left.
function Props.books(parent, cf, width, rng, colors)
	colors = colors or { C.Burgundy, C.FabricGreen, C.Leather, C.BlueSteel, C.Canvas, C.WoodLight }
	local x = -width / 2
	while x < width / 2 - 0.6 do
		local run = math.min(width / 2 - x, rng(0.9, 2.2))
		local h = rng(1.1, 1.6)
		local col = colors[math.floor(rng(1, #colors + 0.99))]
		Kit.part(parent, V(run - 0.06, h, 0.95), at(cf, x + run / 2, h / 2, 0), col, M.Fabric, { Name = "Books" })
		x = x + run + rng(0.0, 0.5)
	end
end

function Props.lampPost(parent, cf, height, lightRange, brightness, color)
	Kit.cylY(parent, 0.8, 1.8, at(cf, 0, 0.4, 0), C.Iron, M.Metal, { Name = "PostBase" })
	Kit.cylY(parent, height, 0.45, at(cf, 0, height / 2, 0), C.Iron, M.Metal, { Name = "Post" })
	Kit.cylY(parent, 0.3, 0.9, at(cf, 0, height - 0.6, 0), C.BrassDark, M.Metal, { Name = "PostCollar" })
	Kit.part(parent, V(1.5, 0.25, 1.5), at(cf, 0, height + 0.1, 0), C.Iron, M.Metal, { Name = "LampFloor" })
	local core = Kit.part(parent, V(0.85, 1.25, 0.85), at(cf, 0, height + 0.85, 0), C.BulbWarm, M.Neon, { Name = "LampCore", CastShadow = false })
	Kit.part(parent, V(1.7, 0.3, 1.7), at(cf, 0, height + 1.6, 0), C.Iron, M.Metal, { Name = "LampRoof" })
	Kit.ball(parent, 0.5, at(cf, 0, height + 1.9, 0), C.BrassDark, M.Metal, { Name = "Finial" })
	if lightRange then
		Kit.pointLight(core, lightRange, brightness or 1, color)
	end
	return core
end

-- Hanging lamp. cf = the ceiling attach point.
function Props.pendant(parent, cf, drop, shadeDiameter, lightRange, brightness, color)
	Kit.cylY(parent, drop, 0.18, at(cf, 0, -drop / 2, 0), C.Iron, M.Metal, { Name = "PendantRod" })
	Kit.cylY(parent, 0.7, shadeDiameter, at(cf, 0, -drop - 0.2, 0), C.BrassDark, M.Metal, { Name = "PendantShade" })
	local bulb = Kit.bulb(parent, shadeDiameter * 0.35, at(cf, 0, -drop - 0.65, 0), C.BulbWarm)
	if lightRange then
		Kit.pointLight(bulb, lightRange, brightness or 1, color)
	end
	return bulb
end

-- Wall lamp. cf sits on the wall surface, LookVector pointing into the room.
function Props.sconce(parent, cf, lightRange, brightness)
	Kit.part(parent, V(0.5, 1.2, 0.2), at(cf, 0, 0, 0.1), C.BrassDark, M.Metal, { Name = "SconcePlate" })
	Kit.part(parent, V(0.18, 0.18, 1.0), at(cf, 0, 0, -0.5), C.Iron, M.Metal, { Name = "SconceArm" })
	local core = Kit.part(parent, V(0.6, 0.8, 0.6), at(cf, 0, 0.2, -1.1), C.BulbWarm, M.Neon, { Name = "SconceGlass", CastShadow = false })
	Kit.part(parent, V(0.85, 0.2, 0.85), at(cf, 0, 0.7, -1.1), C.Iron, M.Metal, { Name = "SconceCap" })
	if lightRange then
		Kit.pointLight(core, lightRange, brightness or 0.8)
	end
	return core
end

function Props.cart(parent, cf, w, d)
	Kit.part(parent, V(w, 0.35, d), at(cf, 0, 1.35, 0), C.WoodWorn, M.Planks, { Name = "CartBed" })
	Kit.part(parent, V(w - 0.4, 0.4, 0.3), at(cf, 0, 1.0, 0), C.Iron, M.Metal, { Name = "CartAxle" })
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			Kit.cylX(parent, 0.3, 1.2, at(cf, sx * (w / 2 - 0.2), 0.6, sz * (d / 2 - 0.6)), C.Iron, M.Metal, { Name = "CartWheel" })
		end
	end
	Kit.part(parent, V(0.2, 2.6, 0.2), at(cf, -w / 2 + 0.2, 2.6, d / 2 - 0.1), C.Iron, M.Metal, { Name = "CartUpright" })
	Kit.part(parent, V(0.2, 2.6, 0.2), at(cf, w / 2 - 0.2, 2.6, d / 2 - 0.1), C.Iron, M.Metal, { Name = "CartUpright" })
	Kit.part(parent, V(w, 0.22, 0.22), at(cf, 0, 3.9, d / 2 - 0.1), C.BrassDark, M.Metal, { Name = "CartHandle" })
	return 1.52 -- deck height
end

function Props.locker(parent, cf, w, h, d, number, color)
	local body = Kit.part(parent, V(w, h, d), at(cf, 0, h / 2, 0), color or C.BlueSteel, M.Metal, { Name = "Locker" })
	local g = Kit.surface(body, Enum.NormalId.Front, 40)
	Kit.frame(g, { Size = UDim2.new(1, -6, 1, -6), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1 })
	Kit.stroke(Kit.frame(g, { Size = UDim2.new(0.88, 0, 0.94, 0), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5) }), C.Charcoal, 3, 0.2)
	for i = 0, 4 do
		Kit.frame(g, { Size = UDim2.new(0.5, 0, 0.012, 0), Position = UDim2.new(0.25, 0, 0.1 + i * 0.03, 0), BackgroundTransparency = 0.2, BackgroundColor3 = C.Charcoal })
	end
	Kit.frame(g, { Size = UDim2.new(0.06, 0, 0.12, 0), Position = UDim2.new(0.78, 0, 0.5, 0), BackgroundTransparency = 0, BackgroundColor3 = C.Brass })
	local plate = Kit.frame(g, { Size = UDim2.new(0.34, 0, 0.07, 0), Position = UDim2.new(0.33, 0, 0.3, 0), BackgroundTransparency = 0, BackgroundColor3 = C.Brass })
	Kit.label(plate, number or "", { TextColor3 = C.Ink, Font = Enum.Font.Oswald })
	return body
end

function Props.displayCase(parent, cf, w, h, d)
	Kit.part(parent, V(w, h * 0.62, d), at(cf, 0, h * 0.31, 0), C.WoodDark, M.Wood, { Name = "CaseBase" })
	Kit.part(parent, V(w + 0.12, 0.15, d + 0.12), at(cf, 0, h * 0.62, 0), C.BrassDark, M.Metal, { Name = "CaseTrim" })
	local glass = Kit.part(parent, V(w - 0.1, h * 0.38, d - 0.1), at(cf, 0, h * 0.62 + h * 0.19, 0), C.Glass, M.Glass, { Name = "CaseGlass", Transparency = 0.7, CastShadow = false })
	Kit.part(parent, V(w + 0.05, 0.12, d + 0.05), at(cf, 0, h + 0.03, 0), C.BrassDark, M.Metal, { Name = "CaseTop" })
	return glass
end

function Props.pedestal(parent, cf, h, topSize)
	topSize = topSize or 1.8
	Kit.part(parent, V(topSize + 0.6, 0.4, topSize + 0.6), at(cf, 0, 0.2, 0), C.StoneDark, M.Marble, { Name = "PedestalBase" })
	Kit.part(parent, V(topSize - 0.4, h - 0.8, topSize - 0.4), at(cf, 0, h / 2, 0), C.Stone, M.Marble, { Name = "PedestalColumn" })
	local top = Kit.part(parent, V(topSize, 0.4, topSize), at(cf, 0, h - 0.2, 0), C.StoneDark, M.Marble, { Name = "PedestalTop" })
	return top
end

-- Framed panel with a SurfaceGui on its front. Returns the SurfaceGui.
-- cf = centre of the panel, LookVector = facing direction.
function Props.panel(parent, cf, w, h, frameColor, faceColor, ppS)
	Kit.part(parent, V(w + 0.4, h + 0.4, 0.2), cf * CFrame.new(0, 0, 0.12), frameColor or C.WoodDark, M.Wood, { Name = "PanelFrame" })
	local face = Kit.part(parent, V(w, h, 0.1), cf, faceColor or C.Parchment, M.Smooth, { Name = "PanelFace" })
	return Kit.surface(face, Enum.NormalId.Front, ppS or 40)
end

return Props
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">TrainBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	TrainBuilder — THE LAST TRAIN (locomotive + carriage shells)

	Built from primitives only (no uploaded meshes), so it works the moment the
	place is opened. Silhouette features that make it recognisable at distance:
	  * oversized smokebox with a brass-ringed emblem door and high headlamp
	  * tall flared chimney, brass steam dome, burgundy V-shaped prow guard
	  * three large spoked driving wheels per side (spokes are drawn on the
	    wheel faces with GUI frames instead of geometry)
	  * porthole cab, lettered tender, segmented arched carriage roofs

	Local frame T: origin at rail level under the very front of the engine,
	the train extends toward +Z, the front faces -Z.

	TrainBuilder.Build(parent, T, opts) -> model, info
	  opts.Name       model name
	  opts.Carriages  carriage names behind the engine, front to back
	  opts.Interiors  true -> build interior linings, lamps, floors
	info.Carriages[name] = { Z0 = number, Frame = CFrame }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent.BuildKit)
local Emblem = require(ReplicatedStorage.Shared.Modules.Emblem)

local C, M = Kit.C, Kit.M
local rad = math.rad

local TrainBuilder = {}

TrainBuilder.CAR_LENGTH = 40
TrainBuilder.GAP = 2
TrainBuilder.LOCO_LENGTH = 64
TrainBuilder.FLOOR_Y = 6

local MYSTERY_METAL = Color3.fromRGB(30, 34, 42)

-- Per-carriage look. windows = z centres (0..40 along the carriage), w = width.
TrainBuilder.Styles = {
	Boarding = {
		Label = "BOARDING",
		Windows = { 4.5, 10.5, 16.5, 33, 37.5 },
		WindowWidth = 3.8,
		Doors = { 26.5 },
		Lining = { Lower = C.Wood, Upper = C.Cream, Ceiling = C.Cream, Floor = C.Wood, FloorMaterial = M.Planks, UpperMaterial = M.Smooth },
		Lamps = { 8, 21, 34 },
		LightColor = Color3.fromRGB(255, 180, 110),
		RearDeck = true,
	},
	Explorer = {
		Label = "EXPLORER",
		Windows = { 13, 20, 27 },
		WindowWidth = 4.2,
		Lining = { Lower = C.WoodWorn, Upper = C.BlueSteel, Ceiling = C.WoodLight, Floor = C.WoodWorn, FloorMaterial = M.Planks, UpperMaterial = M.Metal },
		Lamps = { 9, 31 },
		LightColor = Color3.fromRGB(255, 184, 116),
	},
	Discovery = {
		Label = "DISCOVERY",
		Windows = { 14, 20, 26 },
		WindowWidth = 3.6,
		Lining = { Lower = C.WoodDark, Upper = C.FabricGreen, Ceiling = C.WoodDark, Floor = C.WoodDark, FloorMaterial = M.Planks, UpperMaterial = M.Fabric },
		Lamps = { 8, 32 },
		LightColor = Color3.fromRGB(255, 212, 168),
	},
	Crew = {
		Label = "CREW",
		Windows = { 7, 16, 25, 34 },
		WindowWidth = 6.2,
		WindowHead = 14,
		Lining = { Lower = C.Wood, Upper = Color3.fromRGB(104, 44, 44), Ceiling = C.Cream, Floor = Color3.fromRGB(92, 62, 46), FloorMaterial = M.Fabric, UpperMaterial = M.Fabric },
		Lamps = { 12, 30 },
		LightColor = Color3.fromRGB(255, 166, 96),
	},
	Mystery = {
		Label = "",
		Windows = {},
		Shutters = { 7, 15, 25, 33 },
		Sealed = true,
	},
}

local function V(x, y, z)
	return Vector3.new(x, y, z)
end

-- WHEELS ------------------------------------------------------------------------
local function spokes(part, face)
	local g = Kit.surface(part, face, 30, { LightInfluence = 1 })
	for i = 0, 5 do
		Kit.frame(g, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0.07, 0, 0.84, 0), Rotation = i * 30, BackgroundTransparency = 0, BackgroundColor3 = C.Charcoal })
	end
	local ring = Kit.frame(g, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0.9, 0, 0.9, 0) })
	Kit.corner(ring, 0.5, 0)
	Kit.stroke(ring, C.Charcoal, 5, 0)
	-- counterweight
	local cw = Kit.frame(g, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.27, 0), Size = UDim2.new(0.42, 0, 0.2, 0), BackgroundTransparency = 0, BackgroundColor3 = C.Charcoal })
	Kit.corner(cw, 0.5, 0)
end

local function driver(m, T, x, z, r)
	local side = x < 0 and -1 or 1
	local face = side < 0 and Enum.NormalId.Left or Enum.NormalId.Right
	Kit.cylX(m, 0.6, r * 2, T * CFrame.new(x, r, z), C.Charcoal, M.Metal, { Name = "Tyre" })
	local centre = Kit.cylX(m, 0.75, r * 2 - 0.9, T * CFrame.new(x, r, z), C.Burgundy, M.Metal, { Name = "WheelCentre" })
	spokes(centre, face)
	Kit.cylX(m, 0.95, 1.2, T * CFrame.new(x, r, z), C.Brass, M.Metal, { Name = "Hub" })
	Kit.cylX(m, 0.5, 0.55, T * CFrame.new(x + side * 0.55, r - r * 0.47, z), C.Iron, M.Metal, { Name = "CrankPin" })
end

local function smallWheel(m, T, x, z, r)
	Kit.cylX(m, 0.5, r * 2, T * CFrame.new(x, r, z), C.Charcoal, M.Metal, { Name = "Wheel" })
	Kit.cylX(m, 0.6, r * 1.3, T * CFrame.new(x, r, z), C.BlueSteelDark, M.Metal, { Name = "WheelHub" })
end

local function bogie(m, T, zc)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(m, T, sx * 4.5, 1.0, zc - 3.4, sx * 5.1, 2.8, zc + 3.4, C.Charcoal, M.Metal, { Name = "BogieFrame" })
		for _, dz in ipairs({ -2, 2 }) do
			Kit.cylX(m, 0.5, 3, T * CFrame.new(sx * 4.15, 1.5, zc + dz), C.Charcoal, M.Metal, { Name = "Wheel" })
		end
	end
	Kit.box(m, T, -4.5, 2.6, zc - 0.8, 4.5, 3.4, zc + 0.8, C.Iron, M.Metal, { Name = "Bolster" })
end

local function emblemDisc(parent, cf, diameter, color, faceSide)
	local disc = Kit.cylX(parent, 0.2, diameter, cf, C.BrassDark, M.Metal, { Name = "EmblemRoundel" })
	Emblem.Create(Kit.surface(disc, faceSide, 50), { Color = color or C.Ink, Thickness = 4, Size = UDim2.new(0.88, 0, 0.88, 0) })
	return disc
end

-- LOCOMOTIVE --------------------------------------------------------------------
local function locomotive(train, T)
	local m = Kit.model(train, "Locomotive")

	-- Prow guard: an original burgundy V-plough instead of a slatted cowcatcher.
	Kit.wedge(m, V(5.2, 3.6, 5), T * CFrame.new(-1.4, 2.1, 3.0) * CFrame.Angles(0, rad(25), 0), C.Burgundy, M.Metal, { Name = "Prow" })
	Kit.wedge(m, V(5.2, 3.6, 5), T * CFrame.new(1.4, 2.1, 3.0) * CFrame.Angles(0, rad(-25), 0), C.Burgundy, M.Metal, { Name = "Prow" })
	Kit.box(m, T, -5.2, 0.3, 4.3, 5.2, 0.7, 5.6, C.Charcoal, M.Metal, { Name = "ProwFoot" })
	Kit.box(m, T, -6, 3.6, 4.6, 6, 5.6, 5.6, C.Burgundy, M.Metal, { Name = "BufferBeam" })
	Kit.box(m, T, -6.1, 5.45, 4.5, 6.1, 5.7, 5.7, C.BrassDark, M.Metal, { Name = "BufferBeamTrim" })
	for _, sx in ipairs({ -1, 1 }) do
		Kit.cylZ(m, 1.4, 0.8, T * CFrame.new(sx * 4.6, 4.6, 3.9), C.Iron, M.Metal, { Name = "BufferShank" })
		Kit.cylZ(m, 0.3, 1.7, T * CFrame.new(sx * 4.6, 4.6, 3.2), C.Charcoal, M.Metal, { Name = "BufferHead" })
	end

	-- Chassis, running boards and the burgundy valance.
	Kit.box(m, T, -4.4, 3.0, 5.6, 4.4, 5.4, 47, C.Charcoal, M.Metal, { Name = "Frame" })
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(m, T, sx * 4.4, 7.0, 6, sx * 6.4, 7.4, 37.6, C.Charcoal, M.Metal, { Name = "RunningBoard" })
		Kit.box(m, T, sx * 6.25, 6.0, 6, sx * 6.45, 7.0, 37.6, C.Burgundy, M.Metal, { Name = "Valance" })
	end

	-- Leading truck, cylinders and the three great driving wheels.
	for _, z in ipairs({ 9, 13.4 }) do
		for _, sx in ipairs({ -1, 1 }) do
			smallWheel(m, T, sx * 4.2, z, 1.6)
		end
	end
	for _, sx in ipairs({ -1, 1 }) do
		Kit.cylZ(m, 5, 2.8, T * CFrame.new(sx * 5.0, 4.6, 14.2), C.BlueSteel, M.Metal, { Name = "Cylinder" })
		Kit.cylZ(m, 0.2, 2.2, T * CFrame.new(sx * 5.0, 4.6, 11.6), C.BrassDark, M.Metal, { Name = "CylinderCover" })
		Kit.box(m, T, sx * 5.15, 4.75, 16.6, sx * 5.45, 5.05, 21.2, C.Iron, M.Metal, { Name = "SlideBar" })
		for _, z in ipairs({ 20.5, 27.5, 34.5 }) do
			driver(m, T, sx * 4.5, z, 3.4)
		end
		Kit.box(m, T, sx * 5.05, 1.55, 20.2, sx * 5.4, 2.1, 34.8, C.Iron, M.Metal, { Name = "CouplingRod" })
		Kit.beam(m, T * V(sx * 5.4, 4.6, 17.6), T * V(sx * 5.4, 1.85, 27.5), 0.3, 0.6, C.Iron, M.Metal, { Name = "MainRod" })
	end

	-- Boiler, smokebox and emblem door.
	Kit.cylZ(m, 26.5, 9, T * CFrame.new(0, 12.1, 24.25), C.BlueSteel, M.Metal, { Name = "Boiler" })
	for _, z in ipairs({ 17, 23.5, 30, 36.5 }) do
		Kit.cylZ(m, 0.35, 9.25, T * CFrame.new(0, 12.1, z), C.BrassDark, M.Metal, { Name = "BoilerBand" })
	end
	Kit.cylZ(m, 4.8, 9.6, T * CFrame.new(0, 12.1, 8.9), C.Charcoal, M.Metal, { Name = "Smokebox" })
	Kit.box(m, T, -3.5, 5.4, 6.8, 3.5, 8.6, 11, C.Charcoal, M.Metal, { Name = "Saddle" })
	Kit.cylZ(m, 0.25, 8.3, T * CFrame.new(0, 12.1, 6.45), C.Brass, M.Metal, { Name = "DoorRim" })
	local door = Kit.cylZ(m, 0.3, 7.6, T * CFrame.new(0, 12.1, 6.3), C.Iron, M.Metal, { Name = "SmokeboxDoor" })
	Emblem.Create(Kit.surface(door, Enum.NormalId.Right, 40, { LightInfluence = 0.7 }), { Color = C.Brass, Thickness = 6, Size = UDim2.new(0.8, 0, 0.8, 0) })

	-- Chimney, domes, whistle.
	Kit.cylY(m, 2.6, 2.6, T * CFrame.new(0, 17.3, 8.6), C.Charcoal, M.Metal, { Name = "Chimney" })
	Kit.cylY(m, 0.9, 3.7, T * CFrame.new(0, 19.05, 8.6), C.BlueSteelDark, M.Metal, { Name = "ChimneyCrown" })
	Kit.cylY(m, 0.2, 2.9, T * CFrame.new(0, 19.55, 8.6), C.Charcoal, M.Smooth, { Name = "ChimneyMouth" })
	Kit.cylY(m, 1.6, 3.6, T * CFrame.new(0, 16.9, 21.5), C.BrassDark, M.Metal, { Name = "SteamDomeBase" })
	Kit.ball(m, 3.6, T * CFrame.new(0, 17.6, 21.5), C.BrassDark, M.Metal, { Name = "SteamDome" })
	Kit.cylY(m, 1.4, 3, T * CFrame.new(0, 16.8, 29.5), C.Charcoal, M.Metal, { Name = "SandDomeBase" })
	Kit.ball(m, 3, T * CFrame.new(0, 17.4, 29.5), C.Charcoal, M.Metal, { Name = "SandDome" })
	Kit.cylY(m, 1.6, 0.5, T * CFrame.new(1.3, 17.4, 36), C.Brass, M.Metal, { Name = "Whistle" })

	-- Headlamp, high on the smokebox: recognisable from far away.
	Kit.box(m, T, -0.6, 16.6, 5.6, 0.6, 17.4, 7.0, C.Iron, M.Metal, { Name = "LampBracket" })
	Kit.cylZ(m, 1.8, 2.4, T * CFrame.new(0, 18.4, 6.3), C.Charcoal, M.Metal, { Name = "LampHousing" })
	Kit.box(m, T, -1.3, 19.55, 5.0, 1.3, 19.75, 6.6, C.Iron, M.Metal, { Name = "LampVisor" })
	Kit.cylZ(m, 0.12, 1.8, T * CFrame.new(0, 18.4, 5.38), C.BulbWarm, M.Neon, { Name = "HeadlampLens", CastShadow = false })
	local beam = Kit.marker(m, "HeadlampBeam", V(0.5, 0.5, 0.5), T * CFrame.new(0, 18.4, 5.0))
	Kit.spotLight(beam, Enum.NormalId.Front, 70, 2.6, 38, Color3.fromRGB(255, 206, 150))
	Kit.pointLight(beam, 10, 0.6, Color3.fromRGB(255, 190, 130))

	-- Smoke deflectors with emblem roundels.
	for _, sx in ipairs({ -1, 1 }) do
		Kit.box(m, T, sx * 5.55, 8.2, 6.6, sx * 5.8, 15.6, 15.2, C.BlueSteelDark, M.Metal, { Name = "Deflector" })
		Kit.box(m, T, sx * 5.5, 15.4, 6.6, sx * 5.85, 15.7, 15.2, C.BrassDark, M.Metal, { Name = "DeflectorEdge" })
		emblemDisc(m, T * CFrame.new(sx * 5.92, 11.8, 10.9), 2.8, C.Ink, sx < 0 and Enum.NormalId.Left or Enum.NormalId.Right)
	end

	-- Cab with porthole windows.
	local CZ0, CZ1 = 37.6, 46.2
	Kit.box(m, T, -5.6, 7.4, CZ0, 5.6, 8.0, CZ1, C.WoodDark, M.Planks, { Name = "CabFloor" })
	Kit.wallX(m, T, CZ0 + 0.25, 0.5, -5.6, 5.6, 8.0, 19.2, {}, C.BlueSteel, M.Metal, { Name = "CabFront" })
	for _, sx in ipairs({ -1, 1 }) do
		Kit.wallZ(m, T, sx * 5.35, 0.5, CZ0, CZ1, 7.4, 19.2, { { 39.4, 43.6, 12.6, 16.6 } }, C.BlueSteel, M.Metal, { Name = "CabSide" })
		Kit.box(m, T, sx * 5.35 - 0.3, 7.4, CZ0, sx * 5.35 + 0.3, 10.2, CZ1, C.Burgundy, M.Metal, { Name = "CabPanel" })
		Kit.cylZ(m, 0.3, 2.4, T * CFrame.new(sx * 2.6, 15.2, CZ0 - 0.05), C.Brass, M.Metal, { Name = "PortholeRim" })
		Kit.cylZ(m, 0.36, 1.8, T * CFrame.new(sx * 2.6, 15.2, CZ0 - 0.05), Color3.fromRGB(255, 170, 96), M.Neon, { Name = "Porthole", Transparency = 0.25, CastShadow = false })
		emblemDisc(m, T * CFrame.new(sx * 5.72, 11.4, 41.9), 2.6, C.Ink, sx < 0 and Enum.NormalId.Left or Enum.NormalId.Right)
	end
	local cabRoof = { { -6.4, 18.9 }, { -3.2, 20.3 }, { 3.2, 20.3 }, { 6.4, 18.9 } }
	for i = 1, 3 do
		Kit.slabXY(m, T, cabRoof[i][1], cabRoof[i][2], cabRoof[i + 1][1], cabRoof[i + 1][2], CZ0 - 0.6, CZ1 + 0.8, 0.45, C.Charcoal, M.Metal, { Name = "CabRoof" })
	end
	Kit.box(m, T, -1.6, 8.0, CZ0 + 0.55, 1.6, 10.6, CZ0 + 0.8, Color3.fromRGB(255, 120, 52), M.Neon, { Name = "FireboxGlow", Transparency = 0.15, CastShadow = false })

	-- Tender, lettered on both sides.
	local TZ0, TZ1 = 47.2, 64
	Kit.box(m, T, -4.4, 3.0, TZ0, 4.4, 5.0, TZ1, C.Charcoal, M.Metal, { Name = "TenderFrame" })
	Kit.box(m, T, -5.3, 5.0, TZ0, 5.3, 15.0, TZ1 - 0.4, C.BlueSteel, M.Metal, { Name = "TenderBody" })
	Kit.box(m, T, -5.5, 14.6, TZ0 - 0.1, 5.5, 15.2, TZ1 - 0.3, C.Charcoal, M.Metal, { Name = "TenderCoaming" })
	Kit.box(m, T, -4.6, 15.0, TZ0 + 1, 4.6, 16.2, TZ0 + 10, Color3.fromRGB(26, 26, 28), M.Slate, { Name = "Coal" })
	Kit.cylY(m, 0.8, 2.2, T * CFrame.new(0, 15.4, TZ1 - 3), C.Iron, M.Metal, { Name = "WaterHatch" })
	for _, sx in ipairs({ -1, 1 }) do
		local band = Kit.box(m, T, sx * 5.3, 8.0, TZ0 + 0.6, sx * 5.42, 12.4, TZ1 - 1.0, C.Burgundy, M.Metal, { Name = "TenderPanel" })
		local g = Kit.surface(band, sx < 0 and Enum.NormalId.Left or Enum.NormalId.Right, 30, { LightInfluence = 0.8 })
		Kit.stroke(Kit.frame(g, { Size = UDim2.new(1, -10, 1, -10), Position = UDim2.new(0.5, 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5) }), C.BrassDark, 2, 0.2)
		Kit.label(g, "THE LAST TRAIN", { Position = UDim2.new(0.08, 0, 0.22, 0), Size = UDim2.new(0.84, 0, 0.56, 0), Font = Enum.Font.Merriweather, TextColor3 = Color3.fromRGB(196, 158, 96) })
		Kit.box(m, T, sx * 4.6, 1.0, TZ0 + 1.5, sx * 5.1, 3.2, TZ1 - 1.5, C.Charcoal, M.Metal, { Name = "TenderSideFrame" })
		for _, z in ipairs({ 51, 56, 61 }) do
			smallWheel(m, T, sx * 4.2, z, 1.6)
		end
	end
	Kit.box(m, T, -5.6, 3.6, TZ1 - 0.6, 5.6, 5.4, TZ1, C.Burgundy, M.Metal, { Name = "RearBufferBeam" })

	-- Steam: soft and slow so it never hides the silhouette.
	local stack = Kit.marker(m, "SteamSource", V(1, 1, 1), T * CFrame.new(0, 20.2, 8.6))
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(196, 202, 210)
	smoke.Opacity = 0.12
	smoke.RiseVelocity = 5
	smoke.Size = 4
	smoke.Parent = stack
	for _, sx in ipairs({ -1, 1 }) do
		local cock = Kit.marker(m, "DrainCock", V(0.5, 0.5, 0.5), T * CFrame.new(sx * 5.2, 3.0, 11.6))
		local wisp = Instance.new("Smoke")
		wisp.Color = Color3.fromRGB(210, 214, 220)
		wisp.Opacity = 0.05
		wisp.RiseVelocity = 1
		wisp.Size = 1.6
		wisp.Parent = cock
	end
	Kit.soundEmitter(stack, "EngineIdle")
	Kit.soundEmitter(stack, "SteamRelease")
	return m
end

-- CARRIAGES -------------------------------------------------------------------------
local ROOF_OUT = { { -8.7, 15.1 }, { -6.2, 17.4 }, { -2.6, 18.5 }, { 2.6, 18.5 }, { 6.2, 17.4 }, { 8.7, 15.1 } }
local ROOF_IN = { { -7.05, 15.4 }, { -5.6, 16.55 }, { -2.4, 17.45 }, { 2.4, 17.45 }, { 5.6, 16.55 }, { 7.05, 15.4 } }

local function carriage(train, name, F, style, interiors)
	local m = Kit.model(train, name .. "Carriage")
	local L = TrainBuilder.CAR_LENGTH
	local sealed = style.Sealed == true
	local outerLower = sealed and MYSTERY_METAL or C.BlueSteel
	local outerUpper = sealed and MYSTERY_METAL or C.BlueSteelDark
	local lining = (interiors and not sealed) and style.Lining or nil
	local head = style.WindowHead or 13.4
	local deckLen = style.RearDeck and 5.5 or 0

	-- Running gear and floor.
	Kit.box(m, F, -6.2, 3.4, 1, 6.2, 5.0, L - 1, C.Charcoal, M.Metal, { Name = "Underframe" })
	Kit.box(m, F, -3, 2.6, 16, 3, 3.4, 24, C.Iron, M.Metal, { Name = "EquipmentBox" })
	bogie(m, F, 7)
	bogie(m, F, L - 7)
	Kit.box(m, F, -8, 5.0, 0, 8, 6.0, L + deckLen, C.BlueSteelDark, M.Metal, { Name = "Floor" })

	-- Side walls: exterior metal skin + warm interior lining.
	local holes = {}
	for _, zc in ipairs(style.Windows or {}) do
		table.insert(holes, { zc - style.WindowWidth / 2, zc + style.WindowWidth / 2, 9.4, head })
	end
	for _, zc in ipairs(style.Doors or {}) do
		table.insert(holes, { zc - 2.5, zc + 2.5, 6.0, 13.6 })
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, r in ipairs(Kit.solidRects(0, L, 5.0, 15.4, holes)) do
			local lower = r[4] <= 9.45
			Kit.box(m, F, sx * 7.2, r[3], r[1], sx * 8.0, r[4], r[2], lower and outerLower or outerUpper, M.Metal, { Name = "Skin" })
			if lining then
				local ly0 = math.max(r[3], 6.0)
				local lz0, lz1 = math.max(r[1], 1), math.min(r[2], L - 1)
				if r[4] > ly0 + 0.01 and lz1 > lz0 + 0.01 then
					Kit.box(m, F, sx * 7.0, ly0, lz0, sx * 7.2, r[4], lz1, lower and lining.Lower or lining.Upper, lower and M.Planks or lining.UpperMaterial, { Name = "Lining" })
				end
			end
		end
		for _, h in ipairs(holes) do
			if h[3] > 7 then
				Kit.part(m, V(0.12, h[4] - h[3], h[2] - h[1]), F * CFrame.new(sx * 7.6, (h[3] + h[4]) / 2, (h[1] + h[2]) / 2), C.Glass, M.Glass, { Name = "Window", Transparency = 0.5, CastShadow = false })
			end
		end
		if not sealed then
			Kit.box(m, F, sx * 8.0, 8.7, 0.2, sx * 8.12, 9.2, L - 0.2, C.Burgundy, M.Smooth, { Name = "Beltline" })
			Kit.box(m, F, sx * 8.0, 9.25, 0.2, sx * 8.2, 9.4, L - 0.2, C.BrassDark, M.Metal, { Name = "Sill" })
			if style.Label ~= "" then
				local board = Kit.box(m, F, sx * 8.0, 13.75, L / 2 - 6, sx * 8.08, 15.05, L / 2 + 6, outerUpper, M.Metal, { Name = "Nameboard" })
				local g = Kit.surface(board, sx < 0 and Enum.NormalId.Left or Enum.NormalId.Right, 30, { LightInfluence = 0.9 })
				Kit.label(g, style.Label, { Position = UDim2.new(0.2, 0, 0.1, 0), Size = UDim2.new(0.6, 0, 0.8, 0), TextColor3 = Color3.fromRGB(190, 152, 92) })
			end
			emblemDisc(m, F * CFrame.new(sx * 8.05, 7.2, L / 2), 2.4, C.Ink, sx < 0 and Enum.NormalId.Left or Enum.NormalId.Right)
		else
			-- Sealed carriage: shuttered windows and a large emblem. No name.
			for _, zc in ipairs(style.Shutters or {}) do
				local sh = Kit.box(m, F, sx * 8.0, 9.6, zc - 2, sx * 8.15, 13.2, zc + 2, Color3.fromRGB(40, 44, 52), M.Corroded, { Name = "Shutter" })
				local g = Kit.surface(sh, sx < 0 and Enum.NormalId.Left or Enum.NormalId.Right, 20)
				for i = 1, 6 do
					Kit.frame(g, { Position = UDim2.new(0.05, 0, i / 7.5, 0), Size = UDim2.new(0.9, 0, 0.04, 0), BackgroundTransparency = 0.2, BackgroundColor3 = Color3.fromRGB(20, 22, 26) })
				end
			end
			emblemDisc(m, F * CFrame.new(sx * 8.05, 11.4, L / 2), 4.6, Color3.fromRGB(150, 120, 74), sx < 0 and Enum.NormalId.Left or Enum.NormalId.Right)
			Kit.box(m, F, sx * 8.0, 6.2, 1, sx * 8.06, 6.32, L - 1, Color3.fromRGB(120, 168, 210), M.Neon, { Name = "ColdSeam", Transparency = 0.55, CastShadow = false })
		end
	end

	-- End walls (doorways unless sealed).
	local endHole = sealed and {} or { { -3, 3, 6.0, 14.0 } }
	for _, zc in ipairs({ 0.5, L - 0.5 }) do
		Kit.wallX(m, F, zc, 1, -8, 8, 5.0, 15.4, endHole, outerUpper, M.Metal, { Name = "EndWall" })
		if lining then
			local inner = zc < L / 2 and zc + 0.6 or zc - 0.6
			Kit.wallX(m, F, inner, 0.2, -7, 7, 6.0, 15.4, endHole, lining.Lower, M.Planks, { Name = "EndLining" })
		end
		Kit.box(m, F, -7, 15.4, zc - 0.5, 7, 17.2, zc + 0.5, outerUpper, M.Metal, { Name = "EndGable" })
		Kit.box(m, F, -3.2, 17.2, zc - 0.5, 3.2, 18.3, zc + 0.5, outerUpper, M.Metal, { Name = "EndGable" })
	end

	-- Segmented arched roof (and a matching ceiling inside).
	for i = 1, #ROOF_OUT - 1 do
		local a, b = ROOF_OUT[i], ROOF_OUT[i + 1]
		Kit.slabXY(m, F, a[1], a[2], b[1], b[2], -0.3, L + 0.3 + deckLen, 0.5, sealed and Color3.fromRGB(26, 28, 34) or C.Charcoal, M.Metal, { Name = "Roof" })
		if lining then
			local c, d = ROOF_IN[i], ROOF_IN[i + 1]
			Kit.slabXY(m, F, c[1], c[2], d[1], d[2], 1, L - 1, 0.25, lining.Ceiling, M.Wood, { Name = "Ceiling" })
		end
	end
	Kit.box(m, F, -1.8, 18.5, 12, 1.8, 19.4, 16, C.Iron, M.Metal, { Name = "Ventilator" })
	Kit.box(m, F, -1.8, 18.5, L - 16, 1.8, 19.4, L - 12, C.Iron, M.Metal, { Name = "Ventilator" })

	if lining then
		Kit.box(m, F, -7, 6.0, 1, 7, 6.1, L - 1, lining.Floor, lining.FloorMaterial, { Name = "FloorCovering" })
		for _, z in ipairs(style.Lamps or {}) do
			local lamp = Instance.new("Model")
			lamp.Name = "CeilingLamp"
			lamp.Parent = m
			Kit.cylY(lamp, 0.25, 1.6, F * CFrame.new(0, 17.32, z), C.BrassDark, M.Metal, { Name = "Rose" })
			Kit.cylY(lamp, 1.1, 0.14, F * CFrame.new(0, 16.7, z), C.Iron, M.Metal, { Name = "Rod" })
			Kit.cylY(lamp, 0.6, 2.0, F * CFrame.new(0, 16.0, z), C.BrassDark, M.Metal, { Name = "Shade" })
			Kit.bulb(lamp, 0.8, F * CFrame.new(0, 15.55, z), C.BulbWarm, 22, 1.05, style.LightColor)
		end
	elseif not sealed then
		-- Exterior-only build (lobby teaser): fake a lit interior behind the glass.
		for _, sx in ipairs({ -1, 1 }) do
			Kit.box(m, F, sx * 6.4, 9.2, 2, sx * 6.6, 13.6, L - 2, Color3.fromRGB(196, 124, 64), M.Neon, { Name = "InteriorGlow", Transparency = 0.35, CastShadow = false })
		end
	end

	-- Rear observation deck (Boarding carriage only).
	if style.RearDeck then
		local d0, d1 = L, L + deckLen
		for _, sx in ipairs({ -1, 1 }) do
			Kit.box(m, F, sx * 7.4, 6.0, d0, sx * 7.6, 9.6, d1, C.Iron, M.Metal, { Name = "DeckRailSide" })
			Kit.box(m, F, sx * 7.3, 9.6, d0, sx * 7.7, 9.85, d1, C.Brass, M.Metal, { Name = "DeckRailTop" })
		end
		Kit.box(m, F, -7.6, 6.0, d1 - 0.2, 7.6, 9.6, d1, C.Iron, M.Metal, { Name = "DeckRailBack" })
		Kit.box(m, F, -7.7, 9.6, d1 - 0.3, 7.7, 9.85, d1 + 0.1, C.Brass, M.Metal, { Name = "DeckRailTop" })
		-- invisible guard: players can look out, but never fall off the train
		Kit.part(m, V(0.4, 9, deckLen), F * CFrame.new(-7.5, 14.1, (d0 + d1) / 2), C.Glass, M.Smooth, { Name = "DeckGuard", Transparency = 1, CastShadow = false })
		Kit.part(m, V(0.4, 9, deckLen), F * CFrame.new(7.5, 14.1, (d0 + d1) / 2), C.Glass, M.Smooth, { Name = "DeckGuard", Transparency = 1, CastShadow = false })
		Kit.part(m, V(15.4, 9, 0.4), F * CFrame.new(0, 14.1, d1), C.Glass, M.Smooth, { Name = "DeckGuard", Transparency = 1, CastShadow = false })
		Kit.ball(m, 0.6, F * CFrame.new(5.6, 16.6, d1 + 0.1), Color3.fromRGB(200, 60, 52), M.Neon, { Name = "TailLamp", CastShadow = false })
		Kit.ball(m, 0.6, F * CFrame.new(-5.6, 16.6, d1 + 0.1), Color3.fromRGB(200, 60, 52), M.Neon, { Name = "TailLamp", CastShadow = false })
	end
	return m
end

local function gangway(train, T, z0, z1)
	local g = Kit.model(train, "Gangway")
	local col = Color3.fromRGB(34, 32, 30)
	Kit.box(g, T, -3.9, 6.0, z0, -3.0, 14.6, z1, col, M.Fabric, { Name = "Bellows" })
	Kit.box(g, T, 3.0, 6.0, z0, 3.9, 14.6, z1, col, M.Fabric, { Name = "Bellows" })
	Kit.box(g, T, -3.9, 14.0, z0, 3.9, 14.6, z1, col, M.Fabric, { Name = "Bellows" })
	Kit.box(g, T, -3.0, 5.7, z0 - 0.3, 3.0, 6.0, z1 + 0.3, C.Iron, M.Plate, { Name = "BridgePlate" })
	return g
end

function TrainBuilder.Build(parent, T, opts)
	opts = opts or {}
	local train = Kit.model(parent, opts.Name or "TheLastTrain")
	locomotive(train, T)
	local info = { Carriages = {}, Order = {} }
	local z = TrainBuilder.LOCO_LENGTH + TrainBuilder.GAP
	local prevEnd = TrainBuilder.LOCO_LENGTH
	for _, name in ipairs(opts.Carriages or {}) do
		local style = TrainBuilder.Styles[name]
		local F = T * CFrame.new(0, 0, z)
		carriage(train, name, F, style, opts.Interiors)
		if prevEnd ~= TrainBuilder.LOCO_LENGTH then
			gangway(train, T, prevEnd, z)
		end
		info.Carriages[name] = { Z0 = z, Frame = F }
		table.insert(info.Order, name)
		prevEnd = z + TrainBuilder.CAR_LENGTH
		z = prevEnd + TrainBuilder.GAP
	end
	info.Length = prevEnd
	return train, info
end

return TrainBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">WorldBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	WorldBuilder
	Builds the whole world from code when the server starts — unless it was
	already baked into the place.

	BAKING (recommended once you start hand-editing in Studio):
	  In Studio, Edit mode, run this in the Command Bar:
	    require(game.ServerScriptService.World.WorldBuilder).Build()
	  The Lobby, cabins, environment and train appear in Workspace. Save the
	  place. From then on the server sees Workspace.Lobby and skips building,
	  so your manual edits are kept.

	Each step runs protected: if one fails, the rest of the world still builds
	and the error is reported in Output with the step name.
]]

local World = script.Parent

local LightingBuilder = require(World.LightingBuilder)
local LobbyBuilder = require(World.LobbyBuilder)
local CabinBuilder = require(World.CabinBuilder)
local EnvironmentBuilder = require(World.EnvironmentBuilder)
local ExpeditionZoneBuilder = require(World.ExpeditionZoneBuilder)
local NPCBuilder = require(World.NPCBuilder)

local WorldBuilder = {}

function WorldBuilder.IsBuilt()
	return workspace:FindFirstChild("Lobby") ~= nil and workspace:FindFirstChild("ExpeditionCabins") ~= nil and workspace:FindFirstChild("ExpeditionTrain") ~= nil
end

function WorldBuilder.Build()
	local report = { Errors = {}, Baked = false }
	if WorldBuilder.IsBuilt() then
		report.Baked = true
		return report
	end

	local function step(name, fn)
		local ok, err = pcall(fn)
		if not ok then
			table.insert(report.Errors, name .. ": " .. tostring(err))
			warn("[WorldBuilder] " .. name .. " failed: " .. tostring(err))
		end
	end

	local lobbyInfo, zoneInfo
	step("Lighting", function()
		LightingBuilder.Build()
	end)
	step("Lobby", function()
		local _, info = LobbyBuilder.Build(workspace)
		lobbyInfo = info
	end)
	step("Cabins", function()
		CabinBuilder.Build(workspace, lobbyInfo and lobbyInfo.PlatformY or -6)
	end)
	step("Environment", function()
		EnvironmentBuilder.Build(workspace)
	end)
	step("ExpeditionTrain", function()
		local _, info = ExpeditionZoneBuilder.Build(workspace)
		zoneInfo = info
	end)
	step("NPCs", function()
		if lobbyInfo then
			NPCBuilder.Build(workspace.Lobby, lobbyInfo.KeeperCFrame, "StationKeeper")
		end
		if zoneInfo then
			NPCBuilder.Build(workspace.ExpeditionTrain, zoneInfo.ConductorCFrame, "Conductor")
		end
	end)
	return report
end

return WorldBuilder
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000032"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">26</float></Properties><Item class="StarterPlayerScripts" referent="RBX00000031"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000024"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source"><![CDATA[--[[
	ClientMain — the only LocalScript. Loads controllers in a fixed order,
	initialises them all (wiring, UI creation), then starts them (loops).
	Controllers talk to each other through the registry passed to Init.
]]

local Controllers = script.Parent:WaitForChild("Controllers")

local ORDER = {
	"SoundController",
	"InterfaceController",
	"TransitionController",
	"ExpeditionController",
	"CabinVisualsController",
	"DialogueController",
	"TrainHUDController",
	"ZoneController",
	"ClockController",
}

local registry = {}
for _, name in ipairs(ORDER) do
	registry[name] = require(Controllers:WaitForChild(name))
end

for _, name in ipairs(ORDER) do
	local controller = registry[name]
	if controller.Init then
		local ok, err = pcall(controller.Init, registry)
		if not ok then
			warn("[ClientMain] " .. name .. ".Init failed: " .. tostring(err))
		end
	end
end

for _, name in ipairs(ORDER) do
	local controller = registry[name]
	if controller.Start then
		task.spawn(function()
			local ok, err = pcall(controller.Start)
			if not ok then
				warn("[ClientMain] " .. name .. ".Start failed: " .. tostring(err))
			end
		end)
	end
end
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000002E"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">CabinVisualsController</string><ProtectedString name="Source"><![CDATA[--[[
	CabinVisualsController — makes the cabins (and the departures board) react
	to server state. Purely visual; the server's cabin attributes are the
	single source of truth.

	Per state:            Idle        Boarding        Departing / Departed
	  doors               open        open            close
	  semaphore arm       level       raised          high
	  signal lamp         dark        amber           green
	  capacity bulbs      one bulb lit per explorer
	  counter plate       0 / N       n / N           DEPARTING 5..1
	A join (Pulse++) flashes the newest bulb and plays one positional click.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local CabinDefinitions = require(ReplicatedStorage.Shared.Config.CabinDefinitions)

local CabinVisualsController = {}

local controllers
local BULB_ON = Color3.fromRGB(255, 196, 128)
local BULB_OFF = Color3.fromRGB(58, 52, 46)
local LAMP_AMBER = Color3.fromRGB(255, 176, 92)
local LAMP_GREEN = Color3.fromRGB(150, 214, 150)
local DOOR_TWEEN = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
local ARM_TWEEN = TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0)

local function statusText(state, count, capacity, countdown)
	if state == "Departing" then
		return "DEPARTING " .. tostring(countdown)
	elseif state == "Departed" then
		return "DEPARTED"
	elseif count >= capacity then
		return "FULL"
	elseif count > 0 then
		return "BOARDING"
	end
	return "AVAILABLE"
end

-- A small amber diamond over the current leader's head while a cabin is
-- boarding or departing: subtle, but everyone nearby can tell who leads.
local function leaderBadge(model)
	local badge = Instance.new("BillboardGui")
	badge.Name = "LeaderBadge_" .. tostring(model.Name)
	badge.Size = UDim2.new(0, 16, 0, 16)
	badge.StudsOffset = Vector3.new(0, 2.3, 0)
	badge.MaxDistance = 60
	badge.LightInfluence = 0
	badge.AlwaysOnTop = false
	badge.ResetOnSpawn = false
	local diamond = Instance.new("Frame")
	diamond.AnchorPoint = Vector2.new(0.5, 0.5)
	diamond.Position = UDim2.new(0.5, 0, 0.5, 0)
	diamond.Size = UDim2.new(0, 9, 0, 9)
	diamond.Rotation = 45
	diamond.BorderSizePixel = 0
	diamond.BackgroundColor3 = Color3.fromRGB(226, 168, 96)
	diamond.Parent = badge
	badge.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	local function update()
		local userId = model:GetAttribute("LeaderUserId") or 0
		local state = model:GetAttribute("State")
		local leader = nil
		if userId ~= 0 and (state == "Boarding" or state == "Departing") then
			leader = Players:GetPlayerByUserId(userId)
		end
		local head = leader and leader.Character and leader.Character:FindFirstChild("Head")
		badge.Adornee = head
		badge.Enabled = head ~= nil
	end
	model:GetAttributeChangedSignal("LeaderUserId"):Connect(update)
	model:GetAttributeChangedSignal("State"):Connect(update)
	update()
end

local function setBulb(bulb, on)
	bulb.Material = on and Enum.Material.Neon or Enum.Material.Glass
	bulb.Color = on and BULB_ON or BULB_OFF
end

local function bindCabin(model, boardLabels)
	local capacity = model:GetAttribute("Capacity") or 1
	local cabinId = model:GetAttribute("CabinId")
	local display = model:FindFirstChild("CounterPlate") and model.CounterPlate:FindFirstChild("Display")
	local countLabel = display and display:FindFirstChild("Count")
	local statusLabel = display and display:FindFirstChild("Status")
	local bulbs = {}
	local bulbFolder = model:FindFirstChild("CapacityBulbs")
	for i = 1, capacity do
		bulbs[i] = bulbFolder and bulbFolder:FindFirstChild("Bulb" .. i)
	end
	local semaphore = model:FindFirstChild("Semaphore")
	local arm = semaphore and semaphore:FindFirstChild("Arm")
	local signalLamp = semaphore and semaphore:FindFirstChild("SignalLamp")
	local doors = { model:FindFirstChild("DoorLeft"), model:FindFirstChild("DoorRight") }
	local light = model:FindFirstChild("CabinLight") and model.CabinLight:FindFirstChildOfClass("PointLight")
	local baseBrightness = light and light.Brightness or 1
	local lastState = nil
	local lastPulse = model:GetAttribute("Pulse") or 0

	local function apply()
		local state = model:GetAttribute("State") or "Idle"
		local count = model:GetAttribute("Count") or 0
		local countdown = model:GetAttribute("Countdown") or 0
		local text = statusText(state, count, capacity, countdown)
		if countLabel then
			countLabel.Text = count .. " / " .. capacity
		end
		if statusLabel then
			statusLabel.Text = text
		end
		if boardLabels[cabinId] then
			boardLabels[cabinId].Text = text
		end
		for i, bulb in ipairs(bulbs) do
			if bulb then
				setBulb(bulb, i <= count)
			end
		end
		if state ~= lastState then
			local closed = state == "Departing" or state == "Departed"
			local wasClosed = lastState == "Departing" or lastState == "Departed"
			for _, door in ipairs(doors) do
				if door then
					local target = door:GetAttribute(closed and "ClosedCFrame" or "OpenCFrame")
					if target then
						if lastState == nil then
							door.CFrame = target
						else
							TweenService:Create(door, DOOR_TWEEN, { CFrame = target }):Play()
						end
					end
				end
			end
			if lastState ~= nil and closed ~= wasClosed and doors[1] then
				controllers.SoundController.PlayAt("DoorClose", doors[1].Position)
			end
			if arm then
				local key = (state == "Idle") and "CF_Idle" or (state == "Boarding" and "CF_Boarding" or "CF_Departing")
				local target = arm:GetAttribute(key)
				if target then
					TweenService:Create(arm, ARM_TWEEN, { CFrame = target }):Play()
				end
			end
			if signalLamp then
				if state == "Idle" then
					signalLamp.Material = Enum.Material.Glass
					signalLamp.Color = BULB_OFF
				else
					signalLamp.Material = Enum.Material.Neon
					signalLamp.Color = (state == "Boarding") and LAMP_AMBER or LAMP_GREEN
				end
			end
			if light then
				TweenService:Create(light, TweenInfo.new(0.8), { Brightness = closed and baseBrightness * 1.35 or baseBrightness, Color = closed and Color3.fromRGB(255, 212, 160) or Color3.fromRGB(255, 176, 104) }):Play()
			end
			lastState = state
		end
	end

	local function onPulse()
		local pulse = model:GetAttribute("Pulse") or 0
		if pulse == lastPulse then
			return
		end
		lastPulse = pulse
		local count = model:GetAttribute("Count") or 0
		local bulb = bulbs[math.clamp(count, 1, capacity)]
		if bulb then
			bulb.Color = Color3.fromRGB(255, 236, 200)
			TweenService:Create(bulb, TweenInfo.new(0.6), { Color = BULB_ON }):Play()
			controllers.SoundController.PlayAt("CabinJoin", bulb.Position)
		end
	end

	for _, attr in ipairs({ "State", "Count", "Countdown" }) do
		model:GetAttributeChangedSignal(attr):Connect(apply)
	end
	model:GetAttributeChangedSignal("Pulse"):Connect(onPulse)
	apply()
	leaderBadge(model)
end

function CabinVisualsController.Init(registry)
	controllers = registry
end

function CabinVisualsController.Start()
	local boardLabels = {}
	local lobby = workspace:WaitForChild("Lobby", 30)
	local board = lobby and lobby:FindFirstChild("InformationBoard")
	local panel = board and board:FindFirstChild("BoardPanel")
	if panel then
		for _, gui in ipairs(panel:GetChildren()) do
			if gui:IsA("SurfaceGui") then
				for _, def in ipairs(CabinDefinitions) do
					local label = gui:FindFirstChild("Status_" .. def.Id)
					if label then
						boardLabels[def.Id] = label
					end
				end
			end
		end
	end
	local folder = workspace:WaitForChild("ExpeditionCabins", 30)
	if not folder then
		warn("[CabinVisuals] No ExpeditionCabins folder")
		return
	end
	for _, def in ipairs(CabinDefinitions) do
		local model = folder:WaitForChild(def.Id, 10)
		if model then
			bindCabin(model, boardLabels)
		end
	end
end

return CabinVisualsController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">ClockController</string><ProtectedString name="Source"><![CDATA[--[[
	ClockController — drives the station clock's hands (local time).
	Updates once per second, and only while the player is in the terminal.
	Now and then the second hand slips back a tick with a quiet mechanical
	sound. It is never explained.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local ClockController = {}

local controllers
local faces = {} -- { { hour = Frame, minute = Frame, second = Frame } }
local drum = nil

local function collect()
	local lobby = workspace:WaitForChild("Lobby", 30)
	local clock = lobby and lobby:WaitForChild("StationClock", 10)
	if not clock then
		return
	end
	drum = clock:FindFirstChild("Drum")
	for _, d in ipairs(clock:GetDescendants()) do
		if d:IsA("SurfaceGui") then
			local face = { hour = d:FindFirstChild("HourHand"), minute = d:FindFirstChild("MinuteHand"), second = d:FindFirstChild("SecondHand") }
			if face.hour and face.minute and face.second then
				table.insert(faces, face)
			end
		end
	end
end

local function setHands(h, m, s)
	for _, face in ipairs(faces) do
		face.hour.Rotation = ((h % 12) + m / 60) * 30
		face.minute.Rotation = (m + s / 60) * 6
		face.second.Rotation = s * 6
	end
end

function ClockController.Init(registry)
	controllers = registry
end

function ClockController.Start()
	collect()
	if #faces == 0 then
		return
	end
	while true do
		task.wait(1)
		if controllers.ZoneController.GetZone() ~= "Train" then
			local t = os.date("*t")
			local s = t.sec
			if math.random() < GameConfig.Clock.StutterChance then
				s = (s + 59) % 60
				if drum then
					controllers.SoundController.PlayAt("ClockMechanism", drum.Position)
				end
			end
			setHands(t.hour, t.min, s)
		end
	end
end

return ClockController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">DialogueController</string><ProtectedString name="Source"><![CDATA[--[[
	DialogueController — short NPC conversations and "inspect" lines.

	Any ProximityPrompt with attribute DialogueId = "<key>" (see
	Shared.Config.DialogueData) opens this box. Tap / click the box to advance.
	Walking away closes it. Everything is local to the player: a conversation
	never affects anyone else.
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local UIKit = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("UIKit"))
local DialogueData = require(ReplicatedStorage.Shared.Config.DialogueData)

local Theme = UIKit.Theme
local C = Theme.Colors
local player = Players.LocalPlayer

local DialogueController = {}

local controllers
local box, speakerLabel, bodyLabel, hintLabel
local active = nil -- { lines, index, prompt, anchor }
local talked = {}
local typeValue

local CLOSE_DISTANCE = 16

local function typeLine(text)
	bodyLabel.Text = text
	bodyLabel.MaxVisibleGraphemes = 0
	typeValue.Value = 0
	local duration = math.clamp(#text / 48, 0.25, 1.6)
	TweenService:Create(typeValue, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Value = #text }):Play()
end

local function close()
	if not active then
		return
	end
	if active.prompt then
		active.prompt.Enabled = true
	end
	active = nil
	UIKit.hide(box)
end

local function advance()
	if not active then
		return
	end
	local line = active.lines[active.index]
	if bodyLabel.MaxVisibleGraphemes >= 0 and bodyLabel.MaxVisibleGraphemes < #line then
		bodyLabel.MaxVisibleGraphemes = -1 -- finish the line first
		return
	end
	active.index = active.index + 1
	if active.index > #active.lines then
		close()
		return
	end
	controllers.SoundController.Play("UIClick")
	typeLine(active.lines[active.index])
	hintLabel.Text = active.index == #active.lines and "Tap to close" or "Tap to continue"
end

local function open(id, prompt)
	local data = DialogueData[id]
	if not data then
		return
	end
	local lines = data.First
	if talked[id] and data.Repeat then
		lines = data.Repeat
	end
	talked[id] = true
	if active and active.prompt then
		active.prompt.Enabled = true
	end
	active = { lines = lines, index = 1, prompt = prompt, anchor = prompt.Parent }
	prompt.Enabled = false
	speakerLabel.Text = data.Speaker or ""
	speakerLabel.Visible = (data.Speaker or "") ~= ""
	hintLabel.Text = #lines == 1 and "Tap to close" or "Tap to continue"
	typeLine(lines[1])
	UIKit.show(box)
	local soundKey = prompt.Parent and prompt.Parent:GetAttribute("SoundKey")
	if soundKey and prompt.Parent:IsA("BasePart") then
		controllers.SoundController.PlayAt(soundKey, prompt.Parent.Position)
	end
end

function DialogueController.Init(registry)
	controllers = registry
	local gui = UIKit.screen("LastTrainDialogue", 30)
	box = UIKit.panel({
		Name = "DialogueBox",
		Parent = gui,
		Size = UDim2.new(0, 520, 0, 128),
		Position = UDim2.new(0.5, 0, 1, -24),
		AnchorPoint = Vector2.new(0.5, 1),
		Corner = 10,
	})
	local hit = UIKit.create("TextButton", { Parent = box, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ZIndex = 5 })
	hit.Activated:Connect(advance)
	speakerLabel = UIKit.label({ Parent = box, Font = Theme.Fonts.Label, TextSize = 14, Color = C.Accent, Position = UDim2.new(0, 22, 0, 14), Size = UDim2.new(1, -44, 0, 18) })
	bodyLabel = UIKit.label({ Parent = box, Font = Theme.Fonts.Body, TextSize = 19, Color = C.Text, Wrapped = true, YAlign = Enum.TextYAlignment.Top, Position = UDim2.new(0, 22, 0, 40), Size = UDim2.new(1, -44, 0, 54) })
	hintLabel = UIKit.label({ Parent = box, Font = Theme.Fonts.Label, TextSize = 12, Color = C.TextFaint, XAlign = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -18, 1, -10), Size = UDim2.new(0, 160, 0, 16) })
	typeValue = Instance.new("NumberValue")
	typeValue.Changed:Connect(function(v)
		if bodyLabel.MaxVisibleGraphemes ~= -1 then
			bodyLabel.MaxVisibleGraphemes = math.floor(v)
			if math.floor(v) >= #bodyLabel.Text then
				bodyLabel.MaxVisibleGraphemes = -1
			end
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player then
			return
		end
		local id = prompt:GetAttribute("DialogueId")
		if id then
			open(id, prompt)
		end
	end)
end

function DialogueController.Start()
	-- Close the box when the player walks away (checked twice a second, only while open).
	while true do
		task.wait(0.5)
		if active and active.anchor and active.anchor:IsA("BasePart") then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not root or (root.Position - active.anchor.Position).Magnitude > CLOSE_DISTANCE then
				close()
			end
		end
	end
end

return DialogueController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">ExpeditionController</string><ProtectedString name="Source"><![CDATA[--[[
	ExpeditionController — the compact card shown while you stand in a cabin,
	and the departure countdown.

	Priority on the card: 1) expedition type  2) explorers  3) leader
	4) start status. START EXPEDITION only appears for the leader; LEAVE is
	always available (nobody is ever trapped).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("UIKit"))
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)

local Theme = UIKit.Theme
local C = Theme.Colors

local ExpeditionController = {}

local controllers
local requestRemote
local card, titleLabel, countLabel, unitLabel, leaderLabel, statusLabel, pipRow
local startButton, leaveButton
local countdownPanel, countdownNumber
local pips = {}
local current = nil
local lastCountdown = nil

local function play(key)
	controllers.SoundController.Play(key)
end

local function buildCard(gui)
	card = UIKit.panel({
		Name = "ExpeditionCard",
		Parent = gui,
		Size = UDim2.new(0, 300, 0, 176),
		Position = UDim2.new(1, -16, 0.47, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Corner = 10,
	})
	titleLabel = UIKit.label({ Parent = card, Font = Theme.Fonts.Label, TextSize = 15, Color = C.Accent, Position = UDim2.new(0, 18, 0, 14), Size = UDim2.new(1, -110, 0, 18) })
	pipRow = UIKit.create("Frame", { Parent = card, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -18, 0, 17), Size = UDim2.new(0, 80, 0, 12) })
	countLabel = UIKit.label({ Parent = card, Font = Theme.Fonts.Title, TextSize = 26, Color = C.Text, Position = UDim2.new(0, 18, 0, 38), Size = UDim2.new(0, 80, 0, 32) })
	unitLabel = UIKit.label({ Parent = card, Font = Theme.Fonts.Label, TextSize = 14, Color = C.TextMuted, Position = UDim2.new(0, 100, 0, 46), Size = UDim2.new(1, -118, 0, 20) })
	leaderLabel = UIKit.label({ Parent = card, TextSize = 13, Color = C.TextMuted, Position = UDim2.new(0, 18, 0, 74), Size = UDim2.new(1, -36, 0, 18), RichText = true })
	statusLabel = UIKit.label({ Parent = card, Font = Theme.Fonts.Label, TextSize = 13, Color = C.Text, Position = UDim2.new(0, 18, 0, 94), Size = UDim2.new(1, -36, 0, 18) })
	startButton = UIKit.button({
		Parent = card,
		Text = "START EXPEDITION",
		Style = "Primary",
		Size = UDim2.new(1, -134, 0, Theme.ButtonHeight),
		Position = UDim2.new(0, 18, 1, -60),
		OnClick = function()
			play("UIConfirm")
			requestRemote:FireServer("Start")
		end,
	})
	leaveButton = UIKit.button({
		Parent = card,
		Text = "LEAVE",
		Style = "Danger",
		Size = UDim2.new(0, 98, 0, Theme.ButtonHeight),
		Position = UDim2.new(1, -116, 1, -60),
		OnClick = function()
			play("UICancel")
			requestRemote:FireServer("Leave")
		end,
	})
end

local function buildCountdown(gui)
	countdownPanel = UIKit.panel({
		Name = "Countdown",
		Parent = gui,
		Size = UDim2.new(0, 260, 0, 112),
		Position = UDim2.new(0.5, 0, 0, 70),
		AnchorPoint = Vector2.new(0.5, 0),
		Corner = 10,
		Transparency = 0.18,
	})
	UIKit.label({ Parent = countdownPanel, Text = "EXPEDITION DEPARTING", Font = Theme.Fonts.Label, TextSize = 14, Color = C.Accent, XAlign = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 0, 12), Size = UDim2.new(1, 0, 0, 18) })
	countdownNumber = UIKit.label({ Parent = countdownPanel, Text = "5", Font = Theme.Fonts.Title, TextSize = 50, Color = C.Text, XAlign = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 0, 64) })
end

local function setPips(count, capacity)
	if #pips ~= capacity then
		for _, p in ipairs(pips) do
			p:Destroy()
		end
		pips = {}
		for i = 1, capacity do
			local p = UIKit.create("Frame", { Parent = pipRow, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -(capacity - i) * 18, 0, 0), Size = UDim2.new(0, 12, 0, 12) })
			UIKit.corner(p, 6)
			UIKit.stroke(p, C.Stroke, 1, 0.2)
			table.insert(pips, p)
		end
	end
	for i, p in ipairs(pips) do
		p.BackgroundColor3 = i <= count and C.Accent or C.Background
		p.BackgroundTransparency = i <= count and 0 or 0.3
	end
end

local function render(view)
	titleLabel.Text = view.Title
	countLabel.Text = view.Count .. " / " .. view.Capacity
	unitLabel.Text = view.Capacity == 1 and "EXPLORER" or "EXPLORERS"
	setPips(view.Count, view.Capacity)
	if view.IsLeader then
		leaderLabel.Text = '<font color="#E2A860">◆</font>  You lead this expedition'
	else
		leaderLabel.Text = '<font color="#E2A860">◆</font>  Leader: ' .. view.LeaderName
	end
	local departing = view.State == "Departing"
	if departing then
		statusLabel.Text = "DEPARTING IN " .. view.Countdown
		statusLabel.TextColor3 = C.Accent
	elseif view.IsLeader then
		statusLabel.Text = view.Count < view.Capacity and "READY WHEN YOU ARE" or "CREW COMPLETE  ·  READY"
		statusLabel.TextColor3 = C.Text
	else
		statusLabel.Text = "WAITING FOR EXPEDITION LEADER"
		statusLabel.TextColor3 = C.TextMuted
	end
	startButton.Visible = view.IsLeader and not departing
	if startButton.Visible then
		leaveButton.Size = UDim2.new(0, 98, 0, Theme.ButtonHeight)
		leaveButton.Position = UDim2.new(1, -116, 1, -60)
		leaveButton.Text = "LEAVE"
	else
		leaveButton.Size = UDim2.new(1, -36, 0, Theme.ButtonHeight)
		leaveButton.Position = UDim2.new(0, 18, 1, -60)
		leaveButton.Text = "LEAVE EXPEDITION"
	end

	if departing then
		if not countdownPanel.Visible or countdownPanel.GroupTransparency > 0.5 then
			UIKit.show(countdownPanel)
		end
		if lastCountdown ~= view.Countdown then
			lastCountdown = view.Countdown
			countdownNumber.Text = tostring(view.Countdown)
			countdownNumber.TextTransparency = 0.8
			countdownNumber.TextSize = 58
			UIKit.tween(countdownNumber, 0.35, { TextTransparency = 0, TextSize = 50 })
		end
	elseif countdownPanel.Visible then
		lastCountdown = nil
		UIKit.hide(countdownPanel)
	end
end

local function onState(view)
	if view == nil then
		current = nil
		lastCountdown = nil
		if card.Visible then
			UIKit.hide(card)
		end
		if countdownPanel.Visible then
			UIKit.hide(countdownPanel)
		end
		return
	end
	local wasHidden = current == nil
	current = view
	render(view)
	if wasHidden then
		UIKit.show(card)
		controllers.InterfaceController.DismissHint()
	end
end

local function onFeedback(_, kind)
	if kind == "Tick" then
		play("CountdownTick")
	elseif kind == "CountdownStart" then
		play("CountdownTick")
	elseif kind == "Depart" then
		play("Departure")
	end
end

function ExpeditionController.Init(registry)
	controllers = registry
	requestRemote = Remotes.Get("ExpeditionRequest")
	local gui = UIKit.screen("LastTrainExpedition", 20)
	buildCard(gui)
	buildCountdown(gui)
	Remotes.Get("ExpeditionState").OnClientEvent:Connect(onState)
	Remotes.Get("CabinFeedback").OnClientEvent:Connect(onFeedback)
end

return ExpeditionController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">InterfaceController</string><ProtectedString name="Source"><![CDATA[--[[
	InterfaceController — the only permanent UI: two small buttons (MENU,
	SETTINGS) in the top-right corner. Also owns the intro hint and toasts.
	No currencies, no shop, no fake progression.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("UIKit"))
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)

local Theme = UIKit.Theme
local C = Theme.Colors

local InterfaceController = {}

local controllers
local gui
local menuPanel, settingsPanel, backdrop
local returnButton
local hint
local hintDismissed = false
local hintsEnabled = true
local toast, toastText
local toastToken = 0
local aboard = false

local function play(key)
	if controllers.SoundController then
		controllers.SoundController.Play(key)
	end
end

local function closePanels()
	for _, p in ipairs({ menuPanel, settingsPanel }) do
		if p.Visible then
			UIKit.hide(p)
		end
	end
	backdrop.Visible = false
end

local function openPanel(panel)
	local wasOpen = panel.Visible and panel.GroupTransparency < 0.5
	closePanels()
	if not wasOpen then
		backdrop.Visible = true
		UIKit.show(panel)
	end
end

local function modal(name, title, height)
	local p = UIKit.panel({
		Name = name,
		Parent = gui,
		Size = UDim2.new(0, 360, 0, height),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Corner = 10,
	})
	p.ZIndex = 5
	UIKit.label({ Parent = p, Text = title, Font = Theme.Fonts.Label, TextSize = 14, Color = C.Accent, Position = UDim2.new(0, 22, 0, 18), Size = UDim2.new(1, -44, 0, 18) })
	UIKit.create("Frame", { Parent = p, BackgroundColor3 = C.Stroke, BackgroundTransparency = 0.6, BorderSizePixel = 0, Position = UDim2.new(0, 22, 0, 44), Size = UDim2.new(1, -44, 0, 1) })
	return p
end

-- Segmented control: options = { {label, value}, ... }
local function segmented(parent, y, labelText, options, current, onChange)
	UIKit.label({ Parent = parent, Text = labelText, TextSize = 15, Color = C.Text, Position = UDim2.new(0, 22, 0, y), Size = UDim2.new(0.45, -22, 0, 40) })
	local row = UIKit.create("Frame", { Parent = parent, BackgroundColor3 = C.Background, BackgroundTransparency = 0.2, BorderSizePixel = 0, Position = UDim2.new(1, -22, 0, y), AnchorPoint = Vector2.new(1, 0), Size = UDim2.new(0.55, -22, 0, 40) })
	UIKit.corner(row, 6)
	UIKit.stroke(row, C.StrokeSoft, 1, 0.3)
	local buttons = {}
	local function refresh(value)
		for _, entry in ipairs(buttons) do
			local on = entry.value == value
			entry.button.BackgroundTransparency = on and 0 or 1
			entry.button.TextColor3 = on and C.AccentText or C.TextMuted
		end
	end
	for i, opt in ipairs(options) do
		local b = UIKit.create("TextButton", {
			Parent = row,
			AutoButtonColor = false,
			Text = opt[1],
			Font = Theme.Fonts.Label,
			TextSize = 14,
			BackgroundColor3 = C.Accent,
			BorderSizePixel = 0,
			Size = UDim2.new(1 / #options, -4, 1, -6),
			Position = UDim2.new((i - 1) / #options, 2, 0, 3),
		})
		UIKit.corner(b, 5)
		table.insert(buttons, { button = b, value = opt[2] })
		b.Activated:Connect(function()
			play("UIClick")
			refresh(opt[2])
			onChange(opt[2])
		end)
	end
	refresh(current)
end

local function buildTopBar()
	local bar = UIKit.create("Frame", {
		Name = "TopBar",
		Parent = gui,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.new(0, 220, 0, 42),
	})
	UIKit.scaled(bar)
	local function pill(text, x, onClick)
		local b = UIKit.button({ Parent = bar, Text = text, TextSize = 14, Size = UDim2.new(0, 104, 0, 42), Position = UDim2.new(0, x, 0, 0), OnClick = onClick })
		b.BackgroundTransparency = 0.15
		return b
	end
	pill("MENU", 0, function()
		play("UIClick")
		openPanel(menuPanel)
	end)
	pill("SETTINGS", 116, function()
		play("UIClick")
		openPanel(settingsPanel)
	end)
end

local function buildMenu()
	menuPanel = modal("MenuPanel", "THE LAST TRAIN", 286)
	UIKit.label({
		Parent = menuPanel,
		Text = "Expeditions depart from the lower platform. Step into a cabin to form a crew. The first explorer aboard leads and decides when to depart.",
		TextSize = 15,
		Color = C.TextMuted,
		Wrapped = true,
		YAlign = Enum.TextYAlignment.Top,
		Position = UDim2.new(0, 22, 0, 58),
		Size = UDim2.new(1, -44, 0, 96),
	})
	returnButton = UIKit.button({
		Parent = menuPanel,
		Text = "RETURN TO TERMINAL",
		Style = "Secondary",
		Size = UDim2.new(1, -44, 0, Theme.ButtonHeight),
		Position = UDim2.new(0, 22, 1, -118),
		OnClick = function()
			play("UIConfirm")
			closePanels()
			Remotes.Get("TrainRequest"):FireServer("ReturnToTerminal")
		end,
	})
	returnButton.Visible = false
	UIKit.button({
		Parent = menuPanel,
		Text = "CLOSE",
		Style = "Secondary",
		Size = UDim2.new(1, -44, 0, Theme.ButtonHeight),
		Position = UDim2.new(0, 22, 1, -64),
		OnClick = function()
			play("UICancel")
			closePanels()
		end,
	})
end

local function buildSettings()
	settingsPanel = modal("SettingsPanel", "SETTINGS", 330)
	local sc = controllers.SoundController
	segmented(settingsPanel, 60, "Ambience", { { "OFF", 0 }, { "LOW", 0.45 }, { "FULL", 1 } }, 1, function(v)
		sc.SetLevel("Ambience", v)
	end)
	segmented(settingsPanel, 108, "Effects", { { "OFF", 0 }, { "LOW", 0.45 }, { "FULL", 1 } }, 1, function(v)
		sc.SetLevel("Effects", v)
	end)
	segmented(settingsPanel, 156, "Interface sounds", { { "OFF", 0 }, { "ON", 1 } }, 1, function(v)
		sc.SetLevel("Interface", v)
	end)
	segmented(settingsPanel, 204, "Hints", { { "OFF", false }, { "ON", true } }, true, function(v)
		hintsEnabled = v
		if not v and hint.Visible then
			UIKit.hide(hint)
		end
	end)
	UIKit.button({
		Parent = settingsPanel,
		Text = "CLOSE",
		Size = UDim2.new(1, -44, 0, Theme.ButtonHeight),
		Position = UDim2.new(0, 22, 1, -64),
		OnClick = function()
			play("UICancel")
			closePanels()
		end,
	})
end

local function buildHintAndToast()
	hint = UIKit.panel({
		Name = "IntroHint",
		Parent = gui,
		Size = UDim2.new(0, 340, 0, 40),
		Position = UDim2.new(0.5, 0, 0, 62),
		AnchorPoint = Vector2.new(0.5, 0),
		Corner = 20,
		Transparency = 0.2,
	})
	UIKit.label({ Parent = hint, Text = GameConfig.Hints.IntroHintText, TextSize = 15, Color = C.Text, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 1, 0) })

	toast = UIKit.panel({
		Name = "Toast",
		Parent = gui,
		Size = UDim2.new(0, 320, 0, 38),
		Position = UDim2.new(0.5, 0, 0, 112),
		AnchorPoint = Vector2.new(0.5, 0),
		Corner = 19,
		Color = C.PanelRaised,
	})
	toastText = UIKit.label({ Parent = toast, TextSize = 14, Color = C.Text, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(1, -24, 1, 0), Position = UDim2.new(0, 12, 0, 0) })
end

function InterfaceController.DismissHint()
	hintDismissed = true
	if hint and hint.Visible then
		UIKit.hide(hint, 0.4)
	end
end

function InterfaceController.Toast(text)
	toastToken = toastToken + 1
	local token = toastToken
	toastText.Text = text
	UIKit.show(toast, 0.22)
	task.delay(2.6, function()
		if token == toastToken then
			UIKit.hide(toast, 0.3)
		end
	end)
end

function InterfaceController.SetAboard(isAboard)
	aboard = isAboard
	if returnButton then
		returnButton.Visible = isAboard
	end
	if isAboard then
		InterfaceController.DismissHint()
	end
end

function InterfaceController.Init(registry)
	controllers = registry
	gui = UIKit.screen("LastTrainInterface", 10)
	backdrop = UIKit.create("TextButton", {
		Name = "Backdrop",
		Parent = gui,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55,
		Size = UDim2.new(1, 0, 1, 200),
		Position = UDim2.new(0, 0, 0, -100),
		Visible = false,
		ZIndex = 4,
	})
	backdrop.Activated:Connect(closePanels)
	buildTopBar()
	buildMenu()
	buildSettings()
	buildHintAndToast()
	Remotes.Get("Notice").OnClientEvent:Connect(function(text)
		if type(text) == "string" then
			InterfaceController.Toast(text)
		end
	end)
end

function InterfaceController.Start()
	task.wait(GameConfig.Hints.IntroHintDelay)
	if hintsEnabled and not hintDismissed and not aboard then
		UIKit.show(hint, 0.5)
	end
end

return InterfaceController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">SoundController</string><ProtectedString name="Source"><![CDATA[--[[
	SoundController — every sound on the client goes through here.

	* Three SoundGroups (Ambience / Effects / Interface) whose volumes the
	  Settings panel controls.
	* Zone beds (Loop2D) cross-fade when the player moves between the
	  Terminal and the Train; nothing ever stacks or duplicates.
	* Positional emitters are created once per tagged Attachment.
	* Random one-shots share a single 1 Hz scheduler.
	* Any sound whose Id is "" in AudioConfig is skipped silently.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local AudioConfig = require(ReplicatedStorage.Shared.Config.AudioConfig)

local SoundController = {}

local groups = {}
local levels = { Ambience = 1, Effects = 1, Interface = 1 }
local oneShots = {} -- key -> Sound (2D)
local zoneBeds = {} -- zone -> { Sound }
local randoms = {} -- { key, def, sound, nextAt, zone }
local currentZone = nil

local function hasId(def)
	return def and type(def.Id) == "string" and def.Id ~= ""
end

local function makeSound(key, def, parent)
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = def.Id
	s.Volume = def.Volume or 0.5
	s.Looped = def.Looped == true or def.Kind == "Loop2D"
	s.SoundGroup = groups[def.Group or "Effects"]
	if def.MaxDistance then
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = 6
		s.RollOffMaxDistance = def.MaxDistance
	end
	s.Parent = parent
	return s
end

local function attachEmitter(attachment)
	if not attachment:IsA("Attachment") or attachment:FindFirstChildOfClass("Sound") then
		return
	end
	local key = attachment:GetAttribute("SoundKey")
	local def = AudioConfig.Sounds[key]
	if not hasId(def) then
		return
	end
	local s = makeSound(key, def, attachment)
	if s.Looped then
		s:Play()
	elseif def.Interval then
		table.insert(randoms, { def = def, sound = s, nextAt = os.clock() + math.random(def.Interval[1], def.Interval[2]) })
	end
end

function SoundController.Init()
	for name, volume in pairs(AudioConfig.Groups) do
		local g = SoundService:FindFirstChild("LT_" .. name) or Instance.new("SoundGroup")
		g.Name = "LT_" .. name
		g.Volume = volume
		g.Parent = SoundService
		groups[name] = g
	end
	local folder = Instance.new("Folder")
	folder.Name = "LastTrainSounds"
	folder.Parent = SoundService
	for key, def in pairs(AudioConfig.Sounds) do
		if hasId(def) then
			if def.Kind == "Loop2D" then
				local s = makeSound(key, def, folder)
				s:SetAttribute("TargetVolume", s.Volume)
				s.Volume = 0
				zoneBeds[def.Zone] = zoneBeds[def.Zone] or {}
				table.insert(zoneBeds[def.Zone], s)
			elseif def.Kind == "Random2D" then
				local s = makeSound(key, def, folder)
				table.insert(randoms, { def = def, sound = s, zone = def.Zone, nextAt = os.clock() + math.random(def.Interval[1], def.Interval[2]) })
			elseif def.Kind == "OneShot" then
				oneShots[key] = makeSound(key, def, folder)
			end
		end
	end
	for _, a in ipairs(CollectionService:GetTagged("SoundEmitter")) do
		attachEmitter(a)
	end
	CollectionService:GetInstanceAddedSignal("SoundEmitter"):Connect(attachEmitter)
end

function SoundController.Start()
	while true do
		task.wait(1)
		local now = os.clock()
		for _, r in ipairs(randoms) do
			if now >= r.nextAt then
				r.nextAt = now + math.random(r.def.Interval[1], r.def.Interval[2])
				if r.zone == nil or r.zone == currentZone then
					r.sound:Play()
				end
			end
		end
	end
end

-- 2D one-shot (UI, countdown, departure).
function SoundController.Play(key)
	local s = oneShots[key]
	if s then
		s.TimePosition = 0
		s:Play()
	end
end

-- Positional one-shot at a world position (cabin joins, doors, locked door).
function SoundController.PlayAt(key, position)
	local def = AudioConfig.Sounds[key]
	if not hasId(def) then
		return
	end
	local a = Instance.new("Attachment")
	a.WorldPosition = position
	a.Parent = workspace.Terrain
	local s = makeSound(key, def, a)
	s.RollOffMode = Enum.RollOffMode.InverseTapered
	s.RollOffMinDistance = 8
	s.RollOffMaxDistance = def.MaxDistance or 60
	s:Play()
	Debris:AddItem(a, 8)
end

function SoundController.SetZone(zone)
	if zone == currentZone then
		return
	end
	currentZone = zone
	local info = TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	for bedZone, list in pairs(zoneBeds) do
		for _, s in ipairs(list) do
			if bedZone == zone then
				if not s.IsPlaying then
					s:Play()
				end
				TweenService:Create(s, info, { Volume = s:GetAttribute("TargetVolume") }):Play()
			else
				TweenService:Create(s, info, { Volume = 0 }):Play()
			end
		end
	end
	SoundService.AmbientReverb = zone == "Train" and Enum.ReverbType.LivingRoom or Enum.ReverbType.StoneRoom
end

-- level: 0..1 multiplier set from the Settings panel.
function SoundController.SetLevel(groupName, level)
	levels[groupName] = level
	local g = groups[groupName]
	if g then
		g.Volume = (AudioConfig.Groups[groupName] or 1) * level
	end
end

function SoundController.GetLevel(groupName)
	return levels[groupName] or 1
end

return SoundController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">TrainHUDController</string><ProtectedString name="Source"><![CDATA[--[[
	TrainHUDController — a small, quiet status plate while aboard:
	  THE LAST TRAIN / EXPEDITION CREW n / max / • PREPARING ROUTE
	No currency, no levels, nothing unfinished pretending to work.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("UIKit"))
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local Emblem = require(ReplicatedStorage.Shared.Modules.Emblem)

local Theme = UIKit.Theme
local C = Theme.Colors

local TrainHUDController = {}

local controllers
local hud, crewLabel, statusLabel

function TrainHUDController.Init(registry)
	controllers = registry
	local gui = UIKit.screen("LastTrainHUD", 5)
	hud = UIKit.panel({
		Name = "TrainHUD",
		Parent = gui,
		Size = UDim2.new(0, 236, 0, 76),
		Position = UDim2.new(0, 12, 0, 10),
		AnchorPoint = Vector2.new(0, 0),
		Corner = 8,
		Transparency = 0.15,
	})
	local icon = UIKit.create("Frame", { Parent = hud, BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.new(0, 40, 0, 40) })
	Emblem.Create(icon, { Color = C.Brass, Thickness = 1.5 })
	UIKit.label({ Parent = hud, Text = "THE LAST TRAIN", Font = Theme.Fonts.Label, TextSize = 13, Color = C.Accent, Position = UDim2.new(0, 64, 0, 10), Size = UDim2.new(1, -74, 0, 16) })
	crewLabel = UIKit.label({ Parent = hud, Text = "", Font = Theme.Fonts.Body, TextSize = 15, Color = C.Text, Position = UDim2.new(0, 64, 0, 29), Size = UDim2.new(1, -74, 0, 18), RichText = true })
	statusLabel = UIKit.label({ Parent = hud, Text = "", Font = Theme.Fonts.Label, TextSize = 11, Color = C.TextFaint, Position = UDim2.new(0, 64, 0, 50), Size = UDim2.new(1, -74, 0, 14) })

	Remotes.Get("TrainState").OnClientEvent:Connect(function(view)
		if view == nil then
			if hud.Visible then
				UIKit.hide(hud)
			end
			controllers.InterfaceController.SetAboard(false)
			return
		end
		crewLabel.Text = 'EXPEDITION CREW  <font color="#E2A860">' .. view.CrewCount .. " / " .. view.CrewMax .. "</font>"
		statusLabel.Text = "•  " .. (view.Status or "")
		if not hud.Visible or hud.GroupTransparency > 0.5 then
			UIKit.show(hud, 0.5)
		end
		controllers.InterfaceController.SetAboard(true)
	end)
end

return TrainHUDController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">TransitionController</string><ProtectedString name="Source"><![CDATA[--[[
	TransitionController — the short fade between the terminal and the train.
	"Out": fade to black, show title/subtitle and the emblem.
	"In":  swap the caption, hold a moment, fade back in.
	No long cutscene: the whole sequence is about three seconds.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UIKit = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("UIKit"))
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local Remotes = require(ReplicatedStorage.Shared.Modules.Remotes)
local Emblem = require(ReplicatedStorage.Shared.Modules.Emblem)

local Theme = UIKit.Theme
local C = Theme.Colors
local T = GameConfig.Transition

local TransitionController = {}

local cover, title, subtitle, emblemHolder
local token = 0

local function setText(t, s)
	title.Text = t or ""
	subtitle.Text = s or ""
end

local function textAlpha(alpha, duration)
	UIKit.tween(title, duration, { TextTransparency = alpha })
	UIKit.tween(subtitle, duration, { TextTransparency = alpha })
	UIKit.tween(emblemHolder, duration, { GroupTransparency = alpha })
end

local function out(t, s)
	token = token + 1
	setText(t, s)
	cover.Visible = true
	UIKit.tween(cover, T.FadeOutTime, { BackgroundTransparency = 0 }, Enum.EasingStyle.Sine)
	task.delay(T.FadeOutTime * 0.5, function()
		textAlpha(0, 0.5)
	end)
end

local function fadeIn(t, s)
	token = token + 1
	local my = token
	if t then
		setText(t, s)
	end
	task.delay(0.5, function()
		if my ~= token then
			return
		end
		textAlpha(1, T.FadeInTime * 0.6)
		local tween = UIKit.tween(cover, T.FadeInTime, { BackgroundTransparency = 1 }, Enum.EasingStyle.Sine)
		tween.Completed:Connect(function()
			if my == token then
				cover.Visible = false
			end
		end)
	end)
end

function TransitionController.Init()
	local gui = UIKit.screen("LastTrainTransition", 100, true)
	cover = UIKit.create("Frame", {
		Name = "Cover",
		Parent = gui,
		BackgroundColor3 = Color3.fromRGB(8, 8, 9),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
	})
	local center = UIKit.create("Frame", { Parent = cover, BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 420, 0, 190) })
	UIKit.scaled(center)
	emblemHolder = UIKit.create("CanvasGroup", { Parent = center, BackgroundTransparency = 1, GroupTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0, 64, 0, 64) })
	Emblem.Create(emblemHolder, { Color = C.Brass, Thickness = 2 })
	title = UIKit.label({ Parent = center, Font = Theme.Fonts.Title, TextSize = 30, Color = C.Text, XAlign = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 0, 84), Size = UDim2.new(1, 0, 0, 40), TextTransparency = 1 })
	subtitle = UIKit.label({ Parent = center, Font = Theme.Fonts.Label, TextSize = 15, Color = C.Accent, XAlign = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 0, 130), Size = UDim2.new(1, 0, 0, 22), TextTransparency = 1 })

	Remotes.Get("Transition").OnClientEvent:Connect(function(phase, t, s)
		if phase == "Out" then
			out(t, s)
		elseif phase == "In" then
			fadeIn(t, s)
		end
	end)
end

return TransitionController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">ZoneController</string><ProtectedString name="Source"><![CDATA[--[[
	ZoneController — knows whether the local player is in the Terminal or on
	the Train (checked twice a second against parts tagged "ZoneBounds"), and
	switches what depends on it:
	  * lighting preset (smooth blend, client-only)
	  * ambience bed + reverb (SoundController)
	  * camera max zoom (tighter inside carriages to avoid wall clipping)
	  * scenery scrolling past the train windows (only while aboard)
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)
local LightingPresets = require(ReplicatedStorage.Shared.Config.LightingPresets)

local player = Players.LocalPlayer

local ZoneController = {}

local controllers
local currentZone = nil
local scrollConnection = nil
local layers = nil

local function insideBox(part, position)
	local rel = part.CFrame:PointToObjectSpace(position)
	local half = part.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

local function blendLighting(presetName)
	local preset = LightingPresets[presetName]
	if not preset then
		return
	end
	local info = TweenInfo.new(2.0, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	TweenService:Create(Lighting, info, preset.Lighting):Play()
	local atmosphere = Lighting:FindFirstChild("LastTrainAtmosphere")
	if atmosphere then
		TweenService:Create(atmosphere, info, preset.Atmosphere):Play()
	end
	local bloom = Lighting:FindFirstChild("LastTrainBloom")
	if bloom then
		TweenService:Create(bloom, info, preset.Bloom):Play()
	end
	local cc = Lighting:FindFirstChild("LastTrainColor")
	if cc then
		TweenService:Create(cc, info, preset.ColorCorrection):Play()
	end
end

-- Scenery scrolling -------------------------------------------------------------------
local function collectLayers()
	local zone = workspace:FindFirstChild("ExpeditionTrain")
	local scenery = zone and zone:FindFirstChild("Scenery")
	if not scenery then
		return nil
	end
	local result = {}
	local speeds = { Near = GameConfig.Train.ScenerySpeedNear, Mid = GameConfig.Train.ScenerySpeedMid }
	for _, folder in ipairs(scenery:GetChildren()) do
		local layerName = folder:GetAttribute("Layer")
		local speed = layerName and speeds[layerName]
		if speed then
			local z0 = folder:GetAttribute("WrapZ0")
			local length = folder:GetAttribute("WrapLength") or GameConfig.Train.SceneryWrapLength
			local parts, cframes = {}, {}
			for _, d in ipairs(folder:GetDescendants()) do
				if d:IsA("BasePart") then
					table.insert(parts, d)
					table.insert(cframes, d.CFrame)
				end
			end
			if z0 == nil then
				z0 = math.huge
				for _, cf in ipairs(cframes) do
					z0 = math.min(z0, cf.Position.Z)
				end
				z0 = z0 - 10
			end
			table.insert(result, { parts = parts, cframes = cframes, speed = speed, z0 = z0, length = length })
		end
	end
	return result
end

local function startScenery()
	if scrollConnection then
		return
	end
	layers = layers or collectLayers()
	if not layers then
		return
	end
	scrollConnection = RunService.Heartbeat:Connect(function(dt)
		for _, layer in ipairs(layers) do
			local dz = layer.speed * dt
			local limit = layer.z0 + layer.length
			local cframes = layer.cframes
			for i = 1, #cframes do
				local cf = cframes[i] + Vector3.new(0, 0, dz)
				if cf.Position.Z > limit then
					cf = cf - Vector3.new(0, 0, layer.length)
				end
				cframes[i] = cf
			end
			workspace:BulkMoveTo(layer.parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end)
end

local function stopScenery()
	if scrollConnection then
		scrollConnection:Disconnect()
		scrollConnection = nil
	end
end

-- Zone switching ------------------------------------------------------------------------
local function setZone(zone)
	if zone == currentZone then
		return
	end
	currentZone = zone
	blendLighting(zone)
	controllers.SoundController.SetZone(zone)
	player.CameraMaxZoomDistance = zone == "Train" and GameConfig.Camera.TrainMaxZoom or GameConfig.Camera.TerminalMaxZoom
	if zone == "Train" then
		startScenery()
	else
		stopScenery()
	end
end

function ZoneController.GetZone()
	return currentZone
end

function ZoneController.Init(registry)
	controllers = registry
end

function ZoneController.Start()
	setZone("Terminal")
	while true do
		task.wait(0.5)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			local zone = "Terminal"
			for _, bounds in ipairs(CollectionService:GetTagged("ZoneBounds")) do
				if bounds:GetAttribute("Zone") == "Train" and insideBox(bounds, root.Position) then
					zone = "Train"
					break
				end
			end
			setZone(zone)
		end
	end
end

return ZoneController
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000030"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[--[[
	UIKit — small helpers so every screen element shares one visual language.

	Responsive scaling: every panel gets its own UIScale registered here. One
	listener on the camera's ViewportSize rescales them all (0.8x on small
	phones up to 1.1x on large screens). Panels are anchored to the edge they
	sit against, so scaling never pushes them off-screen.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Theme = require(ReplicatedStorage.Shared.Modules.UITheme)

local UIKit = {}
UIKit.Theme = Theme

local C = Theme.Colors
local scales = {}
local currentScale = 1

local function computeScale()
	local camera = workspace.CurrentCamera
	if not camera then
		return 1
	end
	local vp = camera.ViewportSize
	local s = math.min(vp.X / 1000, vp.Y / 560)
	return math.clamp(s, 0.8, 1.1)
end

local function applyScales()
	currentScale = computeScale()
	for scale in pairs(scales) do
		if scale.Parent then
			scale.Scale = currentScale
		else
			scales[scale] = nil
		end
	end
end

local cameraConnection = nil
local function watchCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
	end
	local camera = workspace.CurrentCamera
	if camera then
		cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScales)
	end
	applyScales()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

function UIKit.GetScale()
	return currentScale
end

function UIKit.create(className, props)
	local inst = Instance.new(className)
	local parent = nil
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UIKit.corner(inst, px)
	return UIKit.create("UICorner", { CornerRadius = UDim.new(0, px or Theme.CornerRadius), Parent = inst })
end

function UIKit.stroke(inst, color, thickness, transparency)
	return UIKit.create("UIStroke", {
		Color = color or C.Stroke,
		Thickness = thickness or 1,
		Transparency = transparency or Theme.StrokeTransparency,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = inst,
	})
end

function UIKit.padding(inst, x, y)
	return UIKit.create("UIPadding", {
		PaddingLeft = UDim.new(0, x),
		PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, y or x),
		PaddingBottom = UDim.new(0, y or x),
		Parent = inst,
	})
end

function UIKit.screen(name, displayOrder, fullScreen)
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = displayOrder or 0
	gui.IgnoreGuiInset = fullScreen == true
	if not fullScreen then
		gui.ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets
	end
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

-- Registers a responsive UIScale on a panel.
function UIKit.scaled(inst)
	local s = Instance.new("UIScale")
	s.Scale = currentScale
	s.Parent = inst
	scales[s] = true
	return s
end

-- Dark panel that can fade as a whole (CanvasGroup).
function UIKit.panel(props)
	local p = UIKit.create("CanvasGroup", {
		Name = props.Name or "Panel",
		Size = props.Size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		BackgroundColor3 = props.Color or C.Panel,
		BackgroundTransparency = props.Transparency or Theme.PanelTransparency,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Visible = false,
		Parent = props.Parent,
	})
	UIKit.corner(p, props.Corner)
	UIKit.stroke(p, props.StrokeColor or C.Stroke, 1, props.StrokeTransparency or Theme.StrokeTransparency)
	UIKit.scaled(p)
	p:SetAttribute("BasePosition", props.Position)
	return p
end

function UIKit.label(props)
	local l = UIKit.create("TextLabel", {
		Name = props.Name or "Label",
		BackgroundTransparency = 1,
		Text = props.Text or "",
		Font = props.Font or Theme.Fonts.Body,
		TextSize = props.TextSize or 16,
		TextColor3 = props.Color or C.Text,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Left,
		TextYAlignment = props.YAlign or Enum.TextYAlignment.Center,
		TextWrapped = props.Wrapped == true,
		TextTransparency = props.TextTransparency or 0,
		Size = props.Size or UDim2.new(1, 0, 0, 20),
		Position = props.Position or UDim2.new(0, 0, 0, 0),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		RichText = props.RichText == true,
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	})
	return l
end

local BUTTON_STYLES = {
	Primary = { Bg = C.Accent, BgHover = Color3.fromRGB(240, 186, 116), Text = C.AccentText, Stroke = C.AccentDeep, StrokeT = 0.2 },
	Secondary = { Bg = C.PanelRaised, BgHover = Color3.fromRGB(48, 44, 39), Text = C.Text, Stroke = C.Stroke, StrokeT = 0.45 },
	Danger = { Bg = C.PanelRaised, BgHover = Color3.fromRGB(56, 38, 34), Text = Color3.fromRGB(232, 186, 172), Stroke = C.Danger, StrokeT = 0.4 },
}

-- props: Text, Style, Size, Position, AnchorPoint, Parent, OnClick
function UIKit.button(props)
	local style = BUTTON_STYLES[props.Style or "Secondary"]
	local b = UIKit.create("TextButton", {
		Name = props.Name or "Button",
		AutoButtonColor = false,
		Text = props.Text or "",
		Font = Theme.Fonts.Label,
		TextSize = props.TextSize or 16,
		TextColor3 = style.Text,
		BackgroundColor3 = style.Bg,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.new(0, 160, 0, Theme.ButtonHeight),
		Position = props.Position or UDim2.new(0, 0, 0, 0),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		Parent = props.Parent,
	})
	UIKit.corner(b, 6)
	UIKit.stroke(b, style.Stroke, 1, style.StrokeT)
	local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	b.MouseEnter:Connect(function()
		TweenService:Create(b, info, { BackgroundColor3 = style.BgHover }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, info, { BackgroundColor3 = style.Bg }):Play()
	end)
	if props.OnClick then
		local busy = false
		b.Activated:Connect(function()
			if busy then
				return
			end
			busy = true
			props.OnClick()
			task.delay(0.35, function()
				busy = false
			end)
		end)
	end
	return b
end

-- Fade + slight rise + gentle scale. Never bouncy.
function UIKit.show(panel, duration)
	duration = duration or 0.28
	local base = panel:GetAttribute("BasePosition") or panel.Position
	panel.Visible = true
	panel.Position = base + UDim2.new(0, 0, 0, 10)
	panel.GroupTransparency = 1
	local scale = panel:FindFirstChildOfClass("UIScale")
	if scale then
		scale.Scale = currentScale * 0.97
		TweenService:Create(scale, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = currentScale }):Play()
	end
	TweenService:Create(panel, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = base, GroupTransparency = 0 }):Play()
end

function UIKit.hide(panel, duration)
	duration = duration or 0.2
	local base = panel:GetAttribute("BasePosition") or panel.Position
	local tween = TweenService:Create(panel, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = base + UDim2.new(0, 0, 0, 8), GroupTransparency = 1 })
	tween.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed and panel.GroupTransparency >= 0.99 then
			panel.Visible = false
		end
	end)
	tween:Play()
end

function UIKit.tween(inst, duration, goal, style)
	local t = TweenService:Create(inst, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

return UIKit
]]></ProtectedString></Properties></Item></Item></Item></Item></roblox>
